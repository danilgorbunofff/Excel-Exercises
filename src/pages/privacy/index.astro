---
// Why this exists: what the site does with data, stated from what the code
// does. The owner's host choice fills in the one part the code cannot know.
import { siteConfig } from "../../../site.config.ts";
import Base from "../../layouts/Base.astro";
import { DAILY_KEY } from "../../scripts/daily-store.ts";
import { STORAGE_KEY } from "../../scripts/progress.ts";

const host = siteConfig.host;
---

<Base
  title="Privacy"
  description="What this site stores and sends: progress in your browser, an optional account, payments through Stripe, and no analytics or tracking."
>
  <h1>Privacy</h1>
  <p>Last updated 13 November 2026.</p>

  <h2>What stays in your browser</h2>
  <p>
    Your progress is saved in your browser's local storage, under the name <code>{STORAGE_KEY}</code>.
    It holds which exercises you solved or opened the answer to, and on which days. Without an
    account it is never sent to the site.
  </p>
  <p>
    The days you solved the <a href="/daily/">daily exercise</a> are saved the same way, under the
    name <code>{DAILY_KEY}</code>, to count your streak.
  </p>
  <p>
    To remove it, use <a href="/progress/">Clear my progress</a> on the progress page, or clear this
    site's data in your browser settings.
  </p>

  <h2>If you make an account</h2>
  <p>An account is optional. Every free exercise works without one. With an account the site keeps:</p>
  <ul>
    <li>your email address, and your password in a form that cannot be read back;</li>
    <li>if you sign in with Google, the email address, name and picture Google shares with the site;</li>
    <li>a copy of your progress, so it follows you to other devices;</li>
    <li>the days you solved the daily exercise, for your streak;</li>
    <li>your mock assessment results, with the formula you typed for each task, so the server can mark them;</li>
    <li>
      your certificates (the <code>certificates</code> table): the name you typed for it, the
      assessment, your score, the date, and whether you revoked it;
    </li>
    <li>whether you want an email when new exercises arrive;</li>
    <li>whether you have PRO, and until when.</li>
  </ul>
  <p>
    Accounts are stored by <a href="https://supabase.com/privacy">Supabase</a>. You can change your
    email and password, or delete the account and everything in it, on the
    <a href="/account/">account page</a>. You can also download everything it keeps there, as one
    JSON file.
  </p>
  <p>
    A certificate has its own page, at an address made of a long random number. Anyone with that
    link sees the name you typed, the assessment, your score, the date and whether it is valid or
    revoked. It never shows your email or anything else from your account, and it asks search
    engines not to list it.
  </p>
  <p>
    You can revoke a certificate on the account page. Deleting your account removes your
    certificates, and their links then say no certificate has that number.
  </p>

  <h2>If you buy PRO</h2>
  <p>
    Payments are taken by <a href="https://stripe.com/privacy">Stripe</a>. Your card details go to
    Stripe and never reach this site. The site keeps your Stripe customer number and the state of
    your subscription.
  </p>

  <h2>Cookies</h2>
  <p>
    Signed in, the site sets cookies that keep you signed in, and one that tells pages you are
    signed in. They are needed for the account to work. There are no cookies for analytics or
    advertising, and none at all if you do not sign in.
  </p>

  <h2>What the site does not do</h2>
  <ul>
    <li>No analytics, advertising or tracking of any kind.</li>
    <li>
      Pages make no requests to other websites. Fonts and scripts come from this site, and a test
      checks every page for requests elsewhere. Google sign-in and Stripe Checkout are pages on
      Google's and Stripe's own sites, which you go to when you choose them.
    </li>
    <li>The formulas you type are checked in your browser and are not sent anywhere.</li>
  </ul>

  <h2>What any web server receives</h2>
  <p>
    Every web server receives some details when your browser asks for a page. These are your IP
    address, the address of the page and your browser's name.
  </p>
  {
    host ? (
      <p>
        This site is hosted by {host.name}. How long it keeps that information is set out in its
        <a href={host.privacyUrl}>privacy notice</a>.
      </p>
    ) : (
      <p>The host for this site is not chosen yet. This page will name it when it is.</p>
    )
  }

  <h2>Questions</h2>
  <p>Use the <a href="/contact/">contact page</a>.</p>
</Base>

<style>
  h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--size-xl);
  }
  li {
    padding-block: var(--space-1);
  }
</style>
