---
// Why this exists: hints on request, in order. Step 1 nudges, step 2 states the
// rule and compares the formula's ranges with the answer's, step 3 shows the
// answer and marks the exercise as solved with help.
import type { Screen } from "../content/schema.ts";
import Icon from "./Icon.astro";
import RichText from "./RichText.astro";

interface Props {
  screen: Screen;
  index: number;
  /** A PRO exercise: the answer is filled in once the visitor has PRO. */
  locked?: boolean;
}
const { screen, index, locked = false } = Astro.props;
---

<div class="hints" data-hints={index}>
  <details data-hint="1">
    <summary><Icon name="hint" size={18} />Hint 1<Icon name="chevron-down" size={18} class="chev" /></summary>
    <p><RichText text={screen.hints.nudge} /></p>
  </details>
  <details data-hint="2">
    <summary><Icon name="hint" size={18} />Hint 2<Icon name="chevron-down" size={18} class="chev" /></summary>
    <p><RichText text={screen.hints.rule} /></p>
    <p data-compare hidden></p>
  </details>
  <details data-hint="3">
    <summary><Icon name="eye" size={18} />Show the answer<Icon name="chevron-down" size={18} class="chev" /></summary>
    <p>The answer is <code data-answer={index}>{locked ? "" : screen.answer}</code>.</p>
  </details>
</div>

<style>
  .hints {
    display: grid;
    gap: var(--space-2);
  }
  details {
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-radius: inherit;
    font-weight: 600;
    color: var(--heading);
    cursor: pointer;
    list-style: none;
  }
  summary :global(.icon) {
    flex: none;
    color: var(--muted);
  }
  summary :global(.chev) {
    margin-left: auto;
  }
  summary:hover {
    background: var(--bg);
  }
  details[open] > summary :global(.icon:first-child) {
    color: var(--read);
  }
  details[open] > summary :global(.chev) {
    rotate: 180deg;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  p {
    margin: 0;
    padding: 0 var(--space-3) var(--space-3) calc(var(--space-3) + 18px + var(--space-2));
  }
  p + p {
    padding-top: 0;
  }
  /* A long answer formula wraps inside the card on a phone. */
  p code {
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: no-preference) {
    summary :global(.chev) {
      transition: rotate 200ms var(--ease);
    }
  }
</style>
