---
// Why this exists: each PRO function drill built as a bare workbench, without
// its answer. drills.ts fetches the next one in a session and puts it in the
// drills page; locked-exercise.ts then asks /api/exercises/ for the answer.
// These pages are not linked and stay out of the sitemap.
import { siteConfig } from "../../../../../site.config.ts";
import LiveExercise from "../../../../components/LiveExercise.astro";
import { type Drill, drillTasks } from "../../../../lib/exercises.ts";

export async function getStaticPaths() {
  return (await drillTasks()).map((d) => ({
    params: { slug: d.exercise.slug },
    props: { drill: d },
  }));
}

interface Props {
  drill: Drill;
}
const { drill } = Astro.props;
---

<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{drill.exercise.title}</title>
  </head>
  <body>
    <LiveExercise placed={drill} heading={drill.exercise.title} defer drill={drill.fn} />
  </body>
</html>
