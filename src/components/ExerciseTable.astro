---
// Why this exists: the one way exercises are listed, as a table in track
// order: Status, Title and Difficulty, as on Spreadsheet Center. The
// catalogue and the progress page use it. Each row carries what the
// catalogue script needs to filter and sort.
import { isLocked } from "../lib/access.ts";
import { exercisePath, functionsOf, LEVELS, type Placed } from "../lib/exercises.ts";
import LevelBars from "./LevelBars.astro";

interface Props {
  rows: readonly Placed[];
  /** The id of the heading that names the table. */
  labelledby: string;
  /** Show the position in the track as the first column. */
  numbered?: boolean;
  /** Column headers become sort buttons. */
  sortable?: boolean;
  /** Show which track each exercise belongs to. */
  showTrack?: boolean;
}
const { rows, labelledby, numbered = false, sortable = false, showTrack = true } = Astro.props;
const columns = [
  ...(numbered ? [{ key: "order", label: "No." }] : []),
  { key: "state", label: "Status" },
  { key: "title", label: "Title" },
  { key: "level", label: "Difficulty" },
];
---

<div class="table-wrap">
  <table aria-labelledby={labelledby} data-exercise-table>
    <thead>
      <tr>
        {
          columns.map((c) => (
            <th scope="col" class={`col-${c.key}`} data-sort-key={sortable ? c.key : undefined}>
              {sortable ? (
                <button type="button" class="sort" data-sort={c.key}>
                  {c.label}
                  <span class="sort-mark" aria-hidden="true" />
                </button>
              ) : (
                c.label
              )}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((p) => {
          const fns = functionsOf(p.exercise);
          return (
            <tr
              data-row
              data-order={p.number}
              data-level={p.exercise.level}
              data-track={p.topic.slug}
              data-title={p.exercise.title}
              data-search={[p.exercise.title, ...fns].join(" ").toLowerCase()}
              data-functions={fns.join(" ")}
            >
              {numbered && <td class="num">{p.topicNumber}</td>}
              <td class="state">
                <span class="state-tag" data-status-for={p.exercise.id}>
                  <span data-status-label>Not started</span>
                </span>
              </td>
              <th scope="row">
                <span class="title-line">
                  <a href={exercisePath(p.exercise.slug)}>{p.exercise.title}</a>
                  {isLocked(p) && <span class="badge badge-pro">PRO</span>}
                </span>
                <span class="meta">
                  {isLocked(p) && <span class="badge badge-pro pro-meta">PRO</span>}
                  {fns.length > 0 ? fns.join(", ") : "Cell references"}
                  {showTrack && <span class="track"> · {p.topic.title}</span>}
                </span>
              </th>
              <td>
                {/* A second way in for the pointer only: the pill sits above the row's link. */}
                <a
                  class={`badge badge-${p.exercise.level} level-pill`}
                  href={exercisePath(p.exercise.slug)}
                  tabindex="-1"
                  aria-hidden="true"
                  data-tip={LEVELS[p.exercise.level as 1 | 2 | 3]}
                >
                  <LevelBars level={p.exercise.level} />
                </a>
                <span class="visually-hidden">{LEVELS[p.exercise.level as 1 | 2 | 3]}</span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-s);
  }
  th,
  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: middle;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    background: var(--bg);
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .col-order {
    width: 6.5rem;
  }
  /* Room for the longest state, so the column holds still when states are painted. */
  .col-state {
    width: 11rem;
  }
  .col-level {
    width: 8rem;
  }
  .sort {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .sort:hover {
    color: var(--text);
  }
  .sort-mark::after {
    content: "↕";
    opacity: 0.5;
  }
  th[aria-sort="ascending"] .sort-mark::after {
    content: "↑";
    opacity: 1;
  }
  th[aria-sort="descending"] .sort-mark::after {
    content: "↓";
    opacity: 1;
  }
  tbody th {
    font-weight: 400;
  }
  tbody tr:hover {
    background: var(--bg);
  }
  .title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .title-line a {
    font-weight: 600;
    text-decoration: none;
  }
  .title-line a:hover {
    color: var(--correct);
    text-decoration: underline;
  }
  /* The whole row opens the exercise, not only the title text. */
  tbody tr {
    position: relative;
  }
  .title-line a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  tbody tr:hover .title-line a {
    color: var(--correct);
  }
  /* A solved state carries a drawn tick. */
  .state-tag:is([data-state="solved"], [data-state="helped"]) [data-status-label]::before {
    content: "";
    display: inline-block;
    width: 0.3rem;
    height: 0.55rem;
    margin-right: 0.5rem;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    rotate: 45deg;
  }
  .level-pill {
    position: relative;
    z-index: 1;
    justify-content: center;
    width: 3rem;
    height: 1.75rem;
    padding: 0;
  }
  .level-pill::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    translate: -50% 0;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-m);
    background: var(--heading);
    color: var(--surface);
    font-size: var(--size-xs);
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  .level-pill:hover::after {
    opacity: 1;
    visibility: visible;
  }
  /* The state pill turns into the row's action under the pointer: it changes
     width and colour while the words roll. Each state has a set width, because
     a width cannot animate from "auto". The action is the pseudo-element base.css
     otherwise uses to hold the box open. */
  @media (min-width: 48rem) {
    .state .state-tag {
      --w: 5.875rem;
      --to: 5rem;
      justify-items: center;
      width: var(--w);
      overflow: hidden;
    }
    .state .state-tag[data-state="solved"] {
      --w: 5rem;
    }
    .state .state-tag[data-state="helped"] {
      --w: 9rem;
    }
    .state .state-tag[data-state="tried"] {
      --w: 3.75rem;
    }
    .state .state-tag[data-state="revealed"] {
      --w: 6.625rem;
    }
    .state .state-tag:is([data-state="solved"], [data-state="helped"]) {
      --to: 5.75rem;
    }
    .state .state-tag::after {
      content: "Solve →" / "";
      visibility: visible;
      translate: 0 100%;
      opacity: 0;
    }
    .state .state-tag:is([data-state="solved"], [data-state="helped"])::after {
      content: "Review →" / "";
    }
    tbody tr:is(:hover, :focus-within) .state .state-tag {
      width: var(--to);
      background: var(--primary);
      color: var(--on-primary);
    }
    tbody tr:is(:hover, :focus-within) .state .state-tag::after {
      translate: 0 0;
      opacity: 1;
    }
    tbody tr:is(:hover, :focus-within) [data-status-label] {
      translate: 0 -100%;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .level-pill::after {
      transition:
        opacity 120ms,
        visibility 120ms;
    }
    .state .state-tag {
      transition:
        width 320ms cubic-bezier(0.3, 1.3, 0.5, 1),
        background-color 250ms,
        color 250ms;
    }
    .state .state-tag::after,
    [data-status-label] {
      transition:
        translate 320ms cubic-bezier(0.3, 1.1, 0.5, 1),
        opacity 220ms;
    }
  }
  .pro-meta {
    display: none;
  }
  .meta {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--size-xs);
    color: var(--faint);
  }
  .num {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  tr[hidden] {
    display: none;
  }
  @media (max-width: 29.99rem) {
    .track {
      display: none;
    }
  }
  /* Phones: each row is a list item, the title on the left at full width and
     the level over the status on the right. As three columns the title got
     85 px and wrapped to four lines. Sorting stays on wider screens. */
  @media (max-width: 47.99rem) {
    thead {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "num title level" "num title state";
      align-items: center;
      padding: var(--space-3) var(--space-3) var(--space-3) 0;
      border-bottom: 1px solid var(--rule);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody tr > * {
      padding: 0;
      border-bottom: 0;
    }
    tbody tr > th {
      grid-area: title;
      padding: 0 var(--space-3) 0 var(--space-4);
    }
    .num {
      grid-area: num;
      padding-left: var(--space-3);
    }
    td:last-child {
      grid-area: level;
      justify-self: end;
    }
    .state {
      grid-area: state;
      justify-self: end;
      margin-top: var(--space-1);
    }
    /* Not started is the default, so it says nothing on a phone. */
    .state :global(.state-tag:not([data-state])),
    .state :global(.state-tag[data-state=""]) {
      display: none;
    }
    .state :global(.state-tag) {
      max-inline-size: none;
      white-space: nowrap;
    }
    .state :global(.state-tag::after) {
      display: none;
    }
    /* PRO moves to the start of the meta line: by the title it wrapped onto
       a line of its own whenever the title filled the row. */
    .title-line .badge-pro {
      display: none;
    }
    .pro-meta {
      display: inline-flex;
      margin-right: var(--space-2);
    }
  }
</style>
