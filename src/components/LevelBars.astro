---
// Why this exists: a difficulty as three bars, for the exercise table and the
// catalogue's filter. Styled in base.css; the word is the caller's to give.
interface Props {
  level: number;
}
const { level } = Astro.props;
---

<span class={`signal signal-${level}`} aria-hidden="true">
  {[1, 2, 3].map((n) => <i class={n <= level ? "on" : undefined} />)}
</span>
