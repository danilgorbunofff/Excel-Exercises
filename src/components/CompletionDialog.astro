---
// Why this exists: the "Exercise completed" dialog that opens when the last
// step is solved, as on Spreadsheet Center. It says what was practised and
// offers the next exercise. Closing it leaves Next in the status bar. It only
// invites the visitor to sign up once accounts are open.
import { siteConfig } from "../../site.config.ts";
import { ACCOUNT_NAV } from "../lib/nav.ts";
import Icon from "./Icon.astro";

interface Props {
  practised: string;
  next: { href: string; label: string };
}
const { practised, next } = Astro.props;
---

<dialog class="done" aria-labelledby="done-title" closedby="any" data-done-dialog>
  <div class="done-head">
    <h2 id="done-title">
      <Icon name="check" size={20} /> Exercise completed
    </h2>
    <button class="close" type="button" data-done-close>
      <span class="visually-hidden">Close</span>
      <Icon name="close" size={18} />
    </button>
  </div>
  <div class="done-body">
    <p>{practised}</p>
    <a class="button button-primary button-l next" href={next.href} autofocus data-done-next>
      {next.label === "All exercises" ? "Back to all exercises" : `Next recommended exercise: ${next.label.replace(/^Next: /u, "")}`}
      <Icon name="arrow" size={18} />
    </a>
    <p class="save">
      {
        siteConfig.accountsOpen ? (
          <>
            <a href={ACCOUNT_NAV.register.href}>Create an account</a> to keep your progress on every
            device.
          </>
        ) : (
          <>
            Your progress is saved in this browser. <a href="/progress/">See what is next</a>.
          </>
        )
      }
    </p>
  </div>
</dialog>

<style>
  .done {
    width: min(30rem, calc(100vw - 2rem));
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
  }
  .done::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .done-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
    background: var(--primary);
    color: var(--on-primary);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--size-l);
  }
  .close {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 0;
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--on-primary);
    cursor: pointer;
  }
  .close:focus-visible {
    outline-color: var(--on-primary);
  }
  .done-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  .done-body p {
    margin: 0;
  }
  .next {
    white-space: normal;
    text-align: left;
  }
  .save {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .save a {
    color: var(--correct);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: no-preference) {
    .done {
      opacity: 0;
      transform: scale(0.96);
      transition:
        opacity 180ms var(--ease),
        transform 180ms var(--ease),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
    }
    .done[open] {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .done[open] {
        opacity: 0;
        transform: scale(0.96);
      }
    }
    .done::backdrop {
      background-color: transparent;
      transition:
        background-color 180ms var(--ease),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
    }
    .done[open]::backdrop {
      background-color: rgb(0 0 0 / 0.45);
    }
    @starting-style {
      .done[open]::backdrop {
        background-color: transparent;
      }
    }
  }
</style>
