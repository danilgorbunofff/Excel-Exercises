---
// Why this exists: Excel keyboard shortcuts for Windows and Mac in one table
// per group, with a filter.
import { readFileSync } from "node:fs";
import { parse } from "yaml";
import { shortcutsSchema } from "../../content/schema.ts";
import Base from "../../layouts/Base.astro";

const { groups } = shortcutsSchema.parse(parse(readFileSync("content/shortcuts.yaml", "utf8")));
const total = groups.reduce((n, g) => n + g.items.length, 0);
const keys = (combo: string) => combo.split(" + ");
---

<Base
  title="Excel keyboard shortcuts"
  description={`${total} Excel keyboard shortcuts for Windows and Mac, grouped by task, with a filter.`}
  layout="wide"
>
  <header class="page-head">
    <h1>Excel keyboard shortcuts</h1>
    <p class="lead">
      Save time with {total} shortcuts for Excel on Windows and Mac, grouped by what you are doing.
    </p>
    <form class="filter" role="search" data-shortcut-filter>
      <label class="visually-hidden" for="shortcut-q">Filter shortcuts</label>
      <input id="shortcut-q" type="search" placeholder="Filter by action or key" autocomplete="off" />
      <p class="count" role="status" data-shortcut-count></p>
    </form>
  </header>

  <div class="table-wrap">
    <table>
      <caption class="visually-hidden">Excel keyboard shortcuts for Windows and Mac</caption>
      <thead>
        <tr>
          <th scope="col">Action</th>
          <th scope="col">Windows</th>
          <th scope="col">Mac</th>
        </tr>
      </thead>
      {
        groups.map((g) => (
          <tbody data-group>
            <tr class="group">
              <th scope="colgroup" colspan="3">
                {g.title}
              </th>
            </tr>
            {g.items.map((s) => (
              <tr data-shortcut={`${s.action} ${s.win} ${s.mac}`.toLowerCase()}>
                <th scope="row">{s.action}</th>
                <td>
                  {keys(s.win).map((k, i) => (
                    <>
                      {i > 0 && <span class="plus">+</span>}
                      <kbd>{k}</kbd>
                    </>
                  ))}
                </td>
                <td>
                  {keys(s.mac).map((k, i) => (
                    <>
                      {i > 0 && <span class="plus">+</span>}
                      <kbd>{k}</kbd>
                    </>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#shortcut-q");
  const count = document.querySelector<HTMLElement>("[data-shortcut-count]");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-shortcut]")];
  input?.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(/\s+/u).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      row.hidden = !words.every((w) => (row.dataset["shortcut"] ?? "").includes(w));
      if (!row.hidden) shown += 1;
    }
    for (const body of document.querySelectorAll<HTMLElement>("[data-group]")) {
      body.hidden = !body.querySelector("[data-shortcut]:not([hidden])");
    }
    if (count) {
      count.textContent = words.length
        ? shown
          ? `Showing ${shown} of ${rows.length} shortcuts.`
          : "No shortcut matches."
        : "";
    }
  });
</script>

<style>
  .filter {
    max-width: 28rem;
    margin: var(--space-5) auto 0;
  }
  .filter input {
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }
  .count {
    min-height: 1.5em;
    margin: var(--space-2) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .table-wrap {
    overflow-x: auto;
    margin-bottom: var(--space-7);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-s);
  }
  th,
  td {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }
  thead th {
    background: var(--bg);
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
  }
  tbody th {
    font-weight: 400;
  }
  .group th {
    padding-top: var(--space-4);
    background: var(--chip-bg);
    color: var(--chip);
    font-weight: 700;
  }
  tbody[hidden],
  tr[hidden] {
    display: none;
  }
  kbd {
    display: inline-block;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: var(--radius-s);
    background: var(--bg);
    font-size: var(--size-xs);
  }
  .plus {
    margin: 0 0.25rem;
    color: var(--faint);
  }
</style>
