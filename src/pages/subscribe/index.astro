---
// Why this exists: where Stripe Checkout sends the visitor after paying. The
// webhook can land a few seconds after the visitor does, so the page asks
// /api/me a few times before it says PRO is active.
import Base from "../../layouts/Base.astro";
---

<Base title="Subscribe" description="Your PRO subscription." layout="flush">
  <div class="wrap">
    <div class="card panel" aria-live="polite">
      <div data-wait>
        <h1>Thank you</h1>
        <p>We are switching on PRO for your account. This takes a few seconds.</p>
      </div>
      <div data-done hidden>
        <h1>PRO is active</h1>
        <p>Every exercise is now open to you.</p>
      </div>
      <div data-late hidden>
        <h1>Almost there</h1>
        <p>Your payment went through, but PRO is not on your account yet. Reload this page in a minute.</p>
      </div>
      <div class="actions">
        <a class="button button-primary" href="/exercises/">Go to the exercises</a>
        <a class="button button-outline" href="/account/">Account and billing</a>
      </div>
    </div>
  </div>
</Base>

<script>
  import { loadMe } from "../../scripts/session.ts";

  const show = (which: "wait" | "done" | "late") => {
    for (const k of ["wait", "done", "late"]) {
      const el = document.querySelector<HTMLElement>(`[data-${k}]`);
      if (el) el.hidden = k !== which;
    }
  };
  let tries = 0;
  async function check(): Promise<void> {
    const me = tries === 0 ? await loadMe() : await fetch("/api/me/").then((r) => (r.ok ? r.json() : null));
    if (me?.pro) return show("done");
    if (++tries >= 10) return show("late");
    setTimeout(check, 2000);
  }
  void check();
</script>

<style>
  .wrap {
    display: grid;
    place-items: center;
    padding: 6rem var(--space-4);
  }
  .panel {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: 32rem;
    text-align: center;
  }
  h1 {
    margin: 0;
    font-size: var(--size-xl);
    color: var(--heading);
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
