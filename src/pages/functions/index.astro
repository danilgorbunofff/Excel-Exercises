---
// Why this exists: the function index. Every function is on the page, so the
// default view is an A to Z list of names; pointing at one shows what it does,
// how it is written and where to practise it. The same functions can be read
// by job or by Microsoft category. Without script all three lists show.
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import {
  drillsPath,
  drillTasks,
  exercisesForFunction,
  placedExercises,
} from "../../lib/exercises.ts";
import {
  functionPages,
  functionPath,
  functionsPractised,
  loadFunctionIndex,
} from "../../lib/functions.ts";
import { syntaxHtml } from "../../lib/syntax.ts";

const pages = await functionPages();
const withPage = new Map(pages.map((p) => [p.name, functionPath(p.slug)]));
const practised = new Map(functionsPractised(await placedExercises()));
const drilled = new Set((await drillTasks()).map((d) => d.fn));
const index = loadFunctionIndex();
const href = (name: string) => withPage.get(name) ?? exercisesForFunction(name);
const plural = (n: number) => (n === 1 ? "1 exercise" : `${n} exercises`);
const categories = [...new Set(index.functions.map((f) => f.category))].sort();

// A to Z, dealt into four columns of about the same height. A letter stays whole.
const byLetter = new Map<string, typeof index.functions>();
for (const f of [...index.functions].sort((a, b) => a.name.localeCompare(b.name))) {
  const letter = f.name.charAt(0).toUpperCase();
  byLetter.set(letter, [...(byLetter.get(letter) ?? []), f]);
}
const lines = (list: typeof index.functions) => list.length + 2;
const target = [...byLetter.values()].reduce((n, l) => n + lines(l), 0) / 4;
const columns: [string, typeof index.functions][][] = [[], [], [], []];
let at = 0;
let filled = 0;
for (const entry of byLetter) {
  if (filled >= target && at < 3) {
    at += 1;
    filled = 0;
  }
  columns[at]?.push(entry);
  filled += lines(entry[1]);
}
const guide = (name: string) => withPage.has(name);
---

<Base
  title="Functions"
  description="Excel functions explained with their syntax, what they are for and the exercises that practise them. Search by name or browse by job."
  layout="wide"
>
  <header class="head">
    <div>
      <h1>Excel functions</h1>
      <p class="lead">
        {index.functions.length} functions. Point at one to see what it does and how it is written.
      </p>
    </div>
    <form class="fn-search" role="search" action="/search/" method="get" data-fn-search>
      <Icon name="lookup" size={18} />
      <label class="visually-hidden" for="fn-q">Search functions</label>
      <input
        id="fn-q"
        name="q"
        type="search"
        placeholder="Search by name or by what it does"
        autocomplete="off"
        spellcheck="false"
      />
    </form>
  </header>
  <p class="fn-count" role="status" data-fn-count></p>

  <nav class="views" aria-label="Ways to browse the functions">
    <ul>
      <li><a href="#by-job" data-view-link>By job</a></li>
      <li><a href="#by-category" data-view-link>By category</a></li>
      <li><a href="#a-z" data-view-link aria-current="true">A to Z</a></li>
    </ul>
  </nav>

  <section id="by-job" data-view hidden aria-label="Functions by job">
    <ul class="ledger">
      {
        index.groups.map((g) => (
          <li class="job">
            <div>
              <h2>{g.title}</h2>
              <p>{g.summary}</p>
            </div>
            <ul class="names">
              {index.functions
                .filter((f) => f.group === g.slug)
                .map((f) => (
                  <li>
                    <a href={href(f.name)}>{f.name}</a>
                    {guide(f.name) && <span class="gd" role="img" aria-label="Has a full guide" />}
                  </li>
                ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="by-category" data-view hidden aria-label="Functions by Microsoft category">
    <ul class="ledger">
      {
        categories.map((c) => {
          const list = index.functions.filter((f) => f.category === c);
          return (
            <li class="job">
              <div>
                <h2>{c}</h2>
                <p>{list.length} functions</p>
              </div>
              <ul class="names">
                {list.map((f) => (
                  <li>
                    <a href={href(f.name)}>{f.name}</a>
                    {guide(f.name) && <span class="gd" role="img" aria-label="Has a full guide" />}
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section id="a-z" data-view aria-label="Functions A to Z">
    <div class="az">
      {
        columns.map((col) => (
          <div class="az-col">
            {col.map(([letter, list]) => (
              <section class="lt" data-letter>
                <h2>{letter}</h2>
                <ul>
                  {list.map((f) => {
                    const count = practised.get(f.name)?.length ?? 0;
                    return (
                      <li class="fn" data-fn={`${f.name} ${f.summary}`.toLowerCase()}>
                        <a href={href(f.name)}>{f.name}</a>
                        {guide(f.name) && (
                          <span class="gd" role="img" aria-label="Has a full guide" />
                        )}
                        <div class="pop">
                          <p>{f.summary}</p>
                          <code class="fx" set:html={syntaxHtml(f.syntax)} />
                          {(count > 0 || drilled.has(f.name)) && (
                            <p class="pl">
                              {count > 0 && (
                                <a href={exercisesForFunction(f.name)}>{plural(count)}</a>
                              )}
                              {drilled.has(f.name) && (
                                <a href={drillsPath(f.name)}>Practise {f.name} (PRO)</a>
                              )}
                            </p>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
          </div>
        ))
      }
    </div>
    <p class="none" data-fn-none hidden>
      No function matches. Press Enter to search the whole site.
    </p>
    <p class="legend"><span class="gd" aria-hidden="true"></span>Has a full guide with worked examples</p>
  </section>
</Base>

<noscript>
  <style>
    [data-view][hidden] {
      display: block;
    }
  </style>
</noscript>

<script>
  // Switches between the three lists and filters the A to Z list as you type.
  // Without script every list shows and the search box searches the site.
  const views = [...document.querySelectorAll<HTMLElement>("[data-view]")];
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-view-link]")];
  const show = (id: string) => {
    for (const v of views) v.hidden = v.id !== id;
    for (const l of links) {
      if (l.hash === `#${id}`) l.setAttribute("aria-current", "true");
      else l.removeAttribute("aria-current");
    }
  };
  const fromHash = () => {
    const id = location.hash.slice(1);
    show(views.some((v) => v.id === id) ? id : "a-z");
  };
  for (const l of links) {
    l.addEventListener("click", (e) => {
      e.preventDefault();
      history.replaceState(null, "", l.hash);
      show(l.hash.slice(1));
    });
  }
  window.addEventListener("hashchange", fromHash);
  fromHash();

  const form = document.querySelector<HTMLFormElement>("[data-fn-search]");
  const input = form?.querySelector("input");
  const count = document.querySelector<HTMLElement>("[data-fn-count]");
  const none = document.querySelector<HTMLElement>("[data-fn-none]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-fn]")];
  const letters = [...document.querySelectorAll<HTMLElement>("[data-letter]")];
  if (form && input && count && none) {
    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/u).filter(Boolean);
      let shown = 0;
      for (const item of items) {
        item.hidden = !words.every((w) => (item.dataset["fn"] ?? "").includes(w));
        if (!item.hidden) shown += 1;
      }
      for (const l of letters) l.hidden = !l.querySelector("[data-fn]:not([hidden])");
      if (words.length) show("a-z");
      none.hidden = !(words.length && !shown);
      count.textContent = words.length
        ? shown
          ? `Showing ${shown} of ${items.length} functions.`
          : ""
        : "";
    };
    input.addEventListener("input", apply);
    form.addEventListener("submit", (e) => {
      if (items.some((i) => !i.hidden) && input.value) e.preventDefault();
    });
  }
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-7) 0 var(--space-4);
  }
  h1 {
    margin: 0;
    font-size: var(--size-page);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--heading);
  }
  .lead {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }
  .fn-search {
    position: relative;
    width: min(100%, 27.5rem);
  }
  .fn-search :global(.icon) {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    translate: 0 -50%;
    color: var(--faint);
    pointer-events: none;
  }
  .fn-search input {
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-3) 0 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    font-size: var(--size-base);
  }
  .fn-count {
    min-height: 1.5em;
    margin: 0 0 var(--space-2);
    font-size: var(--size-s);
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .views {
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--rule);
  }
  .views ul {
    display: flex;
    gap: var(--space-6);
  }
  .views a {
    display: block;
    margin-bottom: -1px;
    padding: var(--space-3) 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }
  .views a[aria-current="true"] {
    border-bottom-color: var(--primary);
    color: var(--heading);
  }
  @media (hover: hover) {
    .views a:hover {
      color: var(--heading);
    }
  }
  [data-view][hidden] {
    display: none;
  }
  .gd {
    display: inline-block;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    margin-inline-start: var(--space-2);
    border-radius: 50%;
    background: var(--primary);
    vertical-align: middle;
  }
  .legend {
    display: flex;
    align-items: center;
    margin: var(--space-5) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .legend .gd {
    margin: 0 var(--space-2) 0 0;
  }
  .none {
    margin: 0;
    color: var(--muted);
  }

  /* A to Z */
  .az {
    display: grid;
    gap: 0 var(--space-7);
  }
  .lt {
    margin-bottom: var(--space-5);
  }
  .lt[hidden] {
    display: none;
  }
  .lt h2 {
    margin: 0 0 var(--space-1);
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--size-s);
    font-weight: 700;
    color: var(--faint);
  }
  .fn {
    position: relative;
  }
  .fn[hidden] {
    display: none;
  }
  .fn > a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--size-s);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .fn > a:focus-visible,
  .fn > a:hover {
    color: var(--correct);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pop {
    position: absolute;
    z-index: 5;
    top: 100%;
    left: 0;
    inline-size: min(22rem, calc(100vw - 2rem));
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .fn:focus-within .pop {
    visibility: visible;
    opacity: 1;
  }
  @media (hover: hover) {
    .fn:hover .pop {
      visibility: visible;
      opacity: 1;
    }
  }
  .pop p {
    margin: 0 0 var(--space-2);
    font-size: var(--size-s);
  }
  .pop .pl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
  }
  .pop .pl a {
    font-weight: 600;
    color: var(--correct);
  }
  .fx {
    display: block;
    padding: 0;
    background: none;
    font-size: var(--size-xs);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .fx b {
    color: var(--heading);
  }
  .fx .r {
    color: var(--text);
  }
  .fx .o {
    color: var(--faint);
  }
  @media (pointer: coarse) {
    .fn > a {
      padding: var(--space-3) 0;
    }
  }
  @media (min-width: 40rem) {
    .az {
      grid-template-columns: 1fr 1fr;
    }
    .az-col:nth-child(even) .pop {
      right: 0;
      left: auto;
    }
  }
  @media (min-width: 64rem) {
    .az {
      grid-template-columns: repeat(4, 1fr);
    }
    .az-col:nth-child(even) .pop {
      right: auto;
      left: 0;
    }
    .az-col:nth-child(n + 3) .pop {
      right: 0;
      left: auto;
    }
  }

  /* By job and by category */
  .ledger {
    border-top: 1px solid var(--heading);
  }
  .job {
    display: grid;
    gap: var(--space-3) var(--space-7);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--rule);
  }
  .job h2 {
    margin: 0;
    font-size: var(--size-base);
    font-weight: 700;
    color: var(--heading);
  }
  .job p {
    max-width: 34ch;
    margin: var(--space-1) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .names {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: var(--space-1) var(--space-5);
  }
  .names a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
  }
  .names a:hover {
    color: var(--correct);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 48rem) {
    .job {
      grid-template-columns: 18rem 1fr;
    }
  }
</style>
