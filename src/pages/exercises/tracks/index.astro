---
// Why this exists: every learning track, grouped by where you are: the
// essentials first, then one skill at a time, then interview practice. Each
// card shows its level, size, time and this browser's progress.
import Icon from "../../../components/Icon.astro";
import PracticeTabs from "../../../components/PracticeTabs.astro";
import TrackCard from "../../../components/TrackCard.astro";
import Base from "../../../layouts/Base.astro";
import { formatMinutes, placedExercises, trackSummaries } from "../../../lib/exercises.ts";

const placed = await placedExercises();
const tracks = trackSummaries(placed);
const essentials = tracks.filter((t) => t.topic.group === "essentials");
const groups = [
  {
    id: "skill",
    heading: "Go deeper on one family of functions",
    text: "Counting, logic, lookups, text, dates and more, one track each.",
    tracks: tracks.filter((t) => t.topic.group === "skill"),
  },
  {
    id: "interview",
    heading: "Prepare for a job interview",
    text: "Tasks like the ones office, sales, finance, accounting and analyst tests set, built on everyday work data.",
    tracks: tracks.filter((t) => t.topic.group === "interview"),
  },
];
const essentialMinutes = essentials.reduce((s, t) => s + t.minutes, 0);
const essentialCount = essentials.reduce((s, t) => s + t.exercises.length, 0);
const skillCount = groups[0]?.tracks.length ?? 0;
const how = [
  {
    icon: "route" as const,
    title: "Choose where to start",
    text: "Start with the essentials, go straight to the skill you need for work, or practise for an interview.",
  },
  {
    icon: "grid" as const,
    title: "Solve each exercise",
    text: "Each exercise opens a real sheet. Type the formula and get a verdict straight away.",
  },
  {
    icon: "chart" as const,
    title: "Watch the track fill in",
    text: "Solved exercises are ticked off on every track, so you always see what is left.",
  },
];
---

<Base
  title="Learning tracks"
  description={`${tracks.length} Excel learning tracks, from your first cell reference to lookups, text, dates, capstone tasks and interview practice.`}
  layout="wide"
>
  <PracticeTabs />
  <header class="page-head">
    <h1>Learning tracks</h1>
    <p class="lead">Pick a track for the skill you need.</p>
  </header>

  <section class="group" aria-labelledby="g-essentials">
    <div class="group-head">
      <h2 id="g-essentials">Start here if formulas are new to you</h2>
      <p>These tracks lay the groundwork for everything else: references, arithmetic and totals.</p>
    </div>
    <ol class="path">
      {
        essentials.map((t, i) => (
          <li class="path-step">
            <span class="step-num">Step {i + 1}</span>
            <TrackCard track={t} showLocked />
          </li>
        ))
      }
      <li class="path-step">
        <span class="step-num">Step {essentials.length + 1}</span>
        <div class="card then">
          <strong class="then-num">{skillCount}</strong>
          <h3>more tracks</h3>
          <p>Counting, logic, lookups, text, dates and more, all built on these two.</p>
          <a href="#g-skill">Browse them <Icon name="arrow" size={16} /></a>
        </div>
      </li>
    </ol>
    <p class="path-foot">
      <span><strong>{essentialCount}</strong> exercises with hints</span>
      <span><strong>{formatMinutes(essentialMinutes)}</strong> of practice, roughly</span>
    </p>
  </section>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.id}`}>
        <div class="group-head">
          <h2 id={`g-${g.id}`}>{g.heading}</h2>
          <p>{g.text}</p>
        </div>
        <ul class="cards cards-3">
          {g.tracks.map((t) => (
            <li>
              <TrackCard track={t} showLocked />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="group how" aria-labelledby="g-how">
    <h2 id="g-how">How a track works</h2>
    <ol class="how-list">
      {
        how.map((h) => (
          <li class="card">
            <span class="icon-box">
              <Icon name={h.icon} size={22} />
            </span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="card browse" aria-labelledby="g-browse">
    <h2 id="g-browse">Want the full list instead?</h2>
    <p>Every exercise is also in one table, with filters for function, difficulty, track and progress.</p>
    <a class="button button-outline" href="/exercises/">Open the catalogue</a>
  </section>
</Base>

<script>
  // The catalogue script paints each card: the bar, the status pill and
  // whether its button says Start, Continue or Review.
  import "../../../scripts/catalogue.ts";
</script>

<style>
  /* The title sits where it does on the other practice pages. */
  .group {
    margin-bottom: var(--space-7);
  }
  .group-head h2,
  .how h2 {
    margin: 0 0 var(--space-1);
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .group-head p {
    margin: 0 0 var(--space-5);
    color: var(--muted);
  }
  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .cards li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  /* The path: Step 1 → Step 2 → then any track, joined by arrows. */
  .path {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 64rem) {
    .path {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 14rem;
      gap: var(--space-7);
    }
  }
  .path > li {
    position: relative;
    min-width: 0;
  }
  .path > li:not(:last-child)::after {
    content: "→";
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-6) / -2);
    transform: translate(-50%, 50%) rotate(90deg);
    font-size: var(--size-xl);
    color: var(--line);
  }
  @media (min-width: 64rem) {
    .path > li:not(:last-child)::after {
      top: 50%;
      left: auto;
      right: calc(var(--space-7) / -2);
      bottom: auto;
      transform: translate(50%, -50%);
    }
  }
  /* The step label sits above the same track card the other groups use. */
  .path-step {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-2);
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
  }
  /* Step 3: how many tracks come next, and the way down to them. */
  .then {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    background: var(--primary);
    border-color: var(--primary);
  }
  .then-num {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }
  .then h3 {
    margin: 0;
    font-size: var(--size-l);
    color: #fff;
  }
  .then p {
    margin: 0;
    font-size: var(--size-s);
    color: #fff;
  }
  .then a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-size: var(--size-s);
    font-weight: 700;
    color: #fff;
  }
  .then a :global(svg) {
    transform: rotate(90deg);
  }
  .path-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-5) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .path-foot strong {
    color: var(--heading);
  }
  .how-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .how-list h3 {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--size-base);
    color: var(--heading);
  }
  .how-list p {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .icon-box {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-l);
    background: var(--chip-bg);
    color: var(--chip);
  }
  .browse {
    margin-bottom: var(--space-7);
    text-align: center;
  }
  .browse h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-l);
    color: var(--heading);
  }
  .browse p {
    margin: 0 0 var(--space-4);
    color: var(--muted);
  }
  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards-3,
    .how-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
