---
// Why this exists: the "Exercise solved" dialog that opens when the last
// step is solved, as on Spreadsheet Center. It offers the next exercise.
// Closing it leaves Next in the status bar. It only invites the visitor to
// sign up once accounts are open.
import { siteConfig } from "../../site.config.ts";
import { ACCOUNT_NAV } from "../lib/nav.ts";
import Icon from "./Icon.astro";

interface Props {
  next: { href: string; label: string };
}
const { next } = Astro.props;
const atEnd = next.label === "All exercises";
const nextTitle = next.label.replace(/^Next: /u, "");
---

<dialog class="done" aria-labelledby="done-title" closedby="any" data-done-dialog>
  <button class="close" type="button" data-done-close>
    <span class="visually-hidden">Close</span>
    <Icon name="close" size={18} />
  </button>
  <span class="badge" aria-hidden="true"><Icon name="check" size={30} /></span>
  <h2 id="done-title">Exercise solved</h2>
  <a
    class="button button-primary next"
    href={next.href}
    aria-label={atEnd ? undefined : `Next exercise: ${nextTitle}`}
    autofocus
    data-done-next
  >
    {atEnd ? "Back to all exercises" : "Next exercise"}
    <Icon name="arrow" size={18} />
  </a>
  <p class="save">
    {
      siteConfig.accountsOpen ? (
        <>
          <span data-when="out">
            <a href={ACCOUNT_NAV.register.href}>Create an account</a> to keep your progress on every
            device.
          </span>
          <span data-when="in" hidden>
            Your progress is saved to your account. <a href="/progress/">See what is next</a>.
          </span>
        </>
      ) : (
        <>
          Your progress is saved in this browser. <a href="/progress/">See what is next</a>.
        </>
      )
    }
  </p>
</dialog>

<style>
  .done {
    width: min(24rem, calc(100vw - 2rem));
    padding: var(--space-7) var(--space-5) var(--space-5);
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
    text-align: center;
  }
  .done::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 0;
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .close:hover {
    background: var(--header);
    color: var(--text);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: 0 auto var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--primary);
    color: var(--on-primary);
    box-shadow: 0 0 0 8px var(--correct-tint);
  }
  h2 {
    margin: 0;
    font-size: var(--size-xl);
    line-height: var(--leading-tight);
    color: var(--heading);
  }
  .done p {
    margin: 0;
  }
  .next {
    width: 100%;
    margin-top: var(--space-5);
    justify-content: center;
  }
  .done .save {
    margin-top: var(--space-4);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .save a {
    color: var(--correct);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: no-preference) {
    .done {
      opacity: 0;
      transform: scale(0.96);
      transition:
        opacity 180ms var(--ease),
        transform 180ms var(--ease),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
    }
    .done[open] {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .done[open] {
        opacity: 0;
        transform: scale(0.96);
      }
    }
    .done::backdrop {
      background-color: transparent;
      transition:
        background-color 180ms var(--ease),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
    }
    .done[open]::backdrop {
      background-color: rgb(0 0 0 / 0.45);
    }
    @starting-style {
      .done[open]::backdrop {
        background-color: transparent;
      }
    }
  }
</style>
