---
import { getCollection } from "astro:content";
// Why this exists: the mock assessments as cards you can compare: every set
// with its size, time, level, functions and your best, then your past
// attempts. The sample is free; the other sets are PRO.
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import PracticeTabs from "../../components/PracticeTabs.astro";
import Base from "../../layouts/Base.astro";
import { assessmentPath, coverOf, loadAssessments } from "../../lib/assessments.ts";
import { LEVELS } from "../../lib/exercises.ts";
import { ACCOUNT_NAV } from "../../lib/nav.ts";
import "../../styles/assessments.css";

const SHOWN = 5;
const byId = new Map(
  [...(await getCollection("exercises")), ...(await getCollection("mocks"))].map((e) => [
    e.data.id,
    e.data,
  ]),
);
const levelWord = (l: number) => LEVELS[l as 1 | 2 | 3];
// A set's level is its hardest task's.
const sets = loadAssessments().sets.map((set) => {
  const cover = coverOf(set, byId);
  const level = cover.levels.at(-1) ?? 1;
  return { ...set, functions: cover.functions, level, levelName: levelWord(level) };
});
const titles = Object.fromEntries(sets.map((s) => [s.slug, s.title]));
---

<Base
  title="Mock Excel assessments"
  description="Timed sets of Excel tasks like an employer's test, marked at the end with an explanation for every miss. The sample is free."
  layout="wide"
>
  <PracticeTabs />
  <div class="a-page index">
    <header class="open-head">
      <Breadcrumbs items={[{ label: "Exercises", href: "/exercises/" }]} />
      <h1>Mock assessments</h1>
      <p class="lead">
        Timed sets of tasks like an employer's Excel test. There are no hints while you work, and
        every answer is marked when you finish.
      </p>
      <p class="actions">
        <a class="button button-primary" href={assessmentPath("sample")}>Try the free sample</a>
        <a class="button button-outline" href="/pricing/">See PRO plans</a>
      </p>
    </header>

    <section class="p-section" aria-labelledby="sets-title">
      <div class="p-section-head">
        <div>
          <h2 id="sets-title">Pick an assessment</h2>
        </div>
      </div>
      <ul class="p-cards sets">
        {
          sets.map((set) => (
            <li class="card set-card">
              <div class="set-top">
                <a class="title" id={`set-${set.slug}`} href={assessmentPath(set.slug)}>
                  {set.title}
                </a>
                {set.sample ? <span class="free">Free</span> : <span class="tag">PRO</span>}
              </div>
              <p class="summary">{set.summary}</p>
              <p class="nums">
                <span>
                  <strong>{set.tasks.length}</strong> tasks
                </span>
                <span>
                  <strong>{set.minutes}</strong> min
                </span>
                <span class={`level level-${set.level}`}>{set.levelName}</span>
              </p>
              <p class="chips fn-chips">
                {set.functions.slice(0, SHOWN).map((f) => <span class="chip">{f}</span>)}
                {set.functions.length > SHOWN && (
                  <span class="more">+{set.functions.length - SHOWN} more</span>
                )}
              </p>
              <p class="best" data-when="in" hidden>
                Your best: <strong data-best={set.slug}>Not taken</strong>
              </p>
              {set.sample ? (
                <a class="button button-primary start" href={assessmentPath(set.slug)}>
                  Start the sample
                </a>
              ) : (
                <a
                  class="button button-secondary start"
                  href={assessmentPath(set.slug)}
                  aria-describedby={`set-${set.slug}`}
                >
                  <Icon name="lock" size={16} />
                  Start
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="ruled a-side attempts" aria-labelledby="history-title">
      <div class="list-head">
        <h2 id="history-title">Your attempts</h2>
      </div>
      <p class="a-pad" data-when="out">
        <a href={`${ACCOUNT_NAV.login.href}?next=${encodeURIComponent("/mock-assessments/")}`}>Log in</a> or
        <a href={ACCOUNT_NAV.register.href}>sign up</a> to keep your results here and see your best for each
        assessment.
      </p>
      <div data-when="in" hidden>
        <p class="a-pad" data-history-empty>No attempts yet. Your results appear here when you finish an assessment.</p>
        <ol class="a-list" aria-label="Your latest attempts, newest first" data-history hidden></ol>
      </div>
    </section>
  </div>

  <script type="application/json" data-titles set:html={JSON.stringify(titles).replaceAll("<", "\\u003c")} />
</Base>

<script>
  import { signedIn } from "../../scripts/session.ts";

  interface Row {
    assessment: string;
    finished_at: string;
    started_at: string;
    score: number;
    total: number;
    time_limit_s: number | null;
  }
  const list = document.querySelector<HTMLElement>("[data-history]");
  const empty = document.querySelector<HTMLElement>("[data-history-empty]");
  const titles = JSON.parse(
    document.querySelector("script[data-titles]")?.textContent ?? "{}",
  ) as Record<string, string>;

  /** One attempt: the set, when and how long, and the score as the pill. */
  const item = (r: Row) => {
    const li = document.createElement("li");
    li.className = "a-item no-num";
    const body = document.createElement("div");
    body.className = "body";
    const title = document.createElement("a");
    title.className = "title";
    title.href = `/mock-assessments/${encodeURIComponent(r.assessment)}/`;
    title.textContent = titles[r.assessment] ?? r.assessment;
    const mins = Math.round((Date.parse(r.finished_at) - Date.parse(r.started_at)) / 60000);
    const line = document.createElement("p");
    line.className = "line";
    line.textContent = `${new Date(r.finished_at).toLocaleDateString()}, ${
      r.time_limit_s === null ? `${mins} min, untimed` : `${mins} of ${r.time_limit_s / 60} min`
    }`;
    body.append(title, line);
    const score = document.createElement("span");
    score.className = "mark-tag";
    score.textContent = `${r.score} of ${r.total}`;
    li.append(body, score);
    return li;
  };

  if (signedIn() && list && empty) {
    fetch("/api/assessments/", { credentials: "same-origin" })
      .then((r) => (r.ok ? (r.json() as Promise<Row[]>) : Promise.reject(new Error(String(r.status)))))
      .then((rows) => {
        // Best per set: the highest score, then the most recent.
        const best = new Map<string, Row>();
        for (const r of rows) {
          const b = best.get(r.assessment);
          if (!b || r.score / r.total > b.score / b.total) best.set(r.assessment, r);
        }
        for (const [slug, r] of best) {
          const el = document.querySelector<HTMLElement>(`[data-best="${slug}"]`);
          if (el) el.textContent = `${r.score} of ${r.total}`;
        }
        if (rows.length === 0) return;
        list.replaceChildren(...rows.map(item));
        empty.hidden = true;
        list.hidden = false;
      })
      .catch(() => {
        empty.textContent = "Your attempts could not be loaded. Reload the page to try again.";
      });
  }
</script>

<style>
  .set-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .set-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .set-top .title {
    font-size: var(--size-l);
    font-weight: 700;
    color: var(--heading);
    text-decoration: none;
  }
  .set-top .title:hover {
    text-decoration: underline;
  }
  /* Free is a price, not a level: a plain outline, so it never reads as Beginner green. */
  .free {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--size-xs);
    font-weight: 600;
    white-space: nowrap;
    color: var(--text);
  }
  .set-card p {
    margin: 0;
  }
  .summary {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .nums {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .nums strong {
    font-size: var(--size-xl);
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }
  .fn-chips {
    align-items: center;
  }
  .fn-chips .more {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .best {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .start {
    width: 100%;
    margin-top: auto;
  }
  .attempts {
    max-width: 40rem;
  }
</style>
