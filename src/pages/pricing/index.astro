---
// Why this exists: Free and PRO side by side, the way pricing pages usually
// work: a billing switch, two equal cards that say the same four things, a
// band of what PRO gets you (numbers, an example certificate, the research on
// testing), a comparison table and the usual questions. Every number is read
// from the content, so it stays true as tracks and drills grow. The switch is three radios joined to the PRO form,
// and CSS shows the chosen price, so checkout works without JavaScript. The
// form posts to /api/stripe/checkout/; a signed-out visitor pays as a guest or
// signs in with Google first. Lifetime is a launch offer, shown only while offeredPlans() has it.
// The old 6-month plan is not offered; its members are handled by the webhook.
import { getCollection } from "astro:content";
import { siteConfig } from "../../../site.config.ts";
import Icon, { type IconName } from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import { isLocked } from "../../lib/access.ts";
import { loadAssessments } from "../../lib/assessments.ts";
import { RANDOM_SIZE as FREE_DRILLS } from "../../lib/drills.ts";
import { placedExercises } from "../../lib/exercises.ts";
import { formatAmount, offeredPlans, PLANS, savingPercent } from "../../server/plans.ts";
import { proPrices } from "../../server/prices.ts";

const DEFAULT = "annual";
const placed = await placedExercises();
const locked = placed.filter((p) => isLocked(p)).length;
const free = placed.length - locked;
const perTrack = siteConfig.freePerTrack;
const sets = loadAssessments().sets.filter((s) => !s.sample);
const fullSets = sets.length;
const prices = await proPrices();
const offered = offeredPlans();
const lifetime = offered.some((p) => p.months === null);

// Stripe's amounts when the build has keys, the list prices otherwise.
const amountOf = (p: (typeof PLANS)[number]) => ({
  cents: prices?.[p.key]?.cents ?? p.listCents ?? 0,
  currency: prices?.[p.key]?.currency ?? "usd",
});
const monthlyCents = amountOf(PLANS[0]).cents;
const PER = { 1: "/ month", 3: "/ 3 months", 12: "/ year" } as const;
const SHORT = { quarterly: "3 months" } as const;
const periods = offered.map((p) => {
  const { cents, currency } = amountOf(p);
  const fmt = (c: number) => formatAmount({ currency, unit_amount: Math.round(c) });
  const months = p.months;
  return {
    key: p.key,
    label: SHORT[p.key as keyof typeof SHORT] ?? p.label,
    price: fmt(cents),
    per: months === null ? "once" : PER[months as keyof typeof PER],
    note:
      months === null
        ? "Launch offer: pay once, keep PRO for good. Offered for a limited time."
        : months === 1
          ? "Billed every month"
          : `${fmt(cents / months)} a month, billed ${months === 3 ? "every 3 months" : "once a year"}`,
    saving: months === null || months === 1 ? 0 : savingPercent(cents, months, monthlyCents),
    best: p.key === DEFAULT,
  };
});

const drills = (await getCollection("drills")).map((d) => d.data);
const drillFunctions = new Set(drills.map((d) => d.function)).size;
const interviewSets = new Set(
  placed.filter((p) => p.topic.group === "interview").map((p) => p.topic.slug),
).size;
const testTasks = (await getCollection("mocks")).length;
const minutes = sets.map((s) => s.minutes);
const testTime = `${Math.min(...minutes)} to ${Math.max(...minutes)} minutes each`;
// The example certificate: the longest set, so its numbers are real.
const example = [...sets].sort((a, b) => b.minutes - a.minutes)[0];
const yearly = PLANS.find((p) => p.key === DEFAULT);
const fromPrice = yearly
  ? `from ${formatAmount({ currency: amountOf(yearly).currency, unit_amount: Math.round(amountOf(yearly).cents / 12) })} a month`
  : "";

// The two cards say the same four things, so each line reads across.
const freeHas = [
  `${free} exercises`,
  "A daily exercise",
  "A 10-minute level check",
  `${FREE_DRILLS} function drills a day`,
];
const proHas = [
  `All ${placed.length} exercises`,
  `${fullSets} timed tests like an employer's`,
  "A certificate for each test you pass",
  `${drills.length} function drills, no daily limit`,
];
const tiles: { icon: IconName; value: number; title: string; text: string }[] = [
  {
    icon: "grid",
    value: placed.length,
    title: "Exercises",
    text: `Every track to the end. Free has ${free}.`,
  },
  {
    icon: "clock",
    value: fullSets,
    title: "Timed tests",
    text: `Like an employer's, on ${testTasks} tasks you have not seen.`,
  },
  {
    icon: "bolt",
    value: drills.length,
    title: "Function drills",
    text: `${drillFunctions} functions, 5 drills each, no limit.`,
  },
  {
    icon: "briefcase",
    value: interviewSets,
    title: "Interview sets",
    text: "Finance, FP&A, accounting, operations, admin and sales.",
  },
];

// true / false is a check or a cross; a string is shown as it is, a number large.
type Cell = boolean | string | number;
const compare: { group: string; rows: { name: string; note: string; free: Cell; pro: Cell }[] }[] =
  [
    {
      group: "Practise",
      rows: [
        {
          name: "Exercises",
          note: "Real formulas on a real grid, checked at once",
          free,
          pro: placed.length,
        },
        {
          name: "Capstone tasks",
          note: "Small working sheets, several steps each",
          free: `First ${perTrack}`,
          pro: "All",
        },
        {
          name: "Function drills",
          note: `One function at a time, ${drillFunctions} functions`,
          free: `${FREE_DRILLS} a day`,
          pro: drills.length,
        },
        { name: "Daily exercise", note: "Easy on Monday, hard on Sunday", free: true, pro: true },
        {
          name: "Hints, answers and instant checks",
          note: "See which cells your formula read",
          free: true,
          pro: true,
        },
      ],
    },
    {
      group: "Get test-ready",
      rows: [
        { name: "Level check", note: "10 minutes, scored by skill", free: true, pro: true },
        { name: "Timed tests like an employer's", note: testTime, free: false, pro: fullSets },
        {
          name: "Unseen test tasks",
          note: "Tasks that are not in the practice tracks",
          free: false,
          pro: testTasks,
        },
        {
          name: "Interview sets",
          note: "Finance, FP&A, accounting, operations, admin, sales",
          free: `First ${perTrack} of each`,
          pro: interviewSets,
        },
        {
          name: "Results by skill",
          note: "Your weakest functions first, with practice links",
          free: "Level check",
          pro: "Every test",
        },
      ],
    },
    {
      group: "Show it",
      rows: [
        {
          name: "Certificates",
          note: "One for each test you pass, with a link anyone can check",
          free: false,
          pro: true,
        },
      ],
    },
    {
      group: "Keep going",
      rows: [
        {
          name: "Review list",
          note: "Misses and solves that are due again",
          free: true,
          pro: true,
        },
        { name: "Progress on every device", note: "Saved to your account", free: true, pro: true },
        {
          name: "Daily exercise by email",
          note: "Opt in, stop in one click",
          free: true,
          pro: true,
        },
        {
          name: "Function guides, articles and shortcuts",
          note: "Nothing locked",
          free: true,
          pro: true,
        },
      ],
    },
  ];

const faq = [
  {
    q: "Which plan should I pick?",
    a: `Start with Free: the first ${perTrack} exercises of every track are yours for good. Take PRO for the rest of each track, the interview sets and the timed mock assessments. Yearly costs the least per month.`,
  },
  {
    q: "Can I cancel?",
    a: `Yes, at any time from your account. The plan stops renewing, and PRO stays until the end of the period you paid for.${lifetime ? " Lifetime is one payment, so there is nothing to cancel." : ""}`,
  },
  ...(lifetime
    ? [
        {
          q: "What is the lifetime plan?",
          a: "A launch offer: one payment, and PRO stays on your account for good. It is on sale for a limited time and can be withdrawn without notice; if you buy it, it stays yours.",
        },
      ]
    : []),
  {
    q: "What happens when PRO ends?",
    a: "The PRO exercises and full mock assessments lock again. Your progress and past results stay in your account.",
  },
  {
    q: "Which exercises are free?",
    a: `The first ${perTrack} exercises of every learning track, with their hints and answers, and the daily exercise, which climbs from easy on Monday to hard on Sunday.`,
  },
  {
    q: "How do I pay?",
    a: "On Stripe Checkout, which shows the price again before you pay. You can enter a promo code there.",
  },
];
---

<Base
  title="Pricing"
  description={`${free} Excel exercises are free. PRO adds ${locked} more, timed mock assessments and certificates.`}
  layout="wide"
>
  <header class="page-head">
    <h1>Walk into your Excel test ready</h1>
    <p class="lead">
      Start free. Go PRO for every exercise, timed tests like an employer's and a certificate you can show.
    </p>
  </header>

  <p class="flash" role="status" data-flash hidden></p>

  <div class="pricing">
    <fieldset class="switch">
      <legend class="visually-hidden">Billing period</legend>
      <span class="thumb" aria-hidden="true"></span>
      {
        periods.map((p) => (
          <label>
            <input
              type="radio"
              name="plan"
              value={p.key}
              form="pro-checkout"
              checked={p.key === DEFAULT}
              data-period={p.key}
            />
            <span>{p.label}</span>
            {p.saving > 0 && <span class="off">−{p.saving}%</span>}
          </label>
        ))
      }
    </fieldset>

    <div class="cards">
      <section class="card-plan" aria-labelledby="free-title">
        <h2 id="free-title">Free</h2>
        <p class="tagline">See how it works.</p>
        <div>
          <p class="price"><strong>$0</strong><span>forever</span></p>
          <p class="price-note">No card needed</p>
        </div>
        <ul class="list divide">
          {
            freeHas.map((f) => (
              <li>
                <Icon name="check" size={18} class="yes" />
                {f}
              </li>
            ))
          }
        </ul>
        <div class="card-foot">
          <a class="button button-outline" href="/register/" data-when="out">Start free</a>
          <a class="button button-outline" href="/exercises/" data-when="in" hidden>Go to the exercises</a>
        </div>
      </section>

      <section class="card-plan pro" aria-labelledby="pro-title">
        <p class="band">Recommended</p>
        <h2 id="pro-title">PRO</h2>
        <p class="tagline">Everything to get test-ready.</p>
        {
          periods.map((p) => (
            <div class="period" data-shows={p.key}>
              <p class="price">
                <strong>{p.price}</strong>
                <span>{p.per}</span>
                {p.best && <span class="best">Best value</span>}
              </p>
              <p class="price-note">{p.note}</p>
            </div>
          ))
        }
        <ul class="list divide">
          {
            proHas.map((f) => (
              <li>
                <Icon name="check" size={18} class="yes" />
                {f}
              </li>
            ))
          }
        </ul>
        <form id="pro-checkout" class="card-foot" method="post" action="/api/stripe/checkout/">
          <button class="button button-primary" type="submit">Get PRO</button>
          <button class="button button-secondary" type="submit" name="via" value="google" data-when="out">
            Continue with Google
          </button>
        </form>
      </section>
    </div>

    <ul class="trust">
      <li><Icon name="check" size={16} /> Cancel anytime</li>
      <li><Icon name="user" size={16} /> No account needed to buy</li>
      <li><Icon name="lock" size={16} /> Secure checkout by Stripe</li>
      <li><Icon name="bolt" size={16} /> Promo codes accepted</li>
    </ul>
  </div>

  <section class="gets" aria-labelledby="gets-title">
    <h2 id="gets-title" class="section-title">What you get with PRO</h2>
    <p class="section-lead">Built for one job: passing an employer's Excel test.</p>
    <ul class="tiles">
      {
        tiles.map((t) => (
          <li class="tile">
            <span class="tile-icon"><Icon name={t.icon} size={20} /></span>
            <p class="tile-value">{t.value}</p>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="proof">
      {
        example && (
          <figure class="cert">
            <p class="cert-kicker">Certificate · Example</p>
            <p class="cert-title">{example.title} Excel test</p>
            <p class="cert-sub">Passed under time, on tasks not seen before</p>
            <dl class="cert-facts">
              <div><dt>tasks</dt><dd>{example.tasks.length}</dd></div>
              <div><dt>minutes</dt><dd>{example.minutes}</dd></div>
              <div><dt>check</dt><dd>Public link</dd></div>
            </dl>
            <figcaption class="cert-note">Each certificate has its own page an employer can open to check it.</figcaption>
          </figure>
        )
      }
      <figure class="study">
        <p class="study-title">Why timed tests work</p>
        <figcaption>Testing yourself beats re-reading. How much people remembered a week later:</figcaption>
        <dl class="bars">
          <div>
            <dt>Practised with tests</dt>
            <dd>61%</dd>
            <span class="bar" aria-hidden="true"><span class="fill fill-test"></span></span>
          </div>
          <div>
            <dt>Only re-read</dt>
            <dd>40%</dd>
            <span class="bar" aria-hidden="true"><span class="fill fill-reread"></span></span>
          </div>
        </dl>
        <p class="source">
          Roediger and Karpicke,{" "}
          <a href="https://source.washu.edu/2006/04/repeated-testing-better-than-repeated-studying/" rel="noopener">Psychological Science, 2006</a>
        </p>
        <button class="button button-primary" type="submit" form="pro-checkout">Get PRO</button>
      </figure>
    </div>
  </section>

  <section class="compare" aria-labelledby="compare-title">
    <h2 id="compare-title" class="section-title">Free shows you how. PRO gets you ready.</h2>
    <p class="section-lead">
      The same grid and the same instant checks. PRO opens the rest of every track, the timed tests and the certificates.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col">
              <span class="plan-name">Free</span>
              <span class="plan-price">$0</span>
            </th>
            <th scope="col" class="pro-col">
              <span class="plan-name">PRO</span>
              <span class="plan-price">{fromPrice}</span>
            </th>
          </tr>
        </thead>
        {
          compare.map((g) => (
            <tbody>
              <tr class="group">
                <th scope="colgroup" colspan="2">
                  {g.group}
                </th>
                <td class="pro-col" />
              </tr>
              {g.rows.map((r) => (
                <tr>
                  <th scope="row">
                    <span class="feat">{r.name}</span>
                    <span class="feat-note">{r.note}</span>
                  </th>
                  {[r.free, r.pro].map((c, i) => (
                    <td class:list={{ "pro-col": i === 1 }}>
                      {typeof c === "number" ? (
                        <span class="num">{c}</span>
                      ) : typeof c === "string" ? (
                        c
                      ) : c ? (
                        <>
                          <Icon name="check" size={18} class="yes" />
                          <span class="visually-hidden">Included</span>
                        </>
                      ) : (
                        <>
                          <Icon name="close" size={18} class="no" />
                          <span class="visually-hidden">Not included</span>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))
        }
        <tfoot>
          <tr>
            <td></td>
            <td>
              <a class="button button-outline" href="/register/" data-when="out">Start free</a>
              <a class="button button-outline" href="/exercises/" data-when="in" hidden>Exercises</a>
            </td>
            <td class="pro-col">
              <button class="button button-primary" type="submit" form="pro-checkout">Get PRO</button>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="section-title">Questions</h2>
    {
      faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>
</Base>

<script>
  import "../../scripts/flash.ts";

  // Slide the highlight under the chosen period.
  const sw = document.querySelector<HTMLElement>(".switch");
  const thumb = sw?.querySelector<HTMLElement>(".thumb");
  const place = () => {
    const on = sw?.querySelector<HTMLElement>("label:has(input:checked)");
    if (!sw || !thumb || !on) return;
    thumb.style.width = `${on.offsetWidth}px`;
    thumb.style.height = `${on.offsetHeight}px`;
    thumb.style.transform = `translate(${on.offsetLeft}px, ${on.offsetTop}px)`;
    // Add after the first paint so the pill does not slide in from the left on load.
    requestAnimationFrame(() => sw.classList.add("ready"));
  };
  place();
  sw?.addEventListener("change", place);
  addEventListener("resize", place);
  document.fonts?.ready.then(place);
</script>

<style>
  .pricing {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* Billing switch: a segmented control made of radios. */
  .switch {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto var(--space-6);
    padding: var(--space-1);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .switch label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--size-s);
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .switch label:has(input:checked) {
    color: #fff;
  }
  /* Without script the chosen label carries the fill itself. */
  .switch:not(.ready) label:has(input:checked) {
    background: var(--primary);
  }
  .switch label {
    z-index: 1;
  }
  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: var(--radius-pill);
    background: var(--primary);
    pointer-events: none;
  }
  .switch {
    position: relative;
  }
  .switch label:has(input:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .off {
    padding: 0 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--correct-tint);
    color: var(--correct);
    font-size: var(--size-xs);
    font-weight: 700;
  }
  .switch label:has(input:checked) .off {
    background: rgb(0 0 0 / 0.25);
    color: #fff;
  }

  /* Show only the price for the chosen period. */
  .period {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .thumb {
      transition:
        transform 300ms var(--ease),
        width 300ms var(--ease);
    }
    .switch:not(.ready) .thumb {
      transition: none;
    }
    .switch label {
      transition: color 300ms var(--ease);
    }
    .period {
      animation: price-in 320ms var(--ease) both;
    }
  }
  @keyframes price-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  .pricing:has([data-period="monthly"]:checked) [data-shows="monthly"],
  .pricing:has([data-period="quarterly"]:checked) [data-shows="quarterly"],
  .pricing:has([data-period="annual"]:checked) [data-shows="annual"],
  .pricing:has([data-period="lifetime"]:checked) [data-shows="lifetime"] {
    display: block;
  }
  .best {
    align-self: center;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--correct-tint);
    color: var(--correct);
    font-size: var(--size-xs);
    font-weight: 700;
  }

  .cards {
    display: grid;
    gap: var(--space-5);
  }
  .card-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: calc(var(--space-6) + 1.75rem) var(--space-6) var(--space-6);
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  /* The ribbon room lines the two cards up side by side; stacked, Free needs none. */
  @media (max-width: 47.99rem) {
    .card-plan:not(.pro) {
      padding-top: var(--space-6);
    }
  }
  .pro {
    order: -1;
    border: 2px solid var(--primary);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }
  .band {
    position: absolute;
    inset: 0 0 auto;
    margin: 0;
    padding: 0.3rem 0;
    background: var(--primary);
    color: #fff;
    font-size: var(--size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }
  .card-plan h2 {
    margin: 0;
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .tagline {
    margin: calc(-1 * var(--space-2)) 0 0;
    color: var(--muted);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }
  .price strong {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .price span {
    color: var(--muted);
  }
  .price-note {
    min-height: 1.5em;
    margin: var(--space-1) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  /* The buttons sit at the bottom, so both cards line up whatever is above. */
  .card-foot {
    display: grid;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
  }
  .card-foot .button {
    width: 100%;
  }
  .list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .list :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
  }
  /* The line between the price block and what the plan gives. */
  .divide {
    margin-top: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }
  :global(.yes) {
    color: var(--correct);
  }
  :global(.no) {
    color: var(--muted);
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .trust li {
    display: inline-flex;
