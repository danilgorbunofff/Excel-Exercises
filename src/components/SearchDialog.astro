---
// Why this exists: the large search window, opened from the button beside the
// header search or with Ctrl K. It has room for filters and for results
// grouped by kind. Without script the form still posts to the search page.
import Icon from "./Icon.astro";

const scopes = [
  ["", "All"],
  ["Exercise", "Exercises"],
  ["Function", "Functions"],
  ["Track", "Tracks"],
  ["Article", "Articles"],
] as const;
---
<dialog id="search-dialog" class="search-dialog" aria-label="Search" closedby="any" data-search-dialog>
  <form role="search" action="/search/" method="get">
    <div class="q">
      <Icon name="lookup" size={20} />
      <input
        name="q"
        type="text"
        inputmode="search"
        enterkeyhint="search"
        placeholder="Search exercises and functions"
        aria-label="Search exercises, functions and articles"
        autocomplete="off"
        spellcheck="false"
        autofocus
        role="combobox"
        aria-expanded="true"
        aria-controls="search-dialog-results"
        aria-autocomplete="list"
        data-dialog-input
      />
      <button class="close" type="button" commandfor="search-dialog" command="close">
        <Icon name="close" size={20} />
        <span class="visually-hidden">Close search</span>
      </button>
    </div>
    <div class="scope" role="group" aria-label="Show only">
      {
        scopes.map(([kind, label]) => (
          <button type="button" data-scope={kind} aria-pressed={kind === "" ? "true" : "false"}>
            {label}
          </button>
        ))
      }
    </div>
    <div class="results" id="search-dialog-results" role="listbox" aria-label="Results" data-dialog-results>
      <p class="blank">Type a function, a task or an exercise.</p>
    </div>
    <p class="hint">
      <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
      <span><kbd>Enter</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
      <a href="/search/" data-dialog-all hidden>See all results</a>
    </p>
  </form>
</dialog>
<script>
  import "../scripts/search-dialog.ts";
</script>
<style>
  .search-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 6rem));
    margin: 4.5rem auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }
  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] {
      animation: rise 150ms var(--ease);
    }
    @keyframes rise {
      from {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }
  form {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .q {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--rule);
    color: var(--faint);
  }
  .q:focus-within {
    box-shadow: inset 0 -2px 0 var(--primary);
  }
  .q input {
    flex: 1;
    min-width: 0;
    min-height: 3.5rem;
    border: 0;
    outline: none;
    background: none;
    color: var(--text);
    font-size: var(--size-base);
  }
  .close {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .close:hover {
    background: var(--header);
  }
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-1);
  }
  .scope button {
    min-height: 2rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--size-s);
    cursor: pointer;
  }
  .scope button:hover {
    background: var(--header);
  }
  .scope button[aria-pressed="true"] {
    border-color: var(--primary);
    background: var(--correct-tint);
    color: var(--correct);
    font-weight: 600;
  }
  .results {
    flex: 1;
    min-height: 8rem;
    padding: var(--space-2) var(--space-2) var(--space-3);
    overflow-y: auto;
  }
  .results :global(.blank) {
    margin: 0;
    padding: var(--space-4);
    color: var(--muted);
    font-size: var(--size-s);
  }
  .results :global(.grp) {
    margin: var(--space-3) 0 var(--space-1);
    padding: 0 var(--space-3);
    color: var(--muted);
    font-size: var(--size-xs);
    font-weight: 600;
  }
  .results :global(a) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m);
    font-size: var(--size-s);
    text-decoration: none;
  }
  .results :global(a:hover),
  .results :global(a[aria-selected="true"]) {
    background: var(--header);
  }
  .results :global(a[aria-selected="true"])::after {
    content: "Open";
    color: var(--muted);
    font-size: var(--size-xs);
  }
  .hint {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--rule);
    background: var(--header);
    color: var(--muted);
    font-size: var(--size-xs);
  }
  .hint a {
    margin-left: auto;
    color: var(--text);
    font-weight: 600;
  }
  .hint a[hidden] {
    display: none;
  }
  /* Phones use the Menu dialog, which has its own search box. */
  @media (max-width: 63.99rem) {
    .search-dialog {
      display: none;
    }
  }
</style>
