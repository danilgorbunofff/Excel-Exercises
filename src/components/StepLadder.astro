---
// Why this exists: every track exercise is one step of a five-step ladder on
// the same theme, easiest to hardest. This row links all five, marks the one
// open, and ticks those solved in this browser. Solving any one of them counts
// as solving the exercise, so the row is a choice, not a list to finish.
import type { Rung } from "../lib/steps.ts";

interface Props {
  ladder: readonly Rung[];
  /** The id of the task on this page. */
  current: string;
}
const { ladder, current } = Astro.props;
---

<nav class="ladder" aria-label="Same task, easier to harder" data-ladder>
  <div class="ends" aria-hidden="true">
    <span>Easier</span>
    <span>Harder</span>
  </div>
  <ol>
    {
      ladder.map((r) => (
        <li>
          <a
            href={r.href}
            aria-current={r.id === current ? "step" : undefined}
            data-rung={r.id}
          >
            <span class="dot">
              <span class="num">{r.step}</span>
            </span>
            <span class="visually-hidden" data-rung-state />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  import { isSolved, PROGRESS_EVENT, readProgress } from "../scripts/progress.ts";

  function paint(): void {
    const progress = readProgress();
    for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-rung]")) {
      const solved = isSolved(progress[a.dataset["rung"] ?? ""]);
      a.classList.toggle("solved", solved);
      const state = a.querySelector("[data-rung-state]");
      if (state) state.textContent = solved ? " (solved)" : "";
    }
  }
  paint();
  document.addEventListener(PROGRESS_EVENT, paint);
</script>

<style>
  .ladder {
    max-width: 22.5rem;
    margin-top: var(--space-2);
  }
  .ends,
  ol {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  /* Each word sits over its own end of the line. */
  .ends {
    font-size: var(--size-xs);
    color: var(--muted);
    text-align: center;
  }
  .ends span:last-child {
    grid-column: 5;
  }
  ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The line runs from the middle of the first column to the middle of the last. */
  ol::before {
    content: "";
    position: absolute;
    inset: calc(50% - 1px) 10% auto;
    height: 2px;
    background: var(--rule);
  }
  a {
    position: relative;
    display: grid;
    place-items: center;
    height: 2.5rem;
    color: var(--text);
    font-size: var(--size-s);
    font-weight: 600;
    text-decoration: none;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .dot > *,
  .dot::after {
    grid-area: 1 / 1;
  }
  a:hover .dot {
    background: var(--header);
  }
  a.solved:not([aria-current="step"]) .dot {
    border-color: var(--correct);
    background: var(--correct-tint);
    color: var(--correct);
  }
  /* The tick covers the number, which stays in the link's name. */
  a.solved:not([aria-current="step"]) .num {
    opacity: 0;
  }
  a.solved:not([aria-current="step"]) .dot::after {
    content: "✓" / "";
  }
  a[aria-current="step"] .dot {
    border-color: var(--primary);
    background: var(--primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 20%, transparent);
    color: var(--on-primary);
  }
  /* Each step is its own page. Naming the filled dot lets the browser carry it
     across, so it glides to the new number while the pages cross-fade (timing
     in base.css). */
  @media (prefers-reduced-motion: no-preference) {
    a[aria-current="step"] .dot {
      view-transition-name: step-marker;
    }
  }
  @media (max-width: 47.99rem) {
    .ladder {
      width: 100%;
      margin-top: 0;
    }
    .ends {
      line-height: 1.375rem;
    }
    a {
      height: 2rem;
    }
  }
</style>
