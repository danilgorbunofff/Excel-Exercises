---
// Why this exists: the handle between the task and the sheet on wide screens.
// Drag it, or focus it and use the arrow keys, Home and End. The width is
// remembered in this browser.
---

<div
  class="divider"
  role="separator"
  aria-orientation="vertical"
  aria-label="Resize the task and sheet panels"
  aria-valuemin="25"
  aria-valuemax="65"
  aria-valuenow="40"
  tabindex="0"
  data-divider
>
  <span class="grip" aria-hidden="true"></span>
</div>

<style>
  .divider {
    display: none;
  }
  @media (min-width: 64rem) {
    .divider {
      grid-area: divider;
      position: sticky;
      top: 4rem;
      display: grid;
      place-items: center;
      height: calc(100dvh - 4rem);
      cursor: col-resize;
      touch-action: none;
      background: var(--panel);
      border-left: 1px solid var(--rule);
    }
    .divider:hover .grip,
    .divider:focus-visible .grip,
    .divider.dragging .grip {
      background: var(--primary);
    }
    .divider:focus-visible {
      outline-offset: -2px;
    }
  }
  .grip {
    width: 4px;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--line);
  }
</style>
