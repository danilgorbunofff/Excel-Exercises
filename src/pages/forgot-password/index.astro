---
// Why this exists: asks for the email to send a reset link to. Disabled until
// accounts open.
import AuthCard from "../../components/AuthCard.astro";
import Base from "../../layouts/Base.astro";
---

<Base title="Reset your password" description="Get a link to set a new password." layout="flush">
  <AuthCard title="Password reset" lead="Enter your email and we will send you a link to set a new password.">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
    <button class="button button-primary" type="submit">Send the link</button>
    <p slot="after" class="switch"><a href="/login/">Back to log in</a></p>
  </AuthCard>
</Base>
