---
// Why this exists: PRO function drills. Pick one function, several, all of
// them or ten at random, and short drills play one after another, each
// function from easy to hard. drills.ts reads the choice from the address,
// fetches each drill from /exercises/drills/task/ and opens it for PRO. The
// first drill is rendered here, hidden: it brings the workbench styles and is
// the preview a visitor without PRO sees.
import Icon from "../../../components/Icon.astro";
import LiveExercise from "../../../components/LiveExercise.astro";
import PracticeTabs from "../../../components/PracticeTabs.astro";
import Base from "../../../layouts/Base.astro";
import { drillTasks, exercisesForFunction } from "../../../lib/exercises.ts";
import { loadFunctionIndex } from "../../../lib/functions.ts";
import { PRICING_NAV } from "../../../lib/nav.ts";
import "../../../styles/assessments.css";

const drills = await drillTasks();
const first = drills[0];
if (!first) throw new Error("content/drills/ has no drills.");
const count = new Map<string, number>();
for (const d of drills) count.set(d.fn, (count.get(d.fn) ?? 0) + 1);
const index = loadFunctionIndex();
const groups = index.groups
  .map((g) => ({
    ...g,
    functions: index.functions.filter((f) => f.group === g.slug && count.has(f.name)),
  }))
  .filter((g) => g.functions.length > 0);
const pool = drills.map((d) => ({
  id: d.exercise.id,
  slug: d.exercise.slug,
  fn: d.fn,
  level: d.exercise.level,
}));
const poolJson = JSON.stringify(pool).replaceAll("<", "\\u003c");
---

<Base
  title="Function drills"
  description={`Short Excel drills for ${count.size} functions, one after another. Pick one function, several or all of them, from easy to hard.`}
  layout="wide"
>
  <PracticeTabs />
  <div class="a-page drills" data-drills>
    <script type="application/json" data-drill-pool set:html={poolJson} />

    <section class="ruled a-card" aria-labelledby="drills-title">
      <div class="a-head">
        <div>
          <p class="a-context">PRO</p>
          <h1 id="drills-title" class="a-title">Function drills</h1>
          <p class="a-lead">
            {drills.length} short drills for {count.size} functions. Pick the functions you want to
            practise and the drills come one after another, each function from easy to hard.
          </p>
        </div>
      </div>
    </section>

    <section class="ruled drill-session" aria-labelledby="session-title" data-session hidden>
      <div class="list-head session-head">
        <h2 id="session-title" data-session-title>Drill 1</h2>
        <div class="session-actions">
          <button class="link-button" type="button" data-skip>Skip</button>
          <button class="link-button" type="button" data-finish>Finish</button>
        </div>
      </div>
      <div class="a-pad">
        <div class="a-notice" data-paywall hidden>
          <p data-paywall-text>
            Function drills are part of PRO. Below is the first drill of your choice, so you can see
            what they are like.
          </p>
          <p>
            <a class="button button-primary" href={PRICING_NAV.href}>See PRO plans</a>
            <a class="button button-outline" href="/login/?next=/exercises/drills/" data-when="out"
              >Log in</a
            >
          </p>
        </div>
        <p role="alert" data-drill-error hidden>
          The drill did not load. Reload the page to try again.
        </p>
        <div data-drill-slot>
          <LiveExercise placed={first} heading={first.exercise.title} defer drill={first.fn} />
        </div>
      </div>
    </section>

    <section class="ruled" aria-labelledby="done-title" data-summary hidden>
      <div class="list-head">
        <h2 id="done-title" tabindex="-1">Drills done</h2>
      </div>
      <div class="a-pad summary">
        <p data-summary-line></p>
        <div data-summary-missed hidden>
          <h3>Practise these again</h3>
          <ul class="missed" data-missed-list></ul>
        </div>
        <p class="summary-actions">
          <a class="button button-primary" href="" data-again>Drill again</a>
          <a class="button button-outline" href="/exercises/drills/">Pick other functions</a>
        </p>
      </div>
    </section>

    <form class="ruled picker" method="get" action="/exercises/drills/" data-picker>
      <div class="list-head">
        <h2 id="pick-title">Pick functions</h2>
      </div>
      <div class="a-pad">
        <p class="quick">
          <button class="button button-outline" type="submit" name="fn" value="random">
            <Icon name="bolt" size={16} />10 random drills
          </button>
          <button class="button button-outline" type="submit" name="fn" value="all">
            All {drills.length} drills, shuffled
          </button>
        </p>
        {
          groups.map((g) => (
            <fieldset class="group">
              <legend>{g.title}</legend>
              <div class="fns">
                {g.functions.map((f) => (
                  <label class="fn">
                    <input type="checkbox" name="fn" value={f.name} />
                    <span class="name">{f.name}</span>
                    <span class="count">{count.get(f.name)}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <p class="start">
          <button class="button button-primary" type="submit" data-start>Start drills</button>
          <span class="hint" data-pick-hint>Tick one or more functions.</span>
        </p>
        <noscript>
          <p>
            Drills need JavaScript. Every exercise also works on its own page, for example
            <a href={exercisesForFunction("SUM")}>the SUM exercises</a>.
          </p>
        </noscript>
      </div>
    </form>
  </div>
</Base>

<script>
  import "../../../scripts/drills.ts";
</script>

<style>
  .drills {
    padding-top: var(--space-5);
  }
  .session-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .session-actions {
    display: flex;
    gap: var(--space-4);
  }
  .drill-session :global(.live) {
    margin: 0;
  }
  .quick,
  .start,
  .summary-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }
  /* The list is long: Start stays on screen while the picker does. Sticky needs the card not to clip. */
  .picker {
    overflow: visible;
  }
  .start {
    position: sticky;
    bottom: 0;
    z-index: 1;
    margin: var(--space-4) 0 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
    background: var(--surface);
  }
  .hint {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .group {
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
  }
  .group legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .fns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .fn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
    cursor: pointer;
  }
  .fn:has(input:checked) {
    border-color: var(--primary);
  }
  .fn:has(input:focus-visible) {
    outline: 2px solid var(--focus, var(--primary));
    outline-offset: 2px;
  }
  .name {
    font-family: var(--font-mono, monospace);
  }
  .count {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .summary p {
    margin: 0 0 var(--space-3);
  }
  .summary h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-base);
  }
  .missed {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }
  [data-session][hidden],
  [data-summary][hidden],
  [data-picker][hidden] {
    display: none;
  }
</style>
