---
// Why this exists: the signed-in home. What to do next, the plan, how far
// through the course you are, this month's numbers and the latest activity,
// each linking to its full account page. The page is static; account-overview.ts
// fills it from /api/me, progress, the daily days and /api/assessments.
import AccountShell from "../../components/AccountShell.astro";
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import { loadAssessments } from "../../lib/assessments.ts";
import { dailyTasks, exercisePath, LEVELS, placedExercises } from "../../lib/exercises.ts";

const placed = await placedExercises();
const items = placed.map((p) => ({
  id: p.exercise.id,
  title: p.exercise.title,
  href: exercisePath(p.exercise.slug),
  level: p.exercise.level,
  track: p.topic.slug,
  trackTitle: p.topic.title,
  number: p.topicNumber,
  trackTotal: p.topicTotal,
}));
const dailyTitles = Object.fromEntries(
  (await dailyTasks()).map((d) => [d.exercise.id, d.exercise.title]),
);
const setTitles = Object.fromEntries(loadAssessments().sets.map((s) => [s.slug, s.title]));
const data = JSON.stringify({ items, dailyTitles, setTitles }).replaceAll("<", "\\u003c");
---

<Base title="Your account" description="What to do next, your plan and your progress." layout="flush">
  <AccountShell
    current="overview"
    title="Overview"
    lead="What to do next, your plan and how far you have got."
    outLead="Log in to see your progress, your plan and what to do next, on any device."
  >
    <form class="setting" method="post" action="/api/account/news/" aria-labelledby="ov-mail" data-daily-ask hidden>
      <input type="hidden" name="from" value="/account/" />
      <input type="hidden" name="answer" value="1" />
      <div class="setting-body">
        <div class="switch-row">
          <div>
            <b id="ov-mail">Get the daily exercise by email?</b>
            <p class="fine">One short email a day with that day's exercise, plus tips and offers now and then. Unsubscribe in one click.</p>
          </div>
          <span class="switch"><input type="checkbox" role="switch" name="daily" aria-labelledby="ov-mail" /><span aria-hidden="true"></span></span>
        </div>
      </div>
      <div class="setting-foot">
        <span>You can change it later on the account settings.</span>
        <button class="button button-primary sm" type="submit">Save</button>
      </div>
    </form>

    <section class="box cont" aria-labelledby="ov-next">
      <div class="cont-main">
        <div>
          <p class="eyebrow" data-next-label>Start here</p>
          <h2 id="ov-next"><a class="plain" href={items[0]?.href} data-next>{items[0]?.title}</a></h2>
          <p class="fine" data-next-meta>{items[0]?.trackTitle}</p>
        </div>
        <a class="button button-primary" href={items[0]?.href} data-next-button>
          <Icon name="play" size={16} />
          <span data-next-verb>Start</span>
        </a>
      </div>
      <div class="cont-foot">
        <a href="/daily/"><Icon name="calendar" size={16} /><span data-daily-line>Today's daily exercise</span></a>
        <a href="/account/progress/"><Icon name="reset" size={16} /><span data-due-line>Nothing due for review</span></a>
      </div>
    </section>

    <section class="sect" aria-labelledby="ov-plan">
      <div class="sect-head"><h2 id="ov-plan">Plan</h2></div>
      <div class="box plan-row">
        <div>
          <p class="plan-name"><b data-plan-name>Free plan</b><span class="tag" data-plan-tag hidden>PRO</span></p>
          <p class="fine" data-plan-line>
            The first two exercises in every track are free. PRO opens all {items.length}, the timed mock
            assessments and certificates.
          </p>
        </div>
        <a class="button button-primary" href="/account/billing/" data-plan-button>See plans</a>
      </div>
    </section>

    <section class="sect" aria-labelledby="ov-progress">
      <div class="sect-head">
        <h2 id="ov-progress">Progress</h2>
        <a class="lnk" href="/account/progress/">Open progress</a>
      </div>
      <div class="box pad stack">
        <p class="total">
          <strong data-solved>0</strong>
          <span class="muted">of {items.length} exercises solved, <span data-percent>0%</span> of the course</span>
        </p>
        <p class="muted" data-level-line hidden></p>
        <div class="segbar" role="img" aria-label="Solved by difficulty" data-segbar>
          {[1, 2, 3].map((n) => <span class={`seg-${n}`} data-seg={n}></span>)}
        </div>
        <dl class="legend">
          {
            Object.entries(LEVELS).map(([n, name]) => (
              <div class={`leg-${n}`}>
                <dt><span class={`level level-${n}`}>{name}</span></dt>
                <dd data-legend={n}>0 of {items.filter((i) => String(i.level) === n).length}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="sect" aria-labelledby="ov-month">
      <div class="sect-head"><h2 id="ov-month" data-month-name>This month</h2></div>
      <dl class="box figs">
        <div><dt>Days practised</dt><dd data-fig="days">0</dd></div>
        <div><dt>Daily streak</dt><dd><span data-fig="streak">0</span> <small>days</small></dd></div>
        <div><dt>Due for review</dt><dd data-fig="due">0</dd></div>
        <div><dt>Certificates</dt><dd data-fig="certs">0</dd></div>
      </dl>
    </section>

    <section class="sect" aria-labelledby="ov-recent">
      <div class="sect-head">
        <h2 id="ov-recent">Recent activity</h2>
        <a class="lnk" href="/account/progress/">See all</a>
      </div>
      <p class="box pad muted" data-recent-empty>Nothing yet. Solve an exercise and it shows here.</p>
      <div class="box" data-recent-box hidden>
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr><th scope="col">Exercise</th><th scope="col">Where</th><th scope="col">Result</th><th scope="col" class="r">When</th></tr>
            </thead>
            <tbody data-recent></tbody>
          </table>
        </div>
      </div>
    </section>
  </AccountShell>
  <script type="application/json" data-overview set:html={data} />
</Base>

<script>
  import "../../scripts/account-overview.ts";
</script>
