---
// Why this exists: one page per exercise, in the single track order. The
// workbench itself is ExerciseWorkbench; a PRO exercise (isLocked) is built
// without its answers and locked-exercise.ts opens it for a PRO visitor.
import ExerciseWorkbench from "../../components/ExerciseWorkbench.astro";
import Base from "../../layouts/Base.astro";
import {
  functionsOf,
  laddersOf,
  listWords as list,
  moreAfter,
  type Placed,
  placedExercises,
  stepTasks,
} from "../../lib/exercises.ts";
import type { Rung } from "../../lib/steps.ts";

export async function getStaticPaths() {
  const all = await placedExercises();
  const ladders = laddersOf(await stepTasks());
  return all.map((placed) => ({
    params: { slug: placed.exercise.slug },
    props: { placed, more: moreAfter(all, placed), ladder: ladders.get(placed.exercise.id) },
  }));
}

interface Props {
  placed: Placed;
  more: Placed[];
  ladder?: Rung[] | undefined;
}
const { placed, more, ladder } = Astro.props;
const { exercise } = placed;
const first = exercise.screens[0];
if (!first) throw new Error(`${exercise.id} has no screens`);
const functions = functionsOf(exercise);
const description = `Practise ${functions.length > 0 ? list(functions) : "Excel formulas"} on a real grid. ${first.prompt}`;
---

<Base
  title={exercise.title}
  description={description}
  skipTo={{ href: "#formula", label: "Skip to the formula" }}
  layout="exercise"
>
  <ExerciseWorkbench placed={placed} more={more} ladder={ladder} />
</Base>
