---
// Why this exists: a working exercise inside another page. The home page runs
// the first exercise this way, and each function page ends with one.
import { isLocked } from "../lib/access.ts";
import { TIER_NAMES } from "../lib/daily.ts";
import { drillsPath, exercisePath, LEVELS, nextAction, type Placed } from "../lib/exercises.ts";
import ExerciseData from "./ExerciseData.astro";
import HintLadder from "./HintLadder.astro";
import RichText from "./RichText.astro";
import Sheet from "./Sheet.astro";
import StatusBar from "./StatusBar.astro";

interface Props {
  placed: Placed;
  heading: string;
  /** Lines under the heading, before the task. */
  intro?: string;
  /** Left for the page's own script to start, as the daily page does. */
  defer?: boolean;
  /** A daily-only task: no page of its own, and its number is its step of the week. */
  daily?: boolean;
  /** A PRO function drill: always locked, and its number is its place among the drills of its function. */
  drill?: string;
}
const { placed, heading, intro, defer = false, daily = false, drill } = Astro.props;
// An embed would put a PRO answer in a free page. Daily tasks are always free; drills always PRO.
const locked = drill !== undefined || (!daily && isLocked(placed));
if (locked && !defer) {
  throw new Error(
    `${Astro.url.pathname} embeds ${placed.exercise.id}, a PRO exercise. Embed a free one.`,
  );
}
// An embedded sheet shows only its data, without the empty rows around it.
const { exercise, number, total } = placed;
const path = drill ? drillsPath(drill) : exercisePath(exercise.slug);
const nextOf = (i: number) =>
  drill ? { href: drillsPath(), label: "Next task", isStep: false } : nextAction(placed, i);
---

<section
  class="live"
  data-exercise
  data-defer={defer ? "" : undefined}
  data-locked={locked ? exercise.slug : undefined}
  aria-labelledby="live-heading"
>
  <h2 id="live-heading" data-live-heading>{heading}</h2>
  {intro && <p class="intro">{intro}</p>}
  <div class="task">
    {
      exercise.screens.map((s, i) => (
        <p data-prompt={i} hidden={i > 0}>
          <strong>{exercise.title}.</strong> <RichText text={s.prompt} />
        </p>
      ))
    }
  </div>
  {
    exercise.screens.map((s, i) => (
      <div class="work" data-screen={i} hidden={i > 0}>
        <Sheet screen={s} index={i} action={path} compact />
        <StatusBar index={i} answerCell={s.answerCell} next={nextOf(i)} />
      </div>
    ))
  }
  {
    drill ? (
      <p class="meta">
        {drill} task {number} of {total}, {LEVELS[exercise.level as 1 | 2 | 3].toLowerCase()}.
        <span data-progress hidden></span>
      </p>
    ) : daily ? (
      <p class="meta">
        {TIER_NAMES[number]}: step {number} of {total} this week.
        <span data-progress hidden></span>
      </p>
    ) : (
      <p class="meta">
        Exercise {number} of {total}, {LEVELS[exercise.level as 1 | 2 | 3].toLowerCase()}.
        <span data-progress hidden></span>
        <a href={path}>Open it on its own page</a> for notes on the function.
      </p>
    )
  }
  <h3>Hints</h3>
  {exercise.screens.map((s, i) => <HintLadder screen={s} index={i} locked={locked} />)}
  <ExerciseData exercise={exercise} locked={locked} />
</section>

<style>
  .live {
    margin: var(--space-5) calc(-1 * var(--space-4)) 0;
    padding: var(--space-4);
    background: var(--panel);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-l);
  }
  .intro,
  .task,
  .meta {
    margin: 0 0 var(--space-3);
  }
  .meta {
    margin: var(--space-3) 0 var(--space-2);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .meta a {
    color: var(--text);
  }
  .task p {
    margin: 0;
  }
  .work[hidden],
  [data-prompt][hidden],
  [data-progress][hidden] {
    display: none;
  }
  h3 {
    margin: var(--space-4) 0 var(--space-1);
    font-size: var(--size-base);
  }
  @media (min-width: 48rem) {
    .live {
      margin-inline: 0;
      border-radius: var(--radius-m);
    }
  }
</style>
