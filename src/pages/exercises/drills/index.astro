---
// Why this exists: PRO function practice. Pick one function, several, all of
// them or ten at random, and short tasks play one after another, each
// function from easy to hard. The page follows the learning tracks layout:
// an open head, the function groups as cards, and "Your set" beside them
// with the Start button. drills.ts reads the choice from the
// address, fetches each task from /exercises/drills/task/ and opens it for
// PRO. The first task is rendered here, hidden: it brings the workbench
// styles and is the preview a visitor without PRO sees.
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Icon, { type IconName } from "../../../components/Icon.astro";
import LiveExercise from "../../../components/LiveExercise.astro";
import PracticeTabs from "../../../components/PracticeTabs.astro";
import Base from "../../../layouts/Base.astro";
import { drillTasks, exercisesForFunction } from "../../../lib/exercises.ts";
import { loadFunctionIndex } from "../../../lib/functions.ts";
import { PRICING_NAV } from "../../../lib/nav.ts";
import "../../../styles/assessments.css";

const drills = await drillTasks();
const first = drills[0];
if (!first) throw new Error("content/drills/ has no drills.");
const count = new Map<string, number>();
for (const d of drills) count.set(d.fn, (count.get(d.fn) ?? 0) + 1);
const perFunction = Math.max(...count.values());
const index = loadFunctionIndex();
const groups = index.groups
  .map((g) => ({
    ...g,
    functions: index.functions.filter((f) => f.group === g.slug && count.has(f.name)),
  }))
  .filter((g) => g.functions.length > 0);
// One line icon per function group, the same set the learning tracks use.
const GROUP_ICONS: Record<string, IconName> = {
  summarise: "sigma",
  count: "count",
  decide: "branch",
  conditional: "filter",
  lookup: "lookup",
  round: "formula",
  rank: "chart",
  text: "text",
  errors: "hint",
  dates: "calendar",
  arrays: "grid",
};
const pool = drills.map((d) => ({
  id: d.exercise.id,
  slug: d.exercise.slug,
  fn: d.fn,
  level: d.exercise.level,
}));
const poolJson = JSON.stringify(pool).replaceAll("<", "\\u003c");
---

<Base
  title="Function practice"
  description={`Short Excel tasks for ${count.size} functions, one after another. Pick one function, several or all of them, from easy to hard.`}
  layout="wide"
>
  <PracticeTabs />
  <div class="a-page practice" data-drills>
    <script type="application/json" data-drill-pool set:html={poolJson} />

    <header class="open-head">
      <Breadcrumbs items={[{ label: "Exercises", href: "/exercises/" }]} />
      <span class="tag">PRO</span>
      <h1>Function practice</h1>
      <p class="lead">
        Pick the functions you want to get fast at. Short tasks come one after another, each
        function from easy to hard, with instant marking.
      </p>
    </header>

    <section class="ruled drill-session" aria-labelledby="session-title" data-session hidden>
      <div class="list-head session-head">
        <h2 id="session-title" data-session-title>Task 1</h2>
        <div class="session-actions">
          <button class="link-button" type="button" data-skip>Skip</button>
          <button class="link-button" type="button" data-finish>Finish</button>
        </div>
      </div>
      <div class="a-pad">
        <div class="a-notice" data-paywall hidden>
          <p data-paywall-text>
            Function practice is part of PRO. Below is the first task of your choice, so you can see
            what they are like.
          </p>
          <p>
            <a class="button button-primary" href={PRICING_NAV.href}>See PRO plans</a>
            <a class="button button-outline" href="/login/?next=/exercises/drills/" data-when="out"
              >Log in</a
            >
          </p>
        </div>
        <p role="alert" data-drill-error hidden>
          The task did not load. Reload the page to try again.
        </p>
        <div data-drill-slot>
          <LiveExercise placed={first} heading={first.exercise.title} defer drill={first.fn} />
        </div>
      </div>
    </section>

    <section class="ruled" aria-labelledby="done-title" data-summary hidden>
      <div class="list-head">
        <h2 id="done-title" tabindex="-1">Tasks done</h2>
      </div>
      <div class="a-pad summary">
        <p data-summary-line></p>
        <div data-summary-missed hidden>
          <h3>Practise these again</h3>
          <ul class="missed" data-missed-list></ul>
        </div>
        <p class="summary-actions">
          <a class="button button-primary" href="" data-again>Practise again</a>
          <a class="button button-outline" href="/exercises/drills/">Pick other functions</a>
        </p>
      </div>
    </section>

    <form
      class="a-grid picker"
      id="picker"
      method="get"
      action="/exercises/drills/"
      aria-labelledby="pick-title"
      data-picker
    >
      <section class="board" aria-labelledby="pick-title">
        <div class="board-head">
          <div>
            <h2 id="pick-title">Choose functions</h2>
            <p>{count.size} functions in {groups.length} groups, {perFunction} tasks each.</p>
          </div>
          <label class="filter" data-filter-wrap hidden>
            <Icon name="filter" size={16} />
            <span class="visually-hidden">Filter functions</span>
            <input type="search" placeholder="Filter, e.g. LOOKUP" autocomplete="off" data-filter />
          </label>
        </div>
        <div class="rows">
          {
            groups.map((g) => (
              <div class="card group-card" role="group" aria-labelledby={`g-${g.slug}`} data-group>
                <div class="group-top">
                  <span class="icon-box">
                    <Icon name={GROUP_ICONS[g.slug] ?? "grid"} size={22} />
                  </span>
                  <span class="picked" data-group-count hidden />
                  <button class="link-button toggle" type="button" data-group-toggle hidden>
                    Select all
                  </button>
                </div>
                <h3 id={`g-${g.slug}`}>{g.title}</h3>
                <p class="group-meta">
                  {g.functions.length} functions <span aria-hidden="true">·</span>{" "}
                  {g.functions.reduce((n, f) => n + (count.get(f.name) ?? 0), 0)} tasks
                </p>
                <div class="picks">
                  {g.functions.map((f) => (
                    <label class="pick" data-pick={f.name}>
                      <input class="visually-hidden" type="checkbox" name="fn" value={f.name} />
                      <Icon name="check" size={14} class="tick" />
                      <span>{f.name}</span>
                      <span class="done" data-done hidden title={`All ${f.name} tasks solved`}>
                        <span class="visually-hidden">, all solved</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
          <p class="no-match" data-no-match hidden>No function matches that. Clear the filter to see them all.</p>
        </div>
      </section>

      <div class="side-col">
        <aside class="set" aria-labelledby="set-title">
          <div class="set-head">
            <h2 id="set-title">Your set</h2>
            <button class="link-button" type="button" data-clear hidden>Clear</button>
          </div>
          <div class="set-body">
            <p class="set-total">
              <strong data-set-tasks>0</strong>
              <span data-set-unit>tasks</span>
            </p>
            <p class="set-count" data-set-count data-pick-hint>Tick one or more functions.</p>
            <ul class="chips set-chips" data-set-chips hidden></ul>
            <button class="button button-primary set-start" type="submit" data-start data-empty>
              Start
            </button>
            <p class="set-note">Each function runs from easy to hard. Skip or finish whenever you like.</p>
          </div>
          <noscript>
            <p class="set-note">
              Practice needs JavaScript. Every exercise also works on its own page, for example
              <a href={exercisesForFunction("SUM")}>the SUM exercises</a>.
            </p>
          </noscript>
        </aside>
        <section class="card quick" aria-labelledby="quick-title">
          <h2 id="quick-title">Not sure what to pick?</h2>
          <p>We mix tasks from all {count.size} functions.</p>
          <button class="button button-outline" type="submit" name="fn" value="random">
            <Icon name="bolt" size={16} />10 random tasks
          </button>
          <button class="button button-secondary" type="submit" name="fn" value="all">
            All {drills.length}, shuffled
          </button>
        </section>
      </div>
    </form>
  </div>
</Base>

<script>
  import "../../../scripts/drills.ts";
</script>

<style>
  .practice {
    padding-top: var(--space-5);
  }
  .session-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .session-actions {
    display: flex;
    gap: var(--space-4);
  }
  .drill-session :global(.live) {
    margin: 0;
  }
  .summary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .summary p {
    margin: 0 0 var(--space-3);
  }
  .summary h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-base);
  }
  .missed {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  /* The board: a heading with the filter, then one card per function group. */
  .board {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
  }
  .board-head h2 {
    margin: 0 0 var(--space-1);
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .board-head p {
    margin: 0;
    color: var(--muted);
  }
  .filter {
    flex: 0 1 16rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--muted);
  }
  .filter:focus-within {
    border-color: var(--primary);
  }
  .filter input {
    flex: 1;
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--size-s);
    outline: none;
  }
  @media (max-width: 39.99rem) {
    .filter {
      flex-basis: 100%;
    }
  }
  .rows {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 48rem) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .no-match {
      grid-column: 1 / -1;
    }
  }
  .group-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .group-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .group-top .icon-box {
    margin-right: auto;
    border: 1px solid var(--chip-line);
  }
  .picked {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--chip-line);
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    color: var(--chip);
    font-size: var(--size-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .group-card h3 {
    margin: 0;
    font-size: var(--size-l);
    color: var(--heading);
  }
  .group-meta {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .toggle {
    min-height: 1.5rem;
    font-size: var(--size-s);
    font-weight: 600;
    color: var(--correct);
  }
  .toggle:hover {
    text-decoration: underline;
  }
  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  /* A function: a quiet pill that fills in when ticked. The box itself is
     hidden but still takes the focus and the clicks through its label. */
  .pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--size-s);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  .pick:hover {
    border-color: var(--muted);
  }
  .pick :global(.tick) {
    display: none;
  }
  .pick:has(input:checked) {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }
  .pick:has(input:checked) :global(.tick) {
    display: block;
  }
  .pick:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .done {
    width: 0.4rem;
    height: 0.4rem;
    margin-left: var(--space-1);
    border-radius: 50%;
    background: var(--correct);
  }
  .pick:has(input:checked) .done {
    background: var(--on-primary);
  }
  .pick[hidden],
  .group-card[hidden],
  .picked[hidden],
  .done[hidden],
  .no-match[hidden],
  .filter[hidden] {
    display: none;
  }
  .no-match {
    margin: 0;
    padding: var(--space-5) 0;
    color: var(--muted);
  }

  /* Your set: a dark panel beside the board, like the learning tracks
     summary; on phones a bar that stays at the bottom of the screen. */
  .side-col {
    display: grid;
    gap: var(--space-4);
  }
  .set {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--footer-bg);
    color: var(--on-footer-muted);
  }
  .set-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .set-head h2 {
    margin: 0;
    font-size: var(--size-base);
    color: var(--on-footer);
  }
  .set-head .link-button {
    min-height: 1.5rem;
    font-size: var(--size-s);
    color: var(--on-footer);
  }
  .set-body {
    display: grid;
    gap: var(--space-3);
  }
  .set p {
    margin: 0;
  }
  .set a {
    color: var(--on-footer);
  }
  .set-total {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .set-total strong {
    font-size: var(--size-xxl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--on-footer);
  }
  .set-count,
  .set-note {
    font-size: var(--size-s);
  }
  .set-chips {
    gap: var(--space-1);
  }
  .set-chips :global(.more) {
    align-self: center;
    font-size: var(--size-s);
  }
  .set-start {
    width: 100%;
  }
  .set-start[data-empty] {
    background: var(--on-dark-card);
    color: var(--on-footer-muted);
    cursor: not-allowed;
  }
  .quick {
    display: grid;
    gap: var(--space-3);
  }
  .quick h2 {
    margin: 0;
    font-size: var(--size-base);
    color: var(--heading);
  }
  .quick p {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .quick .button {
    width: 100%;
  }
  @media (min-width: 64rem) {
    .side-col {
      position: sticky;
      top: 5rem;
    }
  }
  @media (max-width: 63.99rem) {
    /* The set and the quick card join the form's grid, so the set can stick
       to the bottom of the screen while the groups scroll. */
    .side-col {
      display: contents;
    }
    .quick {
      order: -1;
    }
    .set {
      position: sticky;
      bottom: var(--space-3);
      z-index: 1;
      padding: var(--space-3) var(--space-4);
      box-shadow: var(--shadow-pop);
    }
    .set-head,
    .set-chips,
    .set-note,
    .set-count {
      display: none;
    }
    .set-body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .set-total strong {
      font-size: var(--size-l);
    }
    .set-start {
      width: auto;
      padding-inline: var(--space-5);
    }
  }
  [data-session][hidden],
  [data-summary][hidden],
  [data-picker][hidden],
  [data-set-chips][hidden],
  [data-group-toggle][hidden],
  [data-clear][hidden] {
    display: none;
  }
</style>
