---
import { isLocked } from "../lib/access.ts";
import { ladderPool, pickFor } from "../lib/daily.ts";
import {
  dailyTasks,
  drillTasks,
  exercisePath,
  functionsOf,
  LEVELS,
  laddersOf,
  placedExercises,
  stepTasks,
} from "../lib/exercises.ts";
import { ACCOUNT_NAV, PRACTICE_NAV } from "../lib/nav.ts";
import { richText } from "../lib/rich-text.ts";
// Why this exists: what you have done and what is next, shared by the Home
// page (guests and signed-in visitors) and /account/progress/ (inside the
// account area). It reads progress from this browser, which a signed-in
// visitor's account keeps in step (session.ts). An open head with what to do
// next, the days you practised with the numbers, then review. Home adds the
// scoreboard, today's exercise and the ways to practise.
import Icon from "./Icon.astro";
import "../styles/assessments.css";

const placed = await placedExercises();
const first = placed[0];
if (!first) throw new Error("The track has no exercises");
const ladders = laddersOf(await stepTasks());
const list = placed.map((p) => ({
  id: p.exercise.id,
  number: p.number,
  title: p.exercise.title,
  href: exercisePath(p.exercise.slug),
  locked: isLocked(p),
  level: p.exercise.level,
  track: p.topic.slug,
  trackTitle: p.topic.title,
  fns: functionsOf(p.exercise),
  ladder: ladders.get(p.exercise.id),
}));
// Drills come back on the review list too, but never count as exercises solved.
const drills = (await drillTasks()).map((d, i) => ({
  id: d.exercise.id,
  number: placed.length + i + 1,
  title: `${d.fn} practice: ${d.exercise.title}`,
  href: `/exercises/drills/${d.exercise.slug}/`,
  locked: true,
  level: d.exercise.level,
  track: "drills",
  trackTitle: "Function practice",
  fns: [d.fn],
}));

interface Props {
  /** Inside the account area: the shell shows the page title, so this leaves out its own. */
  embedded?: boolean;
  /** The Home page layout: one overview card, then two equal columns per row. */
  home?: boolean;
}
const { embedded = false, home = false } = Astro.props;

// Home: today's daily exercise is picked in the browser from this pool, by the
// visitor's own date; the build day's pick is rendered so the card is never empty.
const daily = home ? await dailyTasks() : [];
const dailyPool = ladderPool(daily.map((t) => ({ ...t.exercise, tier: t.tier })));
const dailyInfo = Object.fromEntries(
  daily.map((t) => [
    t.exercise.id,
    {
      title: t.exercise.title,
      task: richText(t.exercise.screens[0]?.prompt ?? "")
        .map((p) => p.text)
        .join(""),
      level: t.exercise.level,
    },
  ]),
);
const buildPick = pickFor(new Date().toISOString().slice(0, 10), dailyPool);
const todayTask = dailyInfo[buildPick?.id ?? daily[0]?.exercise.id ?? ""];
// Home's Practise card: Exercises large, with progress, then four tiles with a
// shorter line than the header menu has room for.
const way = (href: string) => {
  const item = PRACTICE_NAV.find((i) => i.href === href);
  if (!item) throw new Error(`No practice page at ${href}`);
  return item;
};
const exercisesWay = way("/exercises/");
const tiles = [
  { ...way("/exercises/drills/"), tone: "yellow", line: "10 free a day with an account" },
  { ...way("/exercises/tracks/"), tone: "blue", line: "Learn in teaching order" },
  { ...way("/mock-assessments/"), tone: "violet", line: "Timed, marked at the end" },
  { ...way("/daily/"), tone: "red", line: "One free exercise a day" },
];
const json = (v: unknown) => JSON.stringify(v).replaceAll("<", "\\u003c");
---

  <div class:list={["a-page", { embedded }]}>
    <header class="open-head">
      {
        home && (
          <>
            <h1 id="progress-title" data-home-title>Welcome</h1>
            <p class="lead" data-home-lead>Solve one exercise a day to build a streak.</p>
          </>
        )
      }
      {
        !embedded && !home && (
          <>
            <h1 id="progress-title">Your progress</h1>
            <p class="lead" data-when="out">
              Saved in this browser. <a href={ACCOUNT_NAV.register.href}>Sign up free</a> to keep it
              on every device.
            </p>
            <p class="lead" data-when="in" hidden>
              Saved to your account. <a href="/account/progress/">Open it in your account</a> with
              your tracks and daily streak.
            </p>
          </>
        )
      }
      <p class="actions">
        <a class="button button-primary" href={exercisePath(first.exercise.slug)} data-next>
          Start: {first.exercise.title}
        </a>
        <a class="button button-outline" href="/daily/" data-review-next>Today's exercise</a>
      </p>
    </header>

    {
      home && (
        <section class="card h-overview" aria-label="Your practice">
      <section class="p-heat" aria-labelledby="heat-title">
        <div class="p-heat-head">
          <h2 id="heat-title">Days you practised</h2>
          <span>Last 6 months</span>
        </div>
        <div class="heat-months" aria-hidden="true" data-heat-months></div>
        <div class="heat" role="img" aria-label="No practice yet" data-heat></div>
        <div class="hover-tip" aria-hidden="true" data-heat-tip><strong></strong><span></span></div>
        <p class="heat-legend" aria-hidden="true">
          Less <i></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> More
        </p>
      </section>
          <dl class="h-kpis" aria-label="Your numbers">
            <div>
              <dd class="h-chip" aria-hidden="true"><Icon name="check" size={18} /></dd>
              <dt>Solved of {placed.length}</dt>
              <dd class="h-n" data-stat="solved">0</dd>
              <dd class="h-note"><span data-stat="week">0</span> this week</dd>
            </div>
            <div data-tone="yellow">
              <dd class="h-chip" aria-hidden="true"><Icon name="bolt" size={18} /></dd>
              <dt>Day streak</dt>
              <dd class="h-n" data-stat="streak-n">0</dd>
              <dd class="h-note">Best: <span data-stat="best">0 days</span></dd>
            </div>
            <div data-tone="blue">
              <dd class="h-chip" aria-hidden="true"><Icon name="reset" size={18} /></dd>
              <dt>Due for review</dt>
              <dd class="h-n" data-stat="due">0</dd>
              <dd class="h-note"><span data-stat="never">0</span> never solved</dd>
            </div>
            <div data-tone="mint">
              <dd class="h-chip" aria-hidden="true"><Icon name="user" size={18} /></dd>
              <dt>On your own</dt>
              <dd class="h-n" data-stat="own">0</dd>
              <dd class="h-note"><span data-stat="helped">0</span> with help</dd>
            </div>
          </dl>
        </section>
      )
    }
    {!home && (
    <div class="p-activity">
      <section class="card p-heat" aria-labelledby="heat-title">
        <div class="p-heat-head">
          <h2 id="heat-title">Days you practised</h2>
          <span>Last 6 months</span>
        </div>
        <div class="heat-months" aria-hidden="true" data-heat-months></div>
        <div class="heat" role="img" aria-label="No practice yet" data-heat></div>
        <div class="hover-tip" aria-hidden="true" data-heat-tip><strong></strong><span></span></div>
        <p class="heat-legend" aria-hidden="true">
          Less <i></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> More
        </p>
      </section>
      <dl class="p-nums" aria-label="Your numbers">
        <div class="card">
          <dt>solved of {placed.length}</dt>
          <dd data-stat="solved">0</dd>
        </div>
        <div class="card">
          <dt>current streak, best <span data-stat="best">0 days</span></dt>
          <dd data-stat="streak">0 days</dd>
        </div>
        <div class="card">
          <dt>on your own, <span data-stat="helped">0</span> with help</dt>
          <dd data-stat="own">0</dd>
        </div>
      </dl>
    </div>
    )}
    <noscript>
      <p class="ruled a-pad">This page needs JavaScript to read your progress from this browser.</p>
    </noscript>

    {
      home && (
        <div class="h-row">
          <section class="h-block" aria-labelledby="board-title" data-board>
            <div class="h-board">
              <div class="h-board-head">
                <h2 id="board-title">Scoreboard</h2>
                <div class="h-seg" role="group" aria-label="Scoreboard period">
                  <button type="button" data-board-period="week" aria-pressed="true">This week</button>
                  <button type="button" data-board-period="all" aria-pressed="false">All time</button>
                </div>
              </div>
              <table class="h-ranks" aria-labelledby="board-title">
                <thead>
                  <tr>
                    <th scope="col" class="h-rank"><span class="visually-hidden">Rank</span></th>
                    <th scope="col"><span class="visually-hidden">Learner</span></th>
                    <th scope="col" class="h-pts"><span class="visually-hidden">Points</span></th>
                  </tr>
                </thead>
                <tbody data-board-rows></tbody>
                <tbody data-board-me hidden>
                  <tr class="h-gap" aria-hidden="true"><td colspan="3">⋯</td></tr>
                  <tr class="h-you">
                    <td class="h-rank"><span class="h-medal" data-me-rank></span></td>
                    <th scope="row">
                      <span class="h-who">
                        <span class="h-ava" aria-hidden="true"><Icon name="user" size={16} /></span>
                        <span class="h-me">
                          <span class="h-name">You</span>
                          <span class="h-meta" data-me-level></span>
                        </span>
                      </span>
                    </th>
                    <td class="h-pts"><span data-me-points>0</span> <small>pts</small></td>
                  </tr>
                </tbody>
              </table>
              <template data-board-row>
                <tr>
                  <td class="h-rank"><span class="h-medal"></span></td>
                  <th scope="row">
                    <span class="h-who">
                      <span class="h-ava" aria-hidden="true"></span>
                      <span class="h-me"><span class="h-name"></span><span class="h-meta"></span></span>
                    </span>
                  </th>
                  <td class="h-pts"><span></span> <small>pts</small></td>
                </tr>
              </template>
              <p class="h-empty" data-board-empty>Loading the scoreboard.</p>
              <p class="h-foot h-note" data-board-note hidden></p>
            </div>
          </section>

          <section class="h-block" aria-labelledby="review-title">
            <div class="h-board">
              <div class="h-board-head">
                <h2 id="review-title">Due for review</h2>
                <div class="h-seg" role="group" aria-label="Review filter">
                  <button type="button" data-review-only="" aria-pressed="true">
                    All <span data-review-total>0</span>
                  </button>
                  <button type="button" data-review-only="unsolved" aria-pressed="false">
                    Unsolved <span data-review-unsolved>0</span>
                  </button>
                </div>
              </div>
              <p class="h-empty" data-review-empty>
                Nothing to review. Exercises you got wrong, and solved ones due again, come back
                here.
              </p>
              <div class="h-due-body" data-review hidden>
                <ol
                  class="h-due"
                  aria-labelledby="review-title"
                  data-review-rows
                  data-review-table
                  data-review-shown="5"
                >
                </ol>
                <p class="h-empty" data-review-none hidden>
                  Every exercise here has been solved once.
                </p>
                <div class="h-pager" data-review-pager>
                  <button type="button" data-review-step="-1">‹ Previous</button>
                  <span role="status" data-review-page></span>
                  <button type="button" data-review-step="1">Next ›</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      )
    }
    {
      home && (
        <div class="h-row">
          <section class="h-block" aria-labelledby="today-title">
            <div class="h-board" data-today>
              <div class="h-board-head">
                <h2 id="today-title">Today's exercise</h2>
                <a class="arrow-link" href="/daily/">Past days&nbsp;<span aria-hidden="true">→</span></a>
              </div>
              <ol class="h-week" aria-label="This week" data-week></ol>
              <div class="h-today-main">
                <span class={`badge badge-${todayTask?.level ?? 1}`} data-today-level>{LEVELS[(todayTask?.level ?? 1) as 1 | 2 | 3]}</span>
                <h3 data-today-name>{todayTask?.title}</h3>
                <p data-today-task>{todayTask?.task}</p>
              </div>
              <div class="h-today-foot">
                <a class="button button-primary" href="/daily/">Solve today's exercise</a>
              </div>
            </div>
          </section>

          <section class="h-block" aria-labelledby="practise-title">
            <div class="h-board h-practise">
              <div class="h-board-head">
                <h2 id="practise-title">Practise</h2>
              </div>
              <a class="h-way h-way-lead" href={exercisesWay.href}>
                <span class="h-chip"><Icon name={exercisesWay.icon} size={20} /></span>
                <span class="h-way-text">
                  <span class="h-way-name">{exercisesWay.label}</span>
                  <span class="h-way-line"><span data-stat="practise-solved">0</span> of {placed.length} solved</span>
                  <span class="progress-bar" aria-hidden="true"><span data-practise-bar></span></span>
                </span>
                <span class="h-way-go" aria-hidden="true">›</span>
              </a>
              <ul class="h-ways">
                {
                  tiles.map((item) => (
                    <li data-tone={item.tone}>
                      <a class="h-way" href={item.href}>
                        <span class="h-chip"><Icon name={item.icon} size={20} /></span>
                        <span class="h-way-text">
                          <span class="h-way-name">{item.label}</span>
                          <span class="h-way-line">{item.line}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>
        </div>
      )
    }
    {!home && (
    <section class="p-section" aria-labelledby="review-title">
      <div class="p-section-head">
        <div>
          <h2 id="review-title">
            Due for review <span class="p-due"><span class="visually-hidden">, </span><span
                data-stat="due">0</span
              ></span>
          </h2>
          <p class="p-sub">Exercises you got wrong, and solved ones due again.</p>
        </div>
      </div>
      <p class="card review-empty" data-review-empty>
        Nothing to review. Exercises you got wrong, and solved ones due again, come back here.
      </p>
      <div class="review-layout" data-review hidden>
        <div class="review-main">
          <div class="r-table-wrap">
            <table aria-labelledby="review-title" data-review-table>
              <thead>
                <tr>
                  <th scope="col" class="col-why" data-sort-key="state">
                    <button type="button" class="sort">Why<span class="sort-mark" aria-hidden="true"></span></button>
                  </th>
                  <th scope="col" data-sort-key="title">
                    <button type="button" class="sort">Title<span class="sort-mark" aria-hidden="true"></span></button>
                  </th>
                  <th scope="col" class="col-level" data-sort-key="level">
                    <button type="button" class="sort">Difficulty<span class="sort-mark" aria-hidden="true"></span></button>
                  </th>
                </tr>
              </thead>
              <tbody data-review-rows></tbody>
            </table>
          </div>
          <p class="r-more" data-review-more-wrap hidden>
            <button class="button button-secondary" type="button" data-review-more></button>
          </p>
        </div>
        <div class="r-side">
        <form class="card r-filter" role="search" aria-label="Filter the review list" data-review-filter>
          <div class="r-head">
            <h3>Filters</h3>
            <span class="r-active" data-review-active hidden></span>
            <button class="r-reset" type="reset" aria-label="Clear filters" data-review-reset hidden>Reset</button>
          </div>
          <div class="r-search">
            <Icon name="lookup" size={16} />
            <label class="visually-hidden" for="r-q">Find an exercise</label>
            <input id="r-q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search title or function" />
          </div>
          <div class="r-field">
            <label for="r-why">Why it is due</label>
            <div class="r-select">
              <select id="r-why" name="why">
                <option value="">All</option>
                <option value="unsolved">Not solved yet</option>
                <option value="missed">Wrong on your last try</option>
                <option value="due">Due for review</option>
              </select>
              <Icon name="chevron-down" size={16} />
            </div>
          </div>
          <div class="r-field">
            <label for="r-level">Difficulty</label>
            <div class="r-select">
              <select id="r-level" name="level">
                <option value="">All</option>
                {Object.entries(LEVELS).map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
              <Icon name="chevron-down" size={16} />
            </div>
          </div>
          <div class="r-field">
            <label for="r-track">Track</label>
            <div class="r-select">
              <select id="r-track" name="track" data-review-tracks>
                <option value="">All</option>
              </select>
              <Icon name="chevron-down" size={16} />
            </div>
          </div>
          <p class="r-count" role="status" data-review-count></p>
        </form>
        </div>
      </div>
    </section>
    )}

    {!home && (
    <>
    <section class="clear" aria-labelledby="clear-head" data-clear>
      <div class="clear-text">
        <h2 id="clear-head">Start over</h2>
        <p>
          Clears every solve, review and practice result
          <span data-when="out">saved in this browser.</span>
          <span data-when="in" hidden>from your account, on every device.</span>
        </p>
      </div>
      <button class="button button-secondary clear-ask" type="button" data-clear-ask>
        <Icon name="reset" size={16} />
        Clear my progress
      </button>
      <p class="clear-status" role="status" data-clear-status></p>
    </section>

    <dialog
      class="clear-dialog"
      aria-labelledby="clear-title"
      aria-describedby="clear-desc"
      closedby="any"
      data-clear-dialog
    >
      <h2 id="clear-title">
        <span class="warn-badge" aria-hidden="true"><Icon name="warn" size={22} /></span>
        Clear all your progress?
      </h2>
      <p id="clear-desc">
        This removes every solve, review and practice result from
        <span data-when="out">this browser.</span>
        <span data-when="in" hidden>your account, on every device you use.</span>
        It cannot be undone.
      </p>
      <p class="clear-error" role="alert" data-clear-error></p>
      <div class="clear-dialog-actions">
        <button class="button button-secondary" type="button" autofocus data-clear-no>Keep it</button>
        <button class="button button-danger" type="button" data-clear-yes>Yes, clear it</button>
      </div>
    </dialog>
    </>
    )}

    <script type="application/json" data-exercises set:html={JSON.stringify(list).replaceAll("<", "\\u003c")} />
    <script type="application/json" data-drill-items set:html={JSON.stringify(drills).replaceAll("<", "\\u003c")} />
    {home && <script type="application/json" data-daily-pool set:html={json(dailyPool)} />}
    {home && <script type="application/json" data-daily-info set:html={json(dailyInfo)} />}
  </div>
<script>
  import "../scripts/catalogue.ts";
  import "../scripts/progress-page.ts";
</script>

<style>
  /* The table is wider than a phone: it scrolls inside its card, not the page. */
  .a-page {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  /* This grid gap is space-6, one step more than the other practice pages. */
  .open-head {
    margin-bottom: calc(var(--space-5) - var(--space-6));
  }
  /* In the account area the shell has the title: the actions sit left, no top band. */
  .embedded .open-head {
    max-width: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }
  .embedded .open-head .actions {
    justify-content: flex-start;
    margin: 0;
  }
  /* The grid of days practised beside three number cards; stacked on phones. */
  .p-activity {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 64rem) {
    .p-activity {
      grid-template-columns: minmax(0, 1fr) 17.5rem;
    }
  }
  .p-heat {
    position: relative;
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-5);
  }
  .p-heat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .p-heat-head h2 {
    margin: 0;
    font-size: var(--size-l);
    color: var(--heading);
  }
  /* Weeks are columns, Monday to Sunday down each one. */
  .heat,
  .heat-months {
    display: grid;
    grid-template-columns: repeat(26, minmax(0, 1fr));
    gap: 3px;
  }
  .heat {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
  }
  .heat-months {
    font-size: var(--size-xs);
    color: var(--faint);
    white-space: nowrap;
  }
  .heat :global(i),
  .heat-legend i {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--header);  }
  .heat :global(i[data-tip]):hover {
    position: relative;
    z-index: 1;
    transform: scale(1.12);
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3.5px var(--primary),
      0 4px 10px rgb(0 0 0 / 0.2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .heat :global(i) {
      transition:
        transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 160ms ease-out;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .heat :global(i[data-tip]):hover {
      transform: none;
    }
  }
  .heat :global(i.future) {
    background: transparent;
  }
  .heat :global(i.l1),
  .heat-legend .l1 {
    background: color-mix(in srgb, var(--primary) 25%, var(--surface));
  }
  .heat :global(i.l2),
  .heat-legend .l2 {
    background: color-mix(in srgb, var(--primary) 50%, var(--surface));
  }
  .heat :global(i.l3),
  .heat-legend .l3 {
    background: color-mix(in srgb, var(--primary) 75%, var(--surface));
  }
  .heat :global(i.l4),
  .heat-legend .l4 {
    background: var(--primary);
  }
  .heat-legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 3px;
    margin: var(--space-1) 0 0;
    font-size: var(--size-xs);
    color: var(--faint);
  }
  .heat-legend i {
    width: 0.75rem;
  }
  .p-nums {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .p-nums > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    padding: var(--space-4);
  }
  .p-nums dt {
    font-size: var(--size-s);
    color: var(--muted);
  }
  .p-nums dd {
    margin: 0;
    font-size: var(--size-xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--heading);
  }
  .p-due {
    display: inline-block;
    min-width: 1.75rem;
    margin-left: var(--space-1);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--header);
    font-size: var(--size-s);
    text-align: center;
    vertical-align: middle;
    color: var(--muted);
  }
  /* The card already draws the frame. */
  .list-head .count {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .review-empty {
    max-width: 48rem;
    margin: 0;
    color: var(--muted);
  }
  /* Review cards are built by progress-page.ts, so these rules are global. */
  /* The due list as the catalogue's table, with its filter panel beside it.
     Rows are built by progress-page.ts, so their styles are global here. */
  .review-layout {
    display: grid;
    gap: var(--space-5);
  }
  .review-main {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    /* The table and the filter card share row 1; the "show more" button sits in
       row 2 under the table only. */
    .review-layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      column-gap: var(--space-5);
      row-gap: 0;
    }
    .review-main {
      display: contents;
    }
    .r-table-wrap {
      grid-column: 1;
      grid-row: 1;
    }
    .r-more {
      grid-column: 1;
      grid-row: 2;
    }
    /* The filter keeps its own height and follows the scroll until the table ends
       (its grid area is row 1, so it stops there). */
    .r-side {
      grid-column: 2;
      grid-row: 1;
    }
    /* Sticky is bounded by its parent, so the wrapper (row 1 only) stops it at the table's end, above the button. */
    .r-filter {
      position: sticky;
      top: 4.5rem;
    }
  }
  .r-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .r-table-wrap table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-s);
  }
  .r-table-wrap :global(th),
  .r-table-wrap :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: middle;
  }
  .r-table-wrap :global(tbody tr:last-child > *) {
    border-bottom: 0;
  }
  .r-table-wrap thead th {
    background: var(--bg);
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .col-why {
    width: 15rem;
  }
  .col-level {
    width: 8rem;
  }
  .sort {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .sort:hover {
    color: var(--text);
  }
  .sort-mark::after {
    content: "↕";
    opacity: 0.5;
  }
  th[aria-sort="ascending"] .sort-mark::after {
    content: "↑";
    opacity: 1;
  }
  th[aria-sort="descending"] .sort-mark::after {
    content: "↓";
    opacity: 1;
  }
  .r-table-wrap :global(tbody th) {
    font-weight: 400;
  }
  .r-table-wrap :global(tbody tr:hover) {
    background: var(--bg);
  }
  .r-table-wrap :global(.r-title) {
    font-weight: 600;
    text-decoration: none;
  }
  .r-table-wrap :global(.r-title:hover) {
    color: var(--correct);
    text-decoration: underline;
  }
  /* The whole row opens the exercise, not only the title text. The click still
     lands on the link, so it starts the review run as before. */
  .r-table-wrap :global(tbody tr) {
    position: relative;
  }
  .r-table-wrap :global(.r-title::after) {
    content: "";
    position: absolute;
    inset: 0;
  }
  .r-table-wrap :global(tbody tr:hover .r-title) {
    color: var(--correct);
  }
  .r-table-wrap :global(.r-meta) {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--size-xs);
    color: var(--faint);
  }
  .r-table-wrap :global(.why) {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    /* Not a full pill: on a phone the text may wrap to a second line. */
    border-radius: 0.875rem;
    background: var(--read-tint);
    color: var(--read);
    font-size: var(--size-xs);
    font-weight: 700;
    line-height: 1.5;
  }
  /* Fixed columns keep the title wide and the meta line is cut to one line, so
     rows stay short beside the filter card. */
  @media (min-width: 48rem) {
    .r-table-wrap table {
      table-layout: fixed;
    }
    .col-why {
      width: 9rem;
    }
    .col-level {
      width: 8.5rem;
    }
    .r-table-wrap :global(.why) {
      white-space: nowrap;
    }
    .r-table-wrap :global(.r-meta) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
  .r-table-wrap :global(.why[data-why="unsolved"]),
  .r-table-wrap :global(.why[data-why="missed"]) {
    background: var(--miss-tint);
    color: var(--miss);
  }
  .r-table-wrap :global(.why-note) {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--size-xs);
    color: var(--muted);
  }
  .r-table-wrap :global(tr[hidden]) {
    display: none;
  }
  .r-more {
    margin: var(--space-3) 0 0;
  }
  .r-filter {
    display: grid;
    gap: var(--space-4);
  }
  .r-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .r-head h3 {
    flex: 1;
    margin: 0;
    font-size: var(--size-l);
    color: var(--heading);
  }
  .r-active {
    padding: 2px var(--space-2);
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-size: var(--size-xs);
    font-weight: 600;
  }
  .r-reset {
    padding: 0;
    border: 0;
    background: none;
    color: var(--correct);
    font-size: var(--size-s);
    font-weight: 600;
    cursor: pointer;
  }
  .r-reset:hover {
    text-decoration: underline;
  }
  .r-active[hidden],
  .r-reset[hidden] {
    display: none;
  }
  .r-search,
  .r-select {
    position: relative;
  }
  .r-search :global(.icon),
  .r-select :global(.icon) {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }
  .r-search :global(.icon) {
    left: var(--space-3);
  }
  .r-select :global(.icon) {
    right: var(--space-3);
  }
  .r-field {
    display: grid;
    gap: 6px;
  }
  .r-filter label {
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
  }
  .r-filter input,
  .r-filter select {
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: 10px;
    background-color: var(--surface);
    font-size: var(--size-s);
  }
  .r-filter input {
    padding-left: 2.25rem;
  }
  .r-filter select {
    background-image: none;
    padding-right: 2.25rem;
  }
  .r-count {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--size-s);
    color: var(--muted);
  }
  /* Clearing is rare and cannot be undone: a quiet card at the end, and a
     dialog that asks before anything goes. */
  .clear {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-l);
    text-align: center;
  }
  .clear h2,
  .clear-dialog h2 {
    margin: 0;
    font-size: var(--size-base);
    color: var(--heading);
  }
  .clear p,
  .clear-dialog p {
    margin: var(--space-1) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .clear-ask {
    color: var(--miss);
  }
  .clear-ask:hover {
    border-color: var(--miss);
    background: var(--miss-tint);
  }
  .clear-status {
    margin: 0;
    font-weight: 600;
  }
  .clear-status:empty,
  .clear-error:empty {
    display: none;
  }
  .clear-dialog {
    width: min(28rem, calc(100vw - 2rem));
    padding: var(--space-6);
    border: 0;
    border-top: 4px solid var(--miss);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
  }
  .clear-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .clear-dialog h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-l);
  }
  .warn-badge {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--miss-tint);
    color: var(--miss);
  }
  .clear-dialog p {
    margin: var(--space-4) 0;
    font-size: var(--size-base);
  }
  .clear-dialog .clear-error {
    font-weight: 600;
    color: var(--miss);
  }
  .clear-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .button-danger {
    background: var(--miss);
    color: var(--surface);
  }
  .button-danger:hover {
    filter: brightness(0.92);
  }
  [data-review][hidden],
  [data-review-empty][hidden],
  [data-review-next][hidden],
  .danger[hidden] {
    display: none;
  }
  .confirm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .confirm[hidden] {
    display: none;
  }

  /* Home: one overview card, then rows of two equal halves. In a row both
     cards end on the same line; each section is a title, a line saying what
     it is, then its card. */
  .h-overview {
    display: grid;
    padding: 0;
    overflow: hidden;
  }
  @media (min-width: 64rem) {
    .h-overview {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
  /* Four equal rows, as on the scoreboard: icon, name over a note, number. */
  .h-kpis {
    display: grid;
    grid-auto-rows: 1fr;
    margin: 0;
    padding: var(--space-1) 1.25rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 64rem) {
    .h-kpis {
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }
  .h-kpis > div {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      "chip name number"
      "chip note number";
    align-content: center;
    align-items: center;
    column-gap: var(--space-3);
    min-height: 4.25rem;
  }
  .h-kpis > div + div {
    border-top: 1px solid var(--rule);
  }
  .h-kpis dd {
    margin: 0;
  }
  .h-kpis .h-chip {
    grid-area: chip;
  }
  /* The round icon marks of the numbers and the Practise card. */
  .h-chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--correct-tint);
    color: var(--correct);
  }
  [data-tone="yellow"] .h-chip {
    background: var(--intermediate-bg);
    color: var(--intermediate);
  }
  [data-tone="blue"] .h-chip {
    background: var(--read-tint);
    color: var(--read);
  }
  [data-tone="mint"] .h-chip {
    background: var(--chip-bg);
    color: var(--chip);
  }
  [data-tone="violet"] .h-chip {
    background: var(--pro-bg);
    color: var(--pro);
  }
  [data-tone="red"] .h-chip {
    background: var(--advanced-bg);
    color: var(--advanced);
  }
  .h-kpis dt {
    grid-area: name;
    font-size: var(--size-s);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .h-kpis .h-n {
    grid-area: number;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }
  .h-kpis .h-note {
    grid-area: note;
    font-size: var(--size-xs);
    line-height: var(--leading-tight);
    color: var(--faint);
  }
  .h-row {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 64rem) {
    .h-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .h-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* Two equal halves, and one white pill under the pressed one. */
  .h-seg {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    margin-left: auto;
    padding: 2px;
    border-radius: var(--radius-m);
    background: var(--header);
  }
  .h-seg::before {
    content: "";
    position: absolute;
    inset: 2px auto 2px 2px;
    width: calc(50% - 3px);
    border-radius: calc(var(--radius-m) - 2px);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .h-seg:has(button:last-child[aria-pressed="true"])::before {
    transform: translateX(calc(100% + 2px));
  }
  .h-seg button {
    position: relative; /* above the pill */
    min-height: 2rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: calc(var(--radius-m) - 2px);
    background: none;
    font: 500 var(--size-s) var(--font-text);
    color: var(--muted);
    cursor: pointer;
  }
  .h-seg button[aria-pressed="true"] {
    font-weight: 600;
    color: var(--heading);
  }
  @media (prefers-reduced-motion: no-preference) {
    .h-seg::before {
      transition: transform var(--duration) var(--ease);
    }
    .h-seg button {
      transition: color var(--duration) var(--ease);
    }
  }
  .h-note {
    justify-content: flex-start;
    color: var(--muted);
  }
  .h-note :global(a) {
    font-weight: 600;
    color: var(--correct);
  }
  /* The card fills the row's height, so both halves end together. */
  .h-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin: auto 0 0;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--rule);
    background: var(--bg);
    font-size: var(--size-xs);
    color: var(--faint);
  }
  .h-foot[hidden] {
    display: none;
  }
  /* A sentence with a link in it, not a row of items. */
  .h-foot.h-note:not([hidden]) {
    display: block;
  }
  /* The scoreboard and the review list: two cards of one height. */
  .h-board {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .h-board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    /* One header height, whatever sits beside the title. */
    min-height: 4.5rem;
    padding: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }
  .h-board-head h2 {
    margin: 0;
    font-size: var(--size-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--heading);
  }
  .h-ranks {
    width: calc(100% - 2 * var(--space-2));
    margin: var(--space-2);
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }
  .h-ranks thead th {
    padding: 0;
  }
  .h-ranks tbody > :global(tr > *) {
    padding: var(--space-2);
    border-block: 1px solid transparent;
    text-align: left;
    vertical-align: middle;
  }
  .h-ranks tbody > :global(tr > :first-child) {
    border-left: 1px solid transparent;
    border-radius: var(--radius-m) 0 0 var(--radius-m);
  }
  .h-ranks tbody > :global(tr > :last-child) {
    border-right: 1px solid transparent;
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
  }
  .h-ranks tbody > :global(tr.h-you > *) {
    border-color: var(--correct);
    background: var(--correct-tint);
  }
  /* Below the list: a break, then the learner's row in solid green. */
  .h-ranks .h-gap td {
    padding: 0;
    font-size: var(--size-l);
    line-height: var(--leading-tight);
    text-align: center;
    color: var(--muted);
  }
  .h-ranks [data-board-me] .h-you > * {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }
  [data-board-me] .h-you :is(.h-medal, .h-meta, small) {
    color: var(--on-primary);
  }
  [data-board-me] .h-you .h-ava {
    background: var(--on-primary);
    color: var(--primary);
  }
  .h-rank {
    width: 3rem;
  }
  .h-pts {
    width: 5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .h-ranks .h-pts {
    text-align: right;
  }
  .h-pts small {
    font-size: var(--size-xs);
    font-weight: 400;
    color: var(--muted);
  }
  .h-medal {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-size: var(--size-s);
    font-weight: 700;
    color: var(--muted);
  }
  .h-medal[data-rank="1"] {
    background: var(--gold-bg);
    color: var(--gold);
  }
  .h-medal[data-rank="2"] {
    background: var(--silver-bg);
    color: var(--silver);
  }
  .h-medal[data-rank="3"] {
    background: var(--bronze-bg);
    color: var(--bronze);
  }
  .h-who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .h-ava {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--header);
    font-size: var(--size-s);
    font-weight: 700;
    color: var(--heading);
  }
  .h-you .h-ava {
    background: var(--primary);
    color: var(--on-primary);
  }
  .h-me {
    display: grid;
    min-width: 0;
    line-height: var(--leading-tight);
  }
  .h-name {
    overflow: hidden;
    font-size: var(--size-m);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .h-meta {
    font-size: var(--size-xs);
    font-weight: 400;
    color: var(--muted);
  }
  .h-empty[hidden],
  .h-due[hidden] {
    display: none;
  }
  .h-due-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* Five equal rows, filled or not, so turning a page never moves the card. */
  .h-due {
    flex: 1;
    display: grid;
    grid-template-rows: repeat(5, minmax(3.375rem, 1fr));
    margin: 0;
    padding: var(--space-2);
    list-style: none;
  }
  .h-due :global(li) {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-2);
    border-radius: var(--radius-m);
  }
  .h-due :global(li:hover) {
    background: var(--bg);
  }
  .h-due :global(.why) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--miss-tint);
    font-weight: 700;
    color: var(--miss);
  }
  .h-due :global(.why::before) {
    content: "!";
  }
  .h-due :global(.why[data-why="due"]) {
    background: var(--read-tint);
    color: var(--read);
  }
  .h-due :global(.why[data-why="due"]::before) {
    content: "↻";
  }
  .h-due :global(.r-who) {
    display: grid;
    min-width: 0;
    line-height: var(--leading-tight);
  }
  .h-due :global(.r-title),
  .h-due :global(.r-meta) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .h-due :global(.r-title) {
    font-size: var(--size-m);
    font-weight: 600;
    text-decoration: none;
  }
  /* The whole row opens the exercise; the click still lands on the link. */
  .h-due :global(.r-title::after) {
    content: "";
    position: absolute;
    inset: 0;
