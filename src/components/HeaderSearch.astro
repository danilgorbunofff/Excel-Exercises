---
// Why this exists: the search box in the header, a pill. Without script it is
// a plain GET form to the search page. With script it suggests matches as you
// type. In the wide header (`wide`) it also shows the "/" shortcut and a
// button that opens the large search window with filters.
import Icon from "./Icon.astro";

interface Props {
  id?: string;
  wide?: boolean;
}
const { id = "site-search", wide = false } = Astro.props;
---
<div class="search-row">
  <form class="header-search" action="/search/" method="get" role="search" data-search>
    <label class="visually-hidden" for={id}>Search the site</label>
    <svg class="icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      id={id}
      name="q"
      type="search"
      placeholder="Search exercises and functions"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      aria-autocomplete="list"
      data-search-input
    />
    {wide && <kbd class="slash" aria-hidden="true">/</kbd>}
    <ul class="suggestions" id={`${id}-list`} role="listbox" aria-label="Suggestions" hidden data-search-list>
    </ul>
  </form>
  {
    wide && (
      <button
        class="expand"
        type="button"
        commandfor="search-dialog"
        command="show-modal"
        data-search-expand
      >
        <Icon name="expand" size={20} />
        <span class="visually-hidden">Open large search</span>
      </button>
    )
  }
</div>
<script>
  import "../scripts/search.ts";
</script>
<style>
  .search-row {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2);
    max-width: 30rem;
  }
  .header-search {
    position: relative;
    flex: 1;
  }
  .icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    translate: 0 -50%;
    color: var(--faint);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: var(--target);
    padding: 0 2.75rem 0 2.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--header);
    font-size: var(--size-s);
  }
  @media (prefers-reduced-motion: no-preference) {
    input,
    .expand {
      transition:
        background-color var(--duration) var(--ease),
        border-color var(--duration) var(--ease);
    }
  }
  input:hover,
  input:focus {
    border-color: var(--line);
    background: var(--surface);
  }
  input::placeholder {
    color: var(--faint);
  }
  /* The "/" key focuses the box; the hint goes once you are typing. */
  .slash {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    translate: 0 -50%;
    padding: 0 var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--size-xs);
    line-height: 1.25rem;
    pointer-events: none;
  }
  input:focus ~ .slash,
  input:not(:placeholder-shown) ~ .slash {
    display: none;
  }
  .expand {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--header);
    color: var(--muted);
    cursor: pointer;
  }
  .expand:hover {
    border-color: var(--line);
    background: var(--surface);
    color: var(--text);
  }
  .suggestions {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
  }
  .suggestions[hidden] {
    display: none;
  }
  .suggestions :global(li) {
    border-radius: var(--radius-s);
  }
  .suggestions :global(a) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    font-size: var(--size-s);
    text-decoration: none;
  }
  .suggestions :global(li[aria-selected="true"]),
  .suggestions :global(li:hover) {
    background: var(--header);
  }
  .suggestions :global(.kind) {
    color: var(--muted);
    font-size: var(--size-xs);
  }
  .suggestions :global(.empty) {
    padding: var(--space-2) var(--space-3);
    color: var(--muted);
    font-size: var(--size-s);
  }
</style>
