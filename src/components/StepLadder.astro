---
// Why this exists: every track exercise is one step of a five-step ladder on
// the same theme, easiest to hardest. This row links all five, marks the one
// open, and ticks those solved in this browser. Solving any one of them counts
// as solving the exercise, so the row is a choice, not a list to finish.
import type { Rung } from "../lib/steps.ts";

interface Props {
  ladder: readonly Rung[];
  /** The id of the task on this page. */
  current: string;
}
const { ladder, current } = Astro.props;
---

<nav class="ladder" aria-label="Same task, easier to harder" data-ladder>
  <span class="end" aria-hidden="true">Easier</span>
  <ol>
    {
      ladder.map((r) => (
        <li>
          <a
            href={r.href}
            aria-current={r.id === current ? "step" : undefined}
            data-rung={r.id}
          >
            {r.step}
            <span class="visually-hidden" data-rung-state />
          </a>
        </li>
      ))
    }
  </ol>
  <span class="end" aria-hidden="true">Harder</span>
</nav>

<script>
  import { isSolved, PROGRESS_EVENT, readProgress } from "../scripts/progress.ts";

  function paint(): void {
    const progress = readProgress();
    for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-rung]")) {
      const solved = isSolved(progress[a.dataset["rung"] ?? ""]);
      a.classList.toggle("solved", solved);
      const state = a.querySelector("[data-rung-state]");
      if (state) state.textContent = solved ? " (solved)" : "";
    }
  }
  paint();
  document.addEventListener(PROGRESS_EVENT, paint);
</script>

<style>
  .ladder {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--size-s);
    color: var(--muted);
  }
  ol {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    background: var(--header);
  }
  a[aria-current="step"] {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }
  a.solved:not([aria-current="step"]) {
    border-color: var(--correct);
    background: var(--correct-tint);
    color: var(--correct);
  }
</style>
