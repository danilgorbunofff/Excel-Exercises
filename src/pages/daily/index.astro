---
// Why this exists: one free exercise a day, the same for everyone on the same
// date, and a personal streak of days solved. The week is a ladder: Monday's
// task is the easiest and Sunday's the hardest. The date is the visitor's own,
// so daily.ts picks the exercise in the browser and fetches its workbench
// from /daily/task/. The build day's pick is rendered here, hidden: it brings
// the workbench styles and saves a fetch on the day it matches.
import Icon from "../../components/Icon.astro";
import LiveExercise from "../../components/LiveExercise.astro";
import PracticeTabs from "../../components/PracticeTabs.astro";
import Base from "../../layouts/Base.astro";
import { ladderPool, pickFor } from "../../lib/daily.ts";
import { dailyTasks } from "../../lib/exercises.ts";
import "../../styles/assessments.css";
import "../../styles/daily.css";

const tasks = await dailyTasks();
const pool = ladderPool(tasks.map((t) => ({ ...t.exercise, tier: t.tier })));
const buildDay = new Date().toISOString().slice(0, 10);
const buildPick = pickFor(buildDay, pool);
const shown = tasks.find((t) => t.exercise.id === buildPick?.id) ?? tasks[0];
if (!shown) throw new Error("content/daily/ has no tasks.");
const poolJson = JSON.stringify(pool).replaceAll("<", "\\u003c");
// Names each day in the calendar's hover bubble.
const titlesJson = JSON.stringify(
  Object.fromEntries(tasks.map((t) => [t.exercise.id, t.exercise.title])),
).replaceAll("<", "\\u003c");
---

<Base
  title="Daily exercise"
  description="One free Excel exercise a day, from an easy one on Monday to the hardest on Sunday. Solve it on a real grid and keep a streak of days in a row."
  layout="wide"
>
  <PracticeTabs />
  <div class="a-page daily" data-daily>
    <script type="application/json" data-daily-pool set:html={poolJson} />
    <script type="application/json" data-daily-titles set:html={titlesJson} />
    <template data-check-icon><Icon name="check" size={16} /></template>

    <header class="open-head">
      <h1 id="daily-title">Daily exercise</h1>
      <p class="lead">
        A new exercise every day
      </p>
    </header>

    <div class="d-grid">
      <!-- First in the page order, so Tab reaches the calendar before the sheet. -->
      <section class="card d-cal" aria-labelledby="month-title">
        <div class="d-cal-head">
          <h2 id="month-title" data-month-title>This month</h2>
          <button class="d-nav" type="button" data-month-prev>
            <span class="visually-hidden">Previous month</span>
            <Icon name="arrow" size={16} />
          </button>
          <button class="d-nav" type="button" data-month-next>
            <span class="visually-hidden">Next month</span>
            <Icon name="arrow" size={16} />
          </button>
        </div>
        <div class="d-dow" aria-hidden="true">
          <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span
            >Su</span
          >
        </div>
        <ol class="d-month" aria-labelledby="month-title" data-month></ol>
        <div class="hover-tip" aria-hidden="true"><strong></strong><span></span></div>
        <dl class="d-cal-stats">
          <div><dt>Streak</dt><dd data-current>0 days</dd></div>
          <div><dt>Best</dt><dd data-best>0 days</dd></div>
          <div><dt>This month</dt><dd data-month-solved>0</dd></div>
        </dl>
      </section>
      <div class="d-main">
        <div class="d-task" data-task-slot hidden>
          <LiveExercise placed={shown} heading="Today's exercise" defer daily />
        </div>
        <noscript>
          <p class="ruled d-noscript">
            The daily exercise is picked from your date, so it needs JavaScript. Every exercise also
            works on its own page: <a href="/exercises/">see all exercises</a>.
          </p>
        </noscript>
        <p class="ruled d-noscript" role="alert" data-task-error hidden>
          The exercise did not load. Reload the page, or <a href="/exercises/">pick one from the list</a>.
        </p>
      </div>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/daily.ts";
</script>
