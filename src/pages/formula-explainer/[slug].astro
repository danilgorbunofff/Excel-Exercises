---
// Why this exists: one formula walkthrough in the explainer.
import ExplainerPage from "../../components/ExplainerPage.astro";
import type { Walkthrough } from "../../content/schema.ts";
import Base from "../../layouts/Base.astro";
import { loadExplainers } from "../../lib/explainers.ts";

export function getStaticPaths() {
  return loadExplainers().walkthroughs.map((walkthrough) => ({
    params: { slug: walkthrough.slug },
    props: { walkthrough },
  }));
}

interface Props {
  walkthrough: Walkthrough;
}
const { walkthrough } = Astro.props;
---

<Base
  title={`${walkthrough.title}, explained`}
  description={`${walkthrough.description} See each part of the formula worked out on example data.`}
  section="/formula-explainer/"
  layout="wide"
>
  <ExplainerPage walkthrough={walkthrough} />
</Base>
