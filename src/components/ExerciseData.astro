---
// Why this exists: hands an exercise's grading data to the exercise script.
// It sits inside the element marked data-exercise that it belongs to.
import { type ExerciseEntry, exerciseData } from "../lib/exercises.ts";

interface Props {
  exercise: ExerciseEntry["data"];
  /** A PRO exercise: the answers come from /api/exercises/ once the visitor has PRO. */
  locked?: boolean;
}
const { exercise, locked = false } = Astro.props;
const json = JSON.stringify(exerciseData(exercise, !locked)).replaceAll("<", "\\u003c");
---

<script type="application/json" data-exercise-data set:html={json} />

<script>
  import "../scripts/exercise.ts";
</script>
