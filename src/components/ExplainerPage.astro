---
// Why this exists: the body shared by the explainer index and each
// walkthrough: the tool, how it works, how to try your own formula, other
// walkthroughs, an exercise to practise and common mistakes.
import type { Walkthrough } from "../content/schema.ts";
import { exercisePath, LEVELS, placedExercises } from "../lib/exercises.ts";
import { loadExplainers, walkthroughPath } from "../lib/explainers.ts";
import Breadcrumbs from "./Breadcrumbs.astro";
import FormulaExplainer from "./FormulaExplainer.astro";

interface Props {
  walkthrough: Walkthrough;
  /** The index page shows the tool's own title; a walkthrough shows its own. */
  isIndex?: boolean;
}
const { walkthrough, isIndex = false } = Astro.props;
const others = loadExplainers().walkthroughs.filter((w) => isIndex || w.slug !== walkthrough.slug);
const practise = (await placedExercises()).find((p) => p.exercise.id === walkthrough.exercise);
const mainFn = /^=([A-Z]+)\(/u.exec(walkthrough.formula)?.[1] ?? "this";
---

{!isIndex && <Breadcrumbs items={[{ label: "Formula explainer", href: "/formula-explainer/" }]} />}
<header class="head">
  <h1>{isIndex ? "Excel formula explainer" : walkthrough.title}</h1>
  <p class="lead">
    {
      isIndex
        ? "Type or paste a formula. Each part is worked out in turn, on a small sheet you can change."
        : walkthrough.description
    }
  </p>
</header>

<FormulaExplainer walkthrough={walkthrough} />

<section class="block" aria-labelledby="how">
  <h2 id="how">{isIndex ? "What the explainer does" : `How this ${mainFn} formula works`}</h2>
  {
    isIndex ? (
      <>
        <p>
          The explainer reads the formula the way Excel does. It finds each function call and each
          operation, works out its value on the example data, and lists them from the outside in.
        </p>
        <p>
          The innermost parts are worked out first, because the parts around them need their values.
          Edit a cell in the example data and every value updates.
        </p>
      </>
    ) : (
      walkthrough.how.map((h) => <p>{h}</p>)
    )
  }
</section>

<section class="block" aria-labelledby="own">
  <h2 id="own">Use your own formula</h2>
  <p>
    Change the formula in the box and press Explain it, or edit any cell of the example data.
    The explainer runs in your browser and sends nothing anywhere.
  </p>
</section>

<section class="block" aria-labelledby="more">
  <h2 id="more">Worked formulas</h2>
  <ul class="walks">
    {
      others.map((w) => (
        <li>
          <a class="card walk" href={walkthroughPath(w.slug)}>
            <span class="walk-title">{w.title}</span>
            <code>{w.formula}</code>
            <span class="walk-text">{w.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

{
  practise && (
    <section class="block" aria-labelledby="practise">
      <h2 id="practise">Now write one yourself</h2>
      <a class="card walk practise" href={exercisePath(practise.exercise.slug)}>
        <span class="walk-title">
          {practise.exercise.title}{" "}
          <span class={`badge badge-${practise.exercise.level}`}>
            {LEVELS[practise.exercise.level as 1 | 2 | 3]}
          </span>
        </span>
        <span class="walk-text">{practise.exercise.screens[0]?.prompt}</span>
      </a>
    </section>
  )
}

{
  !isIndex && walkthrough.mistakes.length > 0 && (
    <section class="block" aria-labelledby="mistakes">
      <h2 id="mistakes">Common mistakes with {mainFn}</h2>
      {walkthrough.mistakes.map((m) => (
        <details>
          <summary>{m.q}</summary>
          <p>{m.a}</p>
        </details>
      ))}
    </section>
  )
}

<style>
  .head {
    padding: var(--space-5) 0 var(--space-5);
  }
  h1 {
    margin: 0;
    font-size: var(--size-xxl);
    color: var(--heading);
  }
  .lead {
    max-width: 44rem;
    margin: var(--space-3) 0 0;
    font-size: var(--size-l);
    color: var(--muted);
  }
  .block {
    max-width: 56rem;
    margin-top: var(--space-7);
  }
  .block h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .block p {
    color: var(--muted);
  }
  .walks {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .walks li {
    display: grid;
  }
  .walk {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .walk-title {
    font-weight: 600;
    color: var(--heading);
  }
  .walk:hover .walk-title {
    color: var(--correct);
    text-decoration: underline;
  }
  .walk code {
    font-size: var(--size-xs);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .walk-text {
    font-size: var(--size-s);
    color: var(--muted);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--space-2) 0;
    font-weight: 600;
    cursor: pointer;
  }
  details p {
    margin: 0 0 var(--space-4);
  }
  @media (min-width: 48rem) {
    .walks {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
