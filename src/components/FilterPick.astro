---
// Why this exists: one filter chosen from a long list: a button that opens the
// list, with a search over it and a count by each item. The items are radios,
// so the form's value, its reset and the keyboard come with the browser.
// catalogue.ts narrows the list, writes the chosen name and closes it.
import Icon from "./Icon.astro";

interface Props {
  name: string;
  label: string;
  /** What the button says while nothing is chosen. */
  all: string;
  total: number;
  options: readonly { value: string; label: string; count: number }[];
}
const { name, label, all, total, options } = Astro.props;
const items = [{ value: "", label: "All", count: total }, ...options];
---

<div class="group">
  <span class="legend" aria-hidden="true">{label}</span>
  <details class="pick" data-pick data-all={all}>
    <summary>
      <span class="visually-hidden">{label}:</span>
      <span class="value" data-pick-value>{all}</span>
      <Icon name="chevron-down" size={16} />
    </summary>
    <div class="pop">
      <input
        type="search"
        placeholder={`Find a ${label.toLowerCase()}`}
        aria-label={`Find a ${label.toLowerCase()}`}
        autocomplete="off"
        spellcheck="false"
        data-pick-search
      />
      <div role="radiogroup" aria-label={label}>
        <ul>
        {
          items.map((o) => (
            <li>
              <label>
                <input class="visually-hidden" type="radio" name={name} value={o.value} checked={o.value === ""} />
                <Icon name="check" size={16} />
                <span class="text" data-pick-label>{o.label}</span>
                <span class="count">{o.count}</span>
              </label>
            </li>
          ))
        }
      </ul>
      </div>
    </div>
  </details>
</div>

<style>
  .group {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .legend {
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
  }
  .pick {
    position: relative;
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    font-size: var(--size-s);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .pick[open] summary {
    border-color: var(--correct);
  }
  .value {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  summary :global(.icon) {
    flex: none;
    color: var(--muted);
  }
  .pick[open] summary :global(.icon) {
    rotate: 180deg;
  }
  .pop {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    left: 0;
    padding: 6px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-pop);
  }
  input[type="search"] {
    width: 100%;
    min-height: 2.25rem;
    margin-bottom: 6px;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    font-size: var(--size-s);
  }
  ul {
    max-height: 15rem;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }
  li[hidden] {
    display: none;
  }
  label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0.25rem var(--space-2);
    border-radius: 8px;
    font-size: var(--size-s);
    cursor: pointer;
  }
  label:hover {
    background: var(--header);
  }
  label:has(:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
  label :global(.icon) {
    flex: none;
    color: var(--correct);
    visibility: hidden;
  }
  label:has(:checked) {
    font-weight: 700;
  }
  label:has(:checked) :global(.icon) {
    visibility: visible;
  }
  .text {
    flex: 1;
    min-width: 0;
  }
  .count {
    font-size: var(--size-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  @media (prefers-reduced-motion: no-preference) {
    summary :global(.icon) {
      transition: rotate 200ms;
    }
    .pick[open] .pop {
      animation: pick-in 160ms ease-out;
    }
    @keyframes pick-in {
      from {
        opacity: 0;
        translate: 0 -4px;
      }
    }
  }
</style>
