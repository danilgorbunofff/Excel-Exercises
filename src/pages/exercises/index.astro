---
// Why this exists: the catalogue, laid out as on Spreadsheet Center: a
// centred head with a green note, learning track cards, one sortable table of
// every exercise, a start card and filters on the right, and common questions.
// Under the title, this browser's progress: solved, day streak, tracks done.
import ExerciseTable from "../../components/ExerciseTable.astro";
import FilterPick from "../../components/FilterPick.astro";
import Icon from "../../components/Icon.astro";
import LevelBars from "../../components/LevelBars.astro";
import PracticeTabs from "../../components/PracticeTabs.astro";
import StartSheet from "../../components/StartSheet.astro";
import TrackList from "../../components/TrackList.astro";
import Base from "../../layouts/Base.astro";
import {
  exercisePath,
  functionsOf,
  LEVELS,
  placedExercises,
  trackSummaries,
  tracksPath,
} from "../../lib/exercises.ts";

const placed = await placedExercises();
const tracks = trackSummaries(placed);
const total = placed.length;
const functionNames = [...new Set(placed.flatMap((p) => functionsOf(p.exercise)))].sort();
const functionOptions = functionNames.map((name) => ({
  value: name,
  label: name,
  count: placed.filter((p) => functionsOf(p.exercise).includes(name)).length,
}));
const trackOptions = tracks.map((t) => ({
  value: t.topic.slug,
  label: t.topic.title,
  count: t.exercises.length,
}));
const progressChoices = [
  { value: "", label: "All" },
  { value: "todo", label: "Not solved" },
  { value: "done", label: "Solved" },
];
// A tile is narrow, so Intermediate goes by its shorter name there.
const tileLabels = { 1: LEVELS[1], 2: "Medium", 3: LEVELS[3] };
const faq = [
  {
    q: "I am new to Excel. Where do I begin?",
    a: "Start with the first track, Cells and arithmetic. Each exercise adds one idea, and the tracks build on each other in order.",
  },
  {
    q: "Can these exercises help me prepare for a job that uses Excel?",
    a: "Yes. The later tracks cover the conditions and lookups that office, finance and data roles use every day, and the interview tracks practise the tasks that interview tests set.",
  },
  {
    q: "How much time does one exercise need?",
    a: "Most take 5 to 10 minutes. Each asks for one formula, and the hints are there if you get stuck.",
  },
  {
    q: "What if I get stuck?",
    a: "Each exercise has two hints and then the answer. If you solve it after seeing the answer, it counts as solved with help.",
  },
  {
    q: "Which versions of Excel do the formulas work in?",
    a: "The exercises follow Excel for Microsoft 365. XLOOKUP, FILTER, SORT, UNIQUE and LET need Excel 2021 or later. TAKE, CHOOSECOLS, TEXTBEFORE and TEXTAFTER need Excel 2024 or later.",
  },
];
---

<Base
  title="Exercises"
  description={`All ${total} Excel formula exercises, in order from cell references to capstone tasks, with learning tracks and filters.`}
  layout="wide"
>
  <PracticeTabs />
  <header class="page-head">
    <h1>Excel formula exercises</h1>
    <p class="lead">
      Work through {total} short spreadsheet tasks.
    </p>
    <ul class="stats" data-stats>
      <li>
        <Icon name="check" />
        <span><b data-stat-solved>0</b> of {total} solved</span>
      </li>
      <li class="streak">
        <Icon name="flame" />
        <span><b data-stat-streak>0</b> day streak</span>
      </li>
      <li>
        <Icon name="trophy" />
        <span><b data-stat-tracks>0</b> <span data-stat-tracks-word>tracks</span> completed</span>
      </li>
    </ul>
  </header>

  <div class="layout">
    <section aria-labelledby="tracks-heading" class="tracks">
      <div class="tracks-head">
        <div>
          <h2 id="tracks-heading">Learning tracks</h2>
          <p>Each track takes one skill from its first formula to its hardest.</p>
        </div>
        <a class="arrow-link" href={tracksPath}>All tracks&nbsp;<span aria-hidden="true">→</span></a>
      </div>
      <div class="track-grid">
        <TrackList tracks={tracks.slice(0, 4)} labelledby="tracks-heading" catalogue />
      </div>
    </section>

    <div class="all">
      <h2 id="all" class="visually-hidden">All exercises</h2>
      <ExerciseTable rows={placed} labelledby="all" sortable />

      <section class="faq" aria-labelledby="faq">
        <h2 id="faq">Frequently asked questions</h2>
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>
    </div>

    <aside class="side" aria-label="Start and filter">
      {
        placed[0] && (
          <div class="start">
            <StartSheet href={exercisePath(placed[0].exercise.slug)} />
          </div>
        )
      }

      <form class="card filter" role="search" action="/exercises/" method="get" data-filter>
        <div class="head">
          <h2>Filters</h2>
          <span class="active" data-filter-active hidden></span>
          <button class="reset" type="reset" aria-label="Clear filters" data-filter-reset hidden>Reset</button>
        </div>
        <div class="search">
          <Icon name="lookup" size={16} />
          <label class="visually-hidden" for="q">Find an exercise</label>
          <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search title or function" />
        </div>
        <!-- Phones fold the four lists behind this button; catalogue.ts runs it. -->
        <button
          class="button button-secondary more-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="more-filters"
          data-more-toggle
        >
          <Icon name="filter" size={16} />
          <span data-more-label>More filters</span>
        </button>
        <div class="more" id="more-filters">
          <fieldset class="group">
            <legend>Progress</legend>
            <div class="segments">
              {
                progressChoices.map((c) => (
                  <label>
                    <input class="visually-hidden" type="radio" name="progress" value={c.value} checked={c.value === ""} />
                    <span>{c.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="group">
            <legend>Difficulty</legend>
            {/* No "All" tile: pressing the chosen one again clears it. */}
            <div class="tiles">
              {
                ([1, 2, 3] as const).map((level) => (
                  <label class={`tile-${level}`}>
                    <input class="visually-hidden" type="radio" name="level" value={level} />
                    <span>
                      <LevelBars level={level} />
                      {tileLabels[level]}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <FilterPick name="fn" label="Function" all="All functions" total={total} options={functionOptions} />
          <FilterPick name="track" label="Track" all="All tracks" total={total} options={trackOptions} />
        </div>
        <p class="count" role="status" data-filter-count>{total} exercises</p>
        <div class="meter" aria-hidden="true"><span data-filter-meter></span></div>
      </form>
    </aside>
  </div>
</Base>

<script>
  import "../../scripts/catalogue.ts";
</script>

<style>
  .layout {
    display: grid;
    gap: var(--space-6);
    grid-template-areas: "tracks" "side" "all";
  }
  .tracks {
    grid-area: tracks;
    min-width: 0;
  }
  .all {
    grid-area: all;
    min-width: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .stats li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .stats b {
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }
  .stats :global(.icon) {
    color: var(--correct);
  }
  .stats .streak :global(.icon) {
    color: var(--flame);
    fill: var(--flame);
  }
  /* The numbers are this browser's: the room is kept until the script has them. */
  .stats:not(.ready) {
    visibility: hidden;
  }
  .tracks-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .tracks-head h2 {
    margin: 0 0 var(--space-1);
    font-size: var(--size-l);
    color: var(--heading);
  }
  .tracks-head p {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .track-grid :global(.tracks) {
    grid-template-columns: 1fr;
  }
  .side {
    grid-area: side;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .side h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-l);
    color: var(--heading);
  }
  .filter {
    display: grid;
    gap: var(--space-4);
  }
  /* The "1 active" tag is taller than the heading: its room is kept, so
     nothing below moves when it appears. */
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.5rem;
  }
  .head h2 {
    flex: 1;
    margin: 0;
  }
  .active {
    padding: 2px var(--space-2);
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-size: var(--size-xs);
    font-weight: 600;
  }
  .reset {
    padding: 0;
    border: 0;
    background: none;
    color: var(--correct);
    font-size: var(--size-s);
    font-weight: 600;
    cursor: pointer;
  }
  .reset:hover {
    text-decoration: underline;
  }
  .active[hidden],
  .reset[hidden] {
    display: none;
  }
  .search {
    position: relative;
  }
  .search :global(.icon) {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    padding-left: 2.25rem;
  }
  /* The filter needs the script. Its space is kept from the start, so showing
     it moves nothing on the page. */
  .filter:not(.ready) {
    visibility: hidden;
  }
  .count {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--size-s);
    color: var(--muted);
  }
  .search input {
    width: 100%;
    min-height: var(--target);
    padding-right: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-size: var(--size-s);
  }
  .more {
    display: grid;
    gap: var(--space-4);
  }
  .group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: 6px;
    padding: 0;
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
  }
  /* Progress: one switch, with the green block sliding to the chosen part. */
  .segments {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.35fr 1fr;
    padding: 3px;
    border-radius: 12px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .segments::before {
    content: "";
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px) / 3.35);
    border-radius: 9px;
    background: var(--primary);
  }
  .segments:has([value="todo"]:checked)::before {
    left: calc(3px + (100% - 6px) / 3.35);
    width: calc((100% - 6px) * 1.35 / 3.35);
  }
  .segments:has([value="done"]:checked)::before {
    left: calc(3px + (100% - 6px) * 2.35 / 3.35);
  }
  .segments span {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2.25rem;
    border-radius: 9px;
    font-size: var(--size-xs);
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    cursor: pointer;
  }
  .segments :checked + span {
    color: var(--on-primary);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .tiles label {
    display: grid;
  }
  .tiles label > span {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 0.625rem 0 0.5rem;
    border-radius: 12px;
    background: var(--bg);
    font-size: var(--size-xs);
    font-weight: 600;
    cursor: pointer;
  }
  .tile-1 :checked + span {
    background: var(--beginner-bg);
    color: var(--beginner);
  }
  .tile-2 :checked + span {
    background: var(--intermediate-bg);
    color: var(--intermediate);
  }
  .tile-3 :checked + span {
    background: var(--advanced-bg);
    color: var(--advanced);
  }
  .segments :focus-visible + span,
  .tiles :focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .meter {
    height: 4px;
    margin-top: calc(var(--space-3) * -1);
    overflow: hidden;
    border-radius: 999px;
    background: var(--rule);
  }
  .meter span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--correct);
  }
  @media (prefers-reduced-motion: no-preference) {
    .segments::before {
      transition:
        left 250ms cubic-bezier(0.3, 1.2, 0.5, 1),
        width 250ms;
    }
    .tiles label > span {
      transition:
        translate 150ms,
        background-color 150ms;
    }
    .tiles label > span:hover {
      translate: 0 -2px;
    }
    .meter span {
      transition: width 300ms;
    }
  }
  .more-toggle {
    display: none;
    gap: var(--space-2);
  }
  /* Phones: the search stays, the four filters fold behind "More filters", so
     the first exercise is not 600 px down the page. */
  @media (max-width: 47.99rem) {
    .more-toggle {
      display: inline-flex;
    }
    .filter:not(.open) .more {
      display: none;
    }
  }
  /* Tablets in portrait: the lists sit two by two instead of in one tall column. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .more {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-4);
    }
    .more .button {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  .faq h2 {
    margin: 0 0 var(--space-1);
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .faq {
    margin-top: var(--space-7);
  }
  .faq h2 {
    margin-bottom: var(--space-3);
  }
  .faq details {
    border-bottom: 1px solid var(--rule);
  }
  .faq summary {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--space-2) 0;
    font-weight: 600;
    cursor: pointer;
  }
  .faq details p {
    margin: 0 0 var(--space-4);
    color: var(--muted);
  }
  @media (min-width: 40rem) {
    .track-grid :global(.tracks) {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      grid-template-rows: auto 1fr;
      grid-template-areas: "tracks side" "all side";
    }
    /* The aside borrows the page's two rows: the start card is exactly as tall
       as the tracks, and the filter starts level with the table and follows
       the scroll. */
    .side {
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
      row-gap: var(--space-6);
    }
    /* The card fills the row, so it is exactly as tall as the tracks. */
    .start {
      display: grid;
    }
    .filter {
      align-self: start;
      position: sticky;
      top: 5rem;
    }
  }
  @media (max-width: 63.99rem) {
    .start {
      display: none;
    }
  }
</style>
