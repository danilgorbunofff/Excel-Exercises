---
// Why this exists: the Sign up page. The form posts to /api/auth/register/.
import AuthCard from "../../components/AuthCard.astro";
import Base from "../../layouts/Base.astro";
---

<Base title="Sign up" description="Create an account to sync your Excel practice progress across devices." layout="flush">
  <AuthCard title="Create an account" lead="Save your progress to an account and pick up on any device." action="/api/auth/register/" google>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
    <p class="hint">At least 8 characters.</p>
    <label for="password2">Repeat password</label>
    <input id="password2" name="password2" type="password" autocomplete="new-password" minlength="8" required />
    <label class="check"><input type="checkbox" name="terms" required /> <span>I agree to the <a href="/terms/">terms</a> and the <a href="/privacy/">privacy policy</a></span></label>
    <label class="check"><input type="checkbox" name="daily" /> <span>Send me the daily exercise, tips and offers. Unsubscribe in one click.</span></label>
    <button class="button button-primary" type="submit">Sign up</button>
    <p slot="after" class="switch">
      Already have an account? <a href="/login/">Log in</a>
    </p>
  </AuthCard>
</Base>

<style>
  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-weight: 400 !important;
  }
  .hint {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .check input {
    width: 1.25rem !important;
    min-height: 0 !important;
    /* Centres the 20px box on the first 21px text line. */
    margin-top: 0.5px;
  }
</style>
