---
// Why this exists: PRO function practice. Pick one function, several, all of
// them or ten at random, and short tasks play one after another, each
// function from easy to hard. Three panes: the function groups on the left,
// the chosen group's functions with their syntax in the middle, and "Your
// set" with the Start button on the right. drills.ts reads the choice from the
// address and opens the first drill page (/exercises/drills/<slug>/), each in
// the exercise layout; ?done shows the summary of the session.
import Icon, { type IconName } from "../../../components/Icon.astro";
import PracticeTabs from "../../../components/PracticeTabs.astro";
import Base from "../../../layouts/Base.astro";
import { drillTasks, exercisesForFunction } from "../../../lib/exercises.ts";
import { loadFunctionIndex } from "../../../lib/functions.ts";
import "../../../styles/assessments.css";

const drills = await drillTasks();
if (drills.length === 0) throw new Error("content/drills/ has no drills.");
const count = new Map<string, number>();
for (const d of drills) count.set(d.fn, (count.get(d.fn) ?? 0) + 1);
const index = loadFunctionIndex();
const groups = index.groups
  .map((g) => ({
    ...g,
    functions: index.functions.filter((f) => f.group === g.slug && count.has(f.name)),
  }))
  .filter((g) => g.functions.length > 0);
// One line icon per function group, the same set the learning tracks use.
const GROUP_ICONS: Record<string, IconName> = {
  summarise: "sigma",
  count: "count",
  decide: "branch",
  conditional: "filter",
  lookup: "lookup",
  round: "formula",
  rank: "chart",
  text: "text",
  errors: "hint",
  dates: "calendar",
  arrays: "grid",
};
const pool = drills.map((d) => ({
  id: d.exercise.id,
  slug: d.exercise.slug,
  fn: d.fn,
  level: d.exercise.level,
  title: d.exercise.title,
}));
const poolJson = JSON.stringify(pool).replaceAll("<", "\\u003c");
---

<Base
  title="Function practice"
  description={`Short Excel tasks for ${count.size} functions, one after another. Pick one function, several or all of them, from easy to hard.`}
  layout="wide"
>
  <PracticeTabs />
  <div class="a-page practice" data-drills>
    <script type="application/json" data-drill-pool set:html={poolJson} />

    <header class="open-head">
      <h1>Function practice</h1>
      <p class="lead">
        Pick the functions you want to get fast at.
      </p>
    </header>

    <section class="ruled" aria-labelledby="done-title" data-summary hidden>
      <div class="list-head">
        <h2 id="done-title" tabindex="-1">Tasks done</h2>
      </div>
      <div class="a-pad summary">
        <p data-summary-line></p>
        <div data-summary-missed hidden>
          <h3>Practise these again</h3>
          <ul class="missed" data-missed-list></ul>
        </div>
        <p class="summary-actions">
          <a class="button button-primary" href="" data-again>Practise again</a>
          <a class="button button-outline" href="/exercises/drills/">Pick other functions</a>
        </p>
      </div>
    </section>

    <form
      class="picker"
      id="picker"
      method="get"
      action="/exercises/drills/"
      aria-labelledby="pick-title"
      data-picker
    >
      <nav class="groups-nav" aria-labelledby="pick-title">
        <h2 id="pick-title">Choose functions</h2>
        <label class="filter" data-filter-wrap hidden>
          <Icon name="filter" size={16} />
          <span class="visually-hidden">Filter functions</span>
          <input type="search" placeholder="Filter, e.g. LOOKUP" autocomplete="off" data-filter />
        </label>
        <ul class="nav-list" data-group-nav hidden>
          {
            groups.map((g) => (
              <li>
                <button type="button" class="nav-item" aria-pressed="false" data-show-group={g.slug}>
                  <Icon name={GROUP_ICONS[g.slug] ?? "grid"} size={16} />
                  <span class="nav-title">{g.title}</span>
                  <span class="nav-count" data-nav-count>
                    {g.functions.length}
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="board" aria-label="Functions">
        {
          groups.map((g) => (
            <div class="group-pane" role="group" aria-labelledby={`g-${g.slug}`} data-group={g.slug}>
              <div class="group-top">
                <div>
                  <h3 id={`g-${g.slug}`}>{g.title}</h3>
                  <p class="group-meta">
                    {g.summary} {g.functions.length} functions{" "}
                    <span aria-hidden="true">·</span>{" "}
                    {g.functions.reduce((n, f) => n + (count.get(f.name) ?? 0), 0)} tasks.
                  </p>
                </div>
                <span class="picked" data-group-count hidden />
                <button class="link-button toggle" type="button" data-group-toggle hidden>
                  Select all
                </button>
              </div>
              <div class="picks">
                {g.functions.map((f) => (
                  <label class="card pick" data-pick={f.name}>
                    <input class="visually-hidden" type="checkbox" name="fn" value={f.name} />
                    <span class="box" aria-hidden="true">
                      <Icon name="check" size={14} />
                    </span>
                    <span class="pick-text">
                      <span class="pick-name">{f.name}</span>
                      <code class="pick-syntax">{f.syntax}</code>
                    </span>
                    <span class="done" data-done hidden title={`All ${f.name} tasks solved`}>
                      <Icon name="check" size={12} />
                      <span class="visually-hidden">, all solved</span>
                    </span>
                    <span class="pick-tasks">{count.get(f.name)} tasks</span>
                  </label>
                ))}
              </div>
            </div>
          ))
        }
        <p class="no-match" data-no-match hidden>No function matches that. Clear the filter to see them all.</p>
      </section>

      <div class="side-col">
        <aside class="set" aria-labelledby="set-title">
          <div class="set-head">
            <h2 id="set-title">Your set</h2>
            <button class="link-button" type="button" data-clear hidden>Clear</button>
          </div>
          <div class="set-body">
            <p class="set-total">
              <strong data-set-tasks>0</strong>
              <span data-set-unit>tasks</span>
            </p>
            <p class="set-count" data-set-count data-pick-hint>Tick one or more functions.</p>
            <ul class="chips set-chips" data-set-chips hidden></ul>
            <button class="button button-on-primary set-start" type="submit" data-start data-empty>
              Start
            </button>
            <p class="set-note">Each function runs from easy to hard. Skip or finish whenever you like.</p>
          </div>
          <noscript>
            <p class="set-note">
              Practice needs JavaScript. Every exercise also works on its own page, for example
              <a href={exercisesForFunction("SUM")}>the SUM exercises</a>.
            </p>
          </noscript>
        </aside>
        <section class="card quick" aria-labelledby="quick-title">
          <h2 id="quick-title">Not sure what to pick?</h2>
          <p>We mix tasks from all {count.size} functions.</p>
          <button class="button button-outline" type="submit" name="fn" value="random">
            <Icon name="bolt" size={16} /><span data-random-label>10 random tasks</span>
          </button>
          <p class="set-note" data-free-note role="status" hidden></p>
          <button class="button button-secondary" type="submit" name="fn" value="all">
            All {drills.length}, shuffled
          </button>
        </section>
      </div>
    </form>
  </div>
</Base>

<script>
  import "../../../scripts/drills.ts";
</script>

<style>
  .summary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .summary p {
    margin: 0 0 var(--space-3);
  }
  .summary h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-base);
  }
  .missed {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  /* Three panes on wide screens: groups, the chosen group's functions, your set.
     On narrower screens the groups become a scrolling row above the functions. */
  .picker {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .picker {
      grid-template-columns: 15rem minmax(0, 1fr) 17rem;
    }
    .groups-nav {
      position: sticky;
      top: 5rem;
    }
  }
  .groups-nav {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .groups-nav h2 {
    margin: 0;
    font-size: var(--size-l);
    color: var(--heading);
  }
  .filter {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--muted);
  }
  .filter:focus-within {
    border-color: var(--primary);
  }
  .filter input {
    flex: 1;
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--size-s);
    outline: none;
  }
  .nav-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 63.99rem) {
    .nav-list {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      padding-bottom: var(--space-1);
    }
    .nav-item {
      white-space: nowrap;
      border: 1px solid var(--rule);
    }
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--size-s);
    text-align: left;
    cursor: pointer;
  }
  .nav-item:hover {
    background: var(--header);
  }
  .nav-item[aria-pressed="true"] {
    background: var(--chip-bg);
    color: var(--chip);
    font-weight: 700;
  }
  .nav-item :global(svg) {
    flex: none;
    color: var(--muted);
  }
  .nav-item[aria-pressed="true"] :global(svg) {
    color: var(--chip);
  }
  .nav-title {
    flex: 1;
  }
  /* A fixed box, so the number stays put when it turns into the green badge. */
  .nav-count {
    display: grid;
    flex: none;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.25rem;
    border-radius: var(--radius-pill);
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--faint);
  }
  .nav-count.has-picks {
    background: var(--primary);
    color: var(--on-primary);
  }
  .board {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }
  .group-pane {
    display: grid;
    gap: var(--space-3);
  }
  .group-top {
    display: flex;
    align-items: start;
    gap: var(--space-3);
  }
  .group-top > div {
    flex: 1;
  }
  .group-pane h3 {
    margin: 0;
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .group-meta {
    margin: var(--space-1) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .picked {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--chip-line);
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    color: var(--chip);
    font-size: var(--size-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .toggle {
    min-height: 1.5rem;
    font-size: var(--size-s);
    font-weight: 600;
    white-space: nowrap;
    color: var(--correct);
  }
  .toggle:hover {
    text-decoration: underline;
  }
  .picks {
    display: grid;
    gap: var(--space-2);
  }
  /* A function: a row with a tick box, its name and syntax. The real box is
     hidden but still takes the focus and the clicks through its label. */
  .pick {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    user-select: none;
  }
  .pick:hover {
    border-color: var(--muted);
  }
  .pick:has(input:checked) {
    border-color: var(--primary);
    box-shadow: inset 3px 0 var(--primary);
  }
  .pick:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .box {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--line);
    border-radius: var(--radius-s);
    color: transparent;
  }
  .pick:has(input:checked) .box {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }
  .pick-text {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .pick-name {
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .pick-syntax {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }
  .pick-tasks {
    flex: none;
    font-size: var(--size-xs);
    color: var(--faint);
  }
  .done {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--correct-tint);
    color: var(--correct);
  }
  .pick[hidden],
  .group-pane[hidden],
  .picked[hidden],
  .done[hidden],
  .no-match[hidden],
  .filter[hidden],
  .nav-list[hidden] {
    display: none;
  }
  .no-match {
    margin: 0;
    padding: var(--space-5) 0;
    color: var(--muted);
  }

  /* Your set: a green panel beside the board, like the learning tracks
     summary; on phones a bar that stays at the bottom of the screen. */
  .side-col {
    display: grid;
    gap: var(--space-4);
  }
  .set {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--primary);
    color: var(--on-primary);
  }
  .set-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .set-head h2 {
    margin: 0;
    font-size: var(--size-base);
    color: var(--on-primary);
  }
  .set-head .link-button {
    min-height: 1.5rem;
    font-size: var(--size-s);
    color: var(--on-primary);
  }
  .set-body {
    display: grid;
    gap: var(--space-3);
  }
  .set p {
    margin: 0;
  }
  .set a {
    color: var(--on-primary);
  }
  .set-total {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .set-total strong {
    font-size: var(--size-xxl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--on-primary);
  }
  .set-count,
  .set-note {
    font-size: var(--size-s);
  }
  .set-chips {
    gap: var(--space-1);
  }
  .set-chips :global(.more) {
    align-self: center;
    font-size: var(--size-s);
  }
  .set-start {
    width: 100%;
  }
  /* Nothing ticked yet: an outline, so the white button reads as not ready. */
  .set-start[data-empty] {
    border-color: var(--on-primary);
    background: transparent;
    box-shadow: none;
    color: var(--on-primary);
    cursor: not-allowed;
  }
  .quick {
    display: grid;
    gap: var(--space-3);
  }
  .quick h2 {
    margin: 0;
    font-size: var(--size-base);
    color: var(--heading);
  }
  .quick p {
    margin: 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .quick .button {
    width: 100%;
  }
  @media (min-width: 64rem) {
    .side-col {
      position: sticky;
      top: 5rem;
    }
  }
  @media (max-width: 63.99rem) {
    /* The set and the quick card join the form's grid, so the set can stick
       to the bottom of the screen while the groups scroll. */
    .side-col {
      display: contents;
    }
    .quick {
      order: -1;
    }
    .set {
      position: sticky;
      bottom: var(--space-3);
      z-index: 1;
      padding: var(--space-3) var(--space-4);
      box-shadow: var(--shadow-pop);
    }
    .set-head,
    .set-chips,
    .set-note,
    .set-count {
      display: none;
    }
    .set-body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .set-total strong {
      font-size: var(--size-l);
    }
    .set-start {
      width: auto;
      padding-inline: var(--space-5);
    }
  }
  [data-summary][hidden],
  [data-picker][hidden],
  [data-set-chips][hidden],
  [data-group-toggle][hidden],
  [data-clear][hidden] {
    display: none;
  }
</style>
