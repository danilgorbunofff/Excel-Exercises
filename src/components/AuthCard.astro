---
// Why this exists: the card that holds the Log in, Sign up and other account
// forms. Each form posts to an /api/ function, which sends the visitor back
// with ?error= or ?ok=; the message shows at the top of the card. While
// accounts are closed, the fields are disabled and a note says why.
import { siteConfig } from "../../site.config.ts";
import Logo from "./Logo.astro";

interface Props {
  title: string;
  lead: string;
  /** The /api/ function the form posts to. */
  action: string;
  /** h1 on its own page, h2 when the card sits inside another page. */
  level?: 1 | 2;
  /** Overrides the note shown while accounts are closed. */
  note?: string;
  /** Show the form enabled even while accounts are closed. */
  enabled?: boolean;
  /** Show "Continue with Google" above the form. */
  google?: boolean;
}
const { title, lead, action, level = 1, note, enabled = false, google = false } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
const open = siteConfig.accountsOpen || enabled;
---

<div class="auth">
  <div class="card">
    <div class="head">
      <Logo size={36} />
      <Heading class="title">{title}</Heading>
      <p>{lead}</p>
    </div>
    {
      !open && (
        <p class="note" id="accounts-note">
          {note ??
            "Accounts open soon. Until then there is nothing to sign in to: your progress is saved in this browser, and every exercise works without an account."}
        </p>
      )
    }
    <p class="flash" role="status" data-flash hidden></p>
    {
      open && google && (
        <>
          <a class="button button-secondary google" href="/api/auth/google/" data-next-link>
            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Continue with Google
          </a>
          <p class="or">or with your email</p>
        </>
      )
    }
    <form method="post" action={action} aria-describedby={open ? undefined : "accounts-note"} data-auth-form>
      <fieldset disabled={!open}>
        <input type="hidden" name="next" value="" data-next-field />
        <slot />
      </fieldset>
    </form>
    <slot name="after" />
  </div>
</div>

<script>
  import "../scripts/flash.ts";
</script>

<style>
  .auth {
    display: grid;
    place-items: center;
    padding: var(--space-7) var(--space-4);
  }
  .card {
    width: 100%;
    max-width: 28rem;
    padding: var(--space-6);
  }
  .head {
    display: grid;
    gap: var(--space-1);
  }
  .head > :global(:first-child) {
    margin-bottom: var(--space-2);
  }
  /* Phones: less frame around the card, so the form gets the width. */
  @media (max-width: 29.99rem) {
    .auth {
      padding: var(--space-5) var(--space-4);
    }
    .card {
      padding: var(--space-5);
    }
  }
  .title {
    margin: 0;
    font-size: var(--size-xl);
    color: var(--heading);
  }
  .head p {
    margin: 0;
    color: var(--muted);
    font-size: var(--size-s);
  }
  .note {
    margin: var(--space-5) 0 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--header);
    color: var(--text);
    font-size: var(--size-s);
  }
  .flash {
    margin: var(--space-5) 0 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    border: 1px solid var(--chip-line);
    background: var(--chip-bg);
    font-size: var(--size-s);
  }
  .flash[data-kind="error"] {
    border-color: var(--miss);
    background: var(--miss-tint);
  }
  .google {
    width: 100%;
    margin-top: var(--space-5);
  }
  .or {
    margin: var(--space-4) 0 0;
    text-align: center;
    color: var(--muted);
    font-size: var(--size-s);
  }
  fieldset {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    border: 0;
  }
  fieldset :global(label) {
    margin-top: var(--space-2);
    font-size: var(--size-s);
    font-weight: 600;
  }
  fieldset :global(input) {
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  fieldset:disabled :global(input) {
    background: var(--header);
    cursor: not-allowed;
  }
  fieldset :global(.button) {
    width: 100%;
    margin-top: var(--space-4);
  }
  .card :global(.switch) {
    margin: var(--space-5) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .card :global(.switch a) {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--text);
    font-weight: 600;
  }
</style>
