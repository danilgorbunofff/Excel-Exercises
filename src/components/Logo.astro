---
// Why this exists: the site mark, a small sheet with the answer cell lit.
// Decorative; the site name next to it carries the meaning.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="logo"
  width={size}
  height={size}
  viewBox="0 0 28 28"
  aria-hidden="true"
  focusable="false"
>
  <rect x="1" y="1" width="26" height="26" rx="6" fill="#18804f"></rect>
  <path d="M1 10.5h26M1 18h26M10 1v26M18.5 1v26" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.5"></path>
  <rect x="11" y="11.5" width="6.5" height="5.5" rx="1" fill="#ffffff"></rect>
</svg>
