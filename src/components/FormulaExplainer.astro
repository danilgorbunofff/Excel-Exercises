---
// Why this exists: the editable example on a function page. The sheet, the
// formula under it, and the result written into the cell the formula sits in.
// Each reference in the formula is outlined on the sheet in its own colour,
// as Excel does while you edit a formula. The script redoes it on every edit.
import { type CellInput, columnLetters, parseAddress } from "@practice/grader";
import { explain } from "../lib/explain.ts";
import { functionSummaries, functionSyntaxes } from "../lib/explainers.ts";

interface Props {
  walkthrough: { formula: string; rows: CellInput[][] };
  /** The cell the formula sits in, such as "C5". It shows the result and cannot be edited. */
  resultCell?: string;
  /** The name on the bar above the data. */
  dataTitle?: string;
}
const { walkthrough, resultCell, dataTitle = "Example data" } = Astro.props;
const out = resultCell ? parseAddress(resultCell) : null;
const summaries = functionSummaries();
const syntaxes = functionSyntaxes();
const first = explain(walkthrough.formula, walkthrough.rows, summaries, syntaxes);
const width = walkthrough.rows[0]?.length ?? 0;
const columns = Array.from({ length: width }, (_, i) => columnLetters(i + 1));
const data = JSON.stringify({ rows: walkthrough.rows, summaries, syntaxes }).replaceAll(
  "<",
  "\\u003c",
);
---

<div class="explainer" data-explainer>
  <section class="data" aria-labelledby="data-heading">
    <div class="data-bar">
      <p class="data-title" id="data-heading">{dataTitle}</p>
      <button class="reset" type="button" data-explainer-reset>Reset</button>
    </div>
    <div class="grid-wrap">
      <table class="grid">
        <caption class="visually-hidden">Example data. Edit a cell to see the result update.</caption>
        <thead>
          <tr>
            <td class="corner"></td>
            {columns.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            walkthrough.rows.map((row, r) => (
              <tr>
                <th scope="row">{r + 1}</th>
                {row.map((v, c) =>
                  out?.row === r + 1 && out.col === c + 1 ? (
                    <td class="out">
                      <input
                        aria-label={`${columns[c]}${r + 1}, the result`}
                        value={first.ok ? first.result : ""}
                        readonly
                        data-explainer-out
                      />
                    </td>
                  ) : (
                    <td>
                      <input
                        aria-label={`${columns[c]}${r + 1}`}
                        value={v === null ? "" : String(v)}
                        data-cell={`${r},${c}`}
                        class:list={{ num: typeof v === "number" }}
                      />
                    </td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="boxes" aria-hidden="true" data-explainer-boxes></div>
    </div>
  </section>
  <form class="bar" data-explainer-form>
    <label class="visually-hidden" for="formula-explainer-input">Your formula</label>
    <span class="fx" aria-hidden="true">fx</span>
    <textarea
      id="formula-explainer-input"
      rows="1"
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      data-explainer-input>{walkthrough.formula}</textarea>
    <button class="button button-primary" type="submit">Explain it</button>
  </form>
  <p class="result" role="status" data-explainer-result>
    Result: <strong data-explainer-value>{first.ok ? first.result : "none"}</strong>
  </p>
  <script type="application/json" data-explainer-data set:html={data} />
</div>

<script>
  import "../scripts/explainer.ts";
</script>

<style>
  /* Reference colours, given out in order. */
  .explainer :global(.ref-1) {
    --c: var(--ref-1);
  }
  .explainer :global(.ref-2) {
    --c: var(--ref-2);
  }
  .explainer :global(.ref-3) {
    --c: var(--ref-3);
  }
  .explainer :global(.ref-4) {
    --c: var(--ref-4);
  }
  .explainer :global(.ref-5) {
    --c: var(--ref-5);
  }
  .explainer :global(.ref-6) {
    --c: var(--ref-6);
  }

  /* The sheet, on the green bar of every sheet on the site. */
  .data-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--primary);
    color: var(--on-primary);
  }
  .data-title {
    margin: 0;
    font-size: var(--size-s);
    font-weight: 600;
  }
  /* Touch screens get the full 44 px target; mice keep the slimmer band. */
  @media (pointer: coarse) {
    .reset.reset {
      min-height: var(--target);
    }
  }
  .reset {
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--correct);
    font-size: var(--size-s);
    font-weight: 600;
    cursor: pointer;
  }
  .reset:focus-visible {
    outline-color: var(--on-primary);
  }
  .grid-wrap {
    position: relative;
    overflow-x: auto;
  }
  .grid {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-s);
    font-variant-numeric: tabular-nums;
  }
  .grid th,
  .corner {
    height: 1.75rem;
    padding: 0 var(--space-1);
    background: var(--header);
    color: var(--muted);
    font-size: var(--size-xs);
    font-weight: 500;
    text-align: center;
    border: 1px solid var(--rule);
  }
  .grid tbody th {
    width: 2.5rem;
  }
  .grid td {
    padding: 0;
    border: 1px solid var(--rule);
  }
  .grid input {
    width: 100%;
    min-width: 5rem;
    height: 2.25rem;
    padding: 0 var(--space-2);
    border: 0;
    background: transparent;
  }
  .grid input.num {
    text-align: right;
  }
  .grid input:focus-visible {
    outline-offset: -2px;
  }
  /* The cell the formula sits in: outlined as the selected cell. */
  .grid .out {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
    background: var(--correct-tint);
  }
  .grid .out input {
    font-weight: 600;
    text-align: right;
  }
  /* Outlines over the cells each reference reads. They let clicks through. */
  .boxes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .boxes :global(.box) {
    position: absolute;
    border: 2px solid var(--c);
    border-radius: 2px;
  }

  /* The formula bar, drawn like Excel's: fx, the formula, then the button. */
  .bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    margin: var(--space-3) var(--space-3) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    overflow: hidden;
  }
  .bar:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .fx {
    display: grid;
    place-items: center;
    padding: 0 var(--space-3);
    border-right: 1px solid var(--rule);
    background: var(--header);
    color: var(--muted);
    font: italic 600 var(--size-m) var(--font-mono);
  }
  textarea {
    width: 100%;
    min-height: var(--target);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: transparent;
    color: var(--heading);
    font: 500 var(--size-m) / 1.4 var(--font-mono);
    resize: none;
    field-sizing: content;
  }
  textarea:focus-visible {
    outline: none;
  }
  .bar .button {
    align-self: center;
    margin: var(--space-1);
    min-height: var(--target);
    padding: 0 var(--space-4);
  }
  .result {
    margin: var(--space-2) var(--space-3) var(--space-3);
    color: var(--muted);
    font-size: var(--size-s);
  }
  .result strong {
    color: var(--heading);
    font-family: var(--font-mono);
  }
</style>
