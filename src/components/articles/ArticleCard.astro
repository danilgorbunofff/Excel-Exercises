---
// Why this exists: one article as a card: its cover, title, summary and
// reading time. The article index and the "More articles" block use it, so
// both look the same. The whole card is one link, through its title.
import { ARTICLE_TOPICS } from "../../content/schema.ts";
import { type ArticleEntry, articlePath } from "../../lib/articles.ts";
import ArticleCover from "./ArticleCover.astro";

interface Props {
  article: ArticleEntry;
  /** Position in its list, which picks the cover colour. */
  index: number;
  /** The heading level that fits the page outline. */
  level?: "h2" | "h3";
  /** Show the topic above the title. Off where the cards already sit under a topic heading. */
  showTopic?: boolean;
}
const { article, index, level: Heading = "h2", showTopic = true } = Astro.props;
const { title, description, minutes, functions, cover, topic } = article.data;
---

<article class="card article-card">
  <ArticleCover text={cover ?? functions[0] ?? "fx"} tone={index} />
  <div class="body">
    {showTopic && <p class="topic">{ARTICLE_TOPICS[topic]}</p>}
    <Heading class="title">
      <a href={articlePath(article.id)}>{title}</a>
    </Heading>
    <p class="desc">{description}</p>
    <p class="foot">
      <span class="minutes tabular">{minutes} min read</span>
      <span class="more" aria-hidden="true">Read article →</span>
    </p>
  </div>
</article>

<style>
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    overflow: hidden;
  }
  .article-card:hover {
    border-color: var(--chip-line);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .topic {
    margin: 0;
    font-size: var(--size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--correct);
  }
  .title {
    margin: 0;
    font-size: var(--size-l);
    line-height: var(--leading-tight);
    color: var(--heading);
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  /* The title link covers the card, so the whole card is one target. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .article-card:hover .title a {
    text-decoration: underline;
  }
  .desc {
    margin: 0;
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: auto 0 0;
    padding-top: var(--space-3);
    font-size: var(--size-s);
  }
  .minutes {
    color: var(--muted);
  }
  .more {
    color: var(--correct);
    font-weight: 600;
  }
</style>
