---
// Why this exists: the catalogue's start card: a small sheet where a formula
// types itself and the answer cell lights up, over a link to the next unsolved
// exercise. The page holds the finished sheet; catalogue.ts replays the typing
// and points the link at this browser's next exercise.
interface Props {
  /** Where the link leads before any progress is read. */
  href: string;
}
const { href } = Astro.props;
const rows = [
  ["Item", "Cost"],
  ["Pens", "4"],
  ["Paper", "6"],
  ["Ink", "12"],
];
---

<div class="card start-sheet" data-start-sheet>
  <h2>Practise on a real sheet</h2>
  {/* A picture of the product: the heading and the link say what it is for. */}
  <div class="demo" aria-hidden="true">
    <div class="bar">
      <i>fx</i>
      <span data-typed>=SUM(B2:B4)</span>
      <span class="caret"></span>
    </div>
    <table>
      <tr><th></th><th>A</th><th>B</th></tr>
      {
        rows.map(([name, cost], i) => (
          <tr>
            <th>{i + 1}</th>
            <td>{name}</td>
            <td class="number">{cost}</td>
          </tr>
        ))
      }
      <tr>
        <th>5</th>
        <td>Total</td>
        <td class="number result lit" data-sheet-result>22</td>
      </tr>
    </table>
  </div>
  <a class="button button-primary" href={href} data-start-link>
    <span data-start-label>Start the first task</span>
    <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .start-sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  h2 {
    margin: 0;
    font-size: var(--size-l);
    color: var(--heading);
  }
  .demo {
    display: grid;
    gap: var(--space-2);
    font-size: var(--size-xs);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .bar i {
    color: var(--muted);
  }
  .caret {
    width: 1.5px;
    height: 1em;
    margin-left: -0.375rem;
    background: var(--correct);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    height: 1.375rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--rule);
    line-height: 1.2;
    text-align: left;
  }
  th {
    width: 1.75rem;
    background: var(--header);
    font-weight: 600;
    text-align: center;
    color: var(--muted);
  }
  .number {
    text-align: right;
  }
  .result.lit {
    background: var(--correct-tint);
    box-shadow: inset 0 0 0 2px var(--correct);
    font-weight: 700;
    color: var(--correct);
  }
  .button {
    gap: var(--space-2);
    margin-top: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .result {
      transition:
        background-color 250ms,
        box-shadow 250ms;
    }
    .caret {
      animation: caret 1s steps(1) infinite;
    }
    @keyframes caret {
      50% {
        opacity: 0;
      }
    }
  }
</style>
