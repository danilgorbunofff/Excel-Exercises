---
// Why this exists: the header on every page. Wide screens show the logo, the
// search box, Practice and Learn buttons that open a panel of links, Pricing
// and the account buttons. Phones get a Menu button that opens a native
// dialog with the same groups. The panels are popovers, so they open, close
// on Escape or an outside click, and hand focus back without a script.
import { siteConfig } from "../../site.config.ts";
import {
  ACCOUNT_NAV,
  currentHref,
  NAV_GROUPS,
  type NavItem,
  PRICING_NAV,
  YOU_NAV,
} from "../lib/nav.ts";
import HeaderSearch from "./HeaderSearch.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const groups = NAV_GROUPS.map((g) => ({ ...g, here: currentHref(g.items, path) }));
const pageCurrent = (item: NavItem | { href: string }, here: string | null) =>
  item.href === path ? "page" : item.href === here ? "true" : undefined;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <Logo />
      <span>{siteConfig.name}</span>
    </a>
    <div class="search-wide"><HeaderSearch /></div>
    <div class="theme-wide"><ThemeToggle /></div>
    <nav class="nav-wide" aria-label="Main">
      <ul>
        {
          groups.map((g) => (
            <li>
              <button
                class="group-button"
                class:list={{ "is-here": g.here !== null }}
                type="button"
                popovertarget={`nav-${g.id}`}
                aria-expanded="false"
              >
                {g.label}
                <Icon name="chevron-down" size={16} />
              </button>
              <div class="panel" id={`nav-${g.id}`} popover data-nav-panel>
                <ul class="panel-list">
                  {g.items.map((item, i) => (
                    <li style={`--i:${i}`}>
                      <span class="panel-icon">
                        <Icon name={item.icon} size={20} />
                      </span>
                      <a href={item.href} aria-current={pageCurrent(item, g.here)}>
                        {item.label}
                      </a>
                      <p>{item.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
        <li>
          <a class="plain" href={PRICING_NAV.href} aria-current={path === PRICING_NAV.href ? "page" : undefined}>
            {PRICING_NAV.label}
          </a>
        </li>
      </ul>
    </nav>
    <div class="account" data-when="out">
      <a class="login" href={ACCOUNT_NAV.login.href}>{ACCOUNT_NAV.login.label}</a>
      <a class="button button-primary signup" href={ACCOUNT_NAV.register.href}>
        {ACCOUNT_NAV.register.label}
      </a>
    </div>
    <div class="account" data-when="in" hidden>
      <button
        class="button button-secondary signup"
        type="button"
        popovertarget="nav-you"
        aria-expanded="false"
      >
        {ACCOUNT_NAV.account.label}
        <Icon name="chevron-down" size={16} />
      </button>
      <div class="panel panel-you" id="nav-you" popover data-nav-panel>
        <ul class="you-list">
          {
            YOU_NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <form method="post" action="/api/auth/logout/">
              <button class="logout" type="submit">Log out</button>
            </form>
          </li>
        </ul>
      </div>
    </div>
    <div class="menu-wrap">
      <span class="theme-phone"><ThemeToggle /></span>
      <button class="button button-secondary menu" type="button" commandfor="menu" command="show-modal">
        <Icon name="menu" size={22} />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
  <dialog id="menu" aria-label="Menu" closedby="any">
    <HeaderSearch id="menu-search" />
    <nav class="menu-nav" aria-label="Main">
      {
        groups.map((g) => (
          <section aria-labelledby={`menu-${g.id}`}>
            <h2 id={`menu-${g.id}`}>{g.label}</h2>
            <ul>
              {g.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={pageCurrent(item, g.here)}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <ul>
        <li>
          <a href={PRICING_NAV.href} aria-current={path === PRICING_NAV.href ? "page" : undefined}>
            {PRICING_NAV.label}
          </a>
        </li>
      </ul>
    </nav>
    <div class="menu-account" data-when="out">
      <a class="button button-secondary" href={ACCOUNT_NAV.login.href}>{ACCOUNT_NAV.login.label}</a>
      <a class="button button-primary" href={ACCOUNT_NAV.register.href}>
        {ACCOUNT_NAV.register.label}
      </a>
    </div>
    <section class="menu-you" data-when="in" hidden aria-labelledby="menu-you">
      <h2 id="menu-you">Your account</h2>
      <ul>
        {
          YOU_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <form method="post" action="/api/auth/logout/">
        <button class="button button-secondary" type="submit">Log out</button>
      </form>
    </section>
    <button class="button button-secondary close" type="button" commandfor="menu" command="close">
      Close
    </button>
  </dialog>
</header>

<script>
  import "../scripts/session.ts";

  // Browsers without button commands get the same behaviour from a click handler.
  if (!("command" in HTMLButtonElement.prototype)) {
    for (const button of document.querySelectorAll<HTMLButtonElement>("button[commandfor]")) {
      const dialog = document.getElementById(button.getAttribute("commandfor") ?? "");
      if (!(dialog instanceof HTMLDialogElement)) continue;
      button.addEventListener("click", () =>
        button.getAttribute("command") === "close" ? dialog.close() : dialog.showModal(),
      );
    }
  }

  // Each panel button says whether its panel is open.
  for (const panel of document.querySelectorAll<HTMLElement>("[data-nav-panel]")) {
    const button = document.querySelector(`[popovertarget="${panel.id}"]`);
    panel.addEventListener("toggle", (e) =>
      button?.setAttribute("aria-expanded", String((e as ToggleEvent).newState === "open")),
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 4;
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: 80rem;
    min-height: 4rem;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--size-l);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--heading);
  }
  .search-wide {
    display: flex;
    flex: 1;
    max-width: 28rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .theme-wide {
    margin-left: auto;
  }
  .nav-wide > ul {
    display: flex;
    gap: var(--space-5);
  }
  .group-button,
  .plain,
  .login {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--size-s);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .group-button:hover,
  .group-button.is-here,
  .group-button[aria-expanded="true"],
  .plain:hover,
  .plain[aria-current="page"],
  .login:hover {
    text-decoration: underline 2px;
    text-underline-offset: 0.45em;
  }
  .group-button[aria-expanded="true"] :global(.icon) {
    rotate: 180deg;
  }
  /* The panels open in the top layer, just under the 4rem header bar. */
  .panel {
    position: fixed;
    inset: calc(4rem + 1px) 0 auto;
    width: auto;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
  }
  .panel-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
  }
  .panel-list li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: start;
    padding: var(--space-3);
    border-radius: var(--radius-m);
  }
  .panel-icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-m);
    background: var(--correct-tint);
    color: var(--correct);
  }
  .panel-list li:hover {
    background: var(--bg);
  }
  .panel-list a {
    font-weight: 600;
    color: var(--heading);
    text-decoration: none;
  }
  /* The whole item is the link's target; the name stays the label alone. */
  .panel-list a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .panel-list a:focus-visible {
    outline: none;
  }
  .panel-list a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .panel-list a[aria-current] {
    text-decoration: underline 2px;
    text-underline-offset: 0.3em;
  }
  .panel-list p {
    grid-column: 2;
    margin: var(--space-1) 0 0;
    font-size: var(--size-s);
    color: var(--muted);
  }
  .panel-you {
    inset: calc(4rem + 1px) max(var(--space-6), calc((100vw - 80rem) / 2 + var(--space-6))) auto
      auto;
    width: 14rem;
    padding: var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
  }
  /* Panels drop in, then the items rise one after another. */
  @media (prefers-reduced-motion: no-preference) {
    .panel {
      opacity: 0;
      translate: 0 -0.5rem;
      transition:
        opacity 180ms var(--ease),
        translate 180ms var(--ease),
        overlay 180ms allow-discrete,
        display 180ms allow-discrete;
    }
    .panel:popover-open {
      opacity: 1;
      translate: 0 0;
    }
    @starting-style {
      .panel:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
    .panel-list li {
      opacity: 0;
      translate: 0 0.5rem;
      transition:
        opacity 200ms var(--ease),
        translate 200ms var(--ease);
    }
    .panel:popover-open .panel-list li {
      opacity: 1;
      translate: 0 0;
      transition-delay: calc(var(--i, 0) * 45ms + 50ms);
    }
    @starting-style {
      .panel:popover-open .panel-list li {
        opacity: 0;
        translate: 0 0.5rem;
      }
    }
  }
  .you-list a,
  .logout {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-m);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: var(--size-s);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .you-list a:hover,
  .logout:hover {
    background: var(--bg);
  }
  .you-list a[aria-current] {
    font-weight: 600;
  }
  .you-list li:last-child {
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--rule);
  }
  .account {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .signup {
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    font-size: var(--size-s);
  }
  .menu {
    width: var(--target);
    padding: 0;
    border-color: transparent;
    background: transparent;
  }
  .menu-wrap {
    display: none;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  dialog {
    margin: 0 0 0 auto;
    width: min(20rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: var(--space-5);
    border: 0;
    background: var(--surface);
    color: var(--text);
  }
  dialog[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow-y: auto;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  dialog :global(.header-search) {
    flex: none;
    max-width: none;
  }
  dialog ul {
    display: grid;
  }
  .menu-nav {
    display: grid;
    gap: var(--space-4);
  }
  dialog h2 {
    margin: 0 0 var(--space-1);
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--muted);
  }
  dialog nav a,
  .menu-you a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 500;
  }
  dialog a[aria-current] {
    font-weight: 700;
  }
  .menu-account {
    display: grid;
    gap: var(--space-2);
  }
  .menu-you[hidden] {
    display: none;
  }
  .menu-you form {
    display: grid;
    margin-top: var(--space-2);
  }
  .close {
    margin-top: auto;
  }
  @media (max-width: 63.99rem) {
    .search-wide {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .bar {
      gap: var(--space-3);
      min-height: 3.5rem;
      padding: 0 var(--space-4);
    }
    .brand {
      font-size: var(--size-base);
    }
    .theme-wide,
    .nav-wide,
    .account {
      display: none;
    }
    .menu-wrap {
      display: flex;
    }
  }
  /* Small phones: the logo, switch and Menu button all have to fit one row. */
  @media (max-width: 25rem) {
    .bar {
      gap: var(--space-2);
      padding: 0 var(--space-3);
    }
    .brand {
      flex-shrink: 1;
      min-width: 0;
      gap: var(--space-1);
      font-size: var(--size-s);
    }
    .brand span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .menu-wrap {
      gap: var(--space-1);
    }
  }
  /* Browsers without popovers cannot open the panels, so they get the Menu
     dialog at every width instead. */
  @supports not selector(:popover-open) {
    .nav-wide,
    .account[data-when="in"],
    .theme-wide {
      display: none !important;
    }
    .menu-wrap {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    dialog {
      opacity: 0;
      transform: translateX(100%);
      transition:
        opacity 200ms var(--ease),
        transform 200ms var(--ease),
        overlay 200ms allow-discrete,
        display 200ms allow-discrete;
    }
    dialog[open] {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      dialog[open] {
        opacity: 0;
        transform: translateX(100%);
      }
    }
    dialog::backdrop {
      background-color: transparent;
      transition:
        background-color 200ms var(--ease),
        overlay 200ms allow-discrete,
        display 200ms allow-discrete;
    }
    dialog[open]::backdrop {
      background-color: rgb(0 0 0 / 0.45);
    }
    @starting-style {
      dialog[open]::backdrop {
        background-color: transparent;
      }
    }
  }
</style>
